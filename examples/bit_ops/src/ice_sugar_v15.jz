@project(CHIP="ICE40UP-5K-SG48") BIT_OPS_EXAMPLE
    @import "bit_ops.jz"

    CLOCKS {
        SCLK = { period=83.33 };
    }

    IN_PINS {
        SCLK = { standard=LVCMOS33 };
    }

    OUT_PINS {
        LED[3] = { standard=LVCMOS33, drive=8 };
    }

    MAP {
        SCLK = 35;
        LED[0] = 40;
        LED[1] = 41;
        LED[2] = 39;
    }

    @top bit_ops_demo {
        IN  [1] clk   = SCLK;
        IN  [1] por   = 1'b1;
        IN  [1] rst_n = 1'b1;
        OUT [6] leds  = { ~LED, _, _, _ };
    }
@endproj
