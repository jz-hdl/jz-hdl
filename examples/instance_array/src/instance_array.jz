// Instance-array example.
//
// Six identical one-bit stages are instantiated with `@new[6]`. `IDX` maps
// each child input and output to the corresponding parent bit position.
//
// LEDs show the stage outputs as a simple shift pattern.

@module bit_stage
    PORT {
        IN  [1] clk;
        IN  [1] reset;
        IN  [1] din;
        OUT [1] dout;
    }

    REGISTER {
        q [1] = 1'b0;
    }

    ASYNCHRONOUS {
        dout <= q;
    }

    SYNCHRONOUS(CLK=clk RESET=reset RESET_ACTIVE=Low) {
        q <= din;
    }
@endmod

@module instance_array_demo
    PORT {
        IN  [1] clk;
        IN  [1] por;
        IN  [1] rst_n;
        OUT [6] leds;
    }

    WIRE {
        reset     [1];
        stage_in  [6];
        stage_out [6];
    }

    REGISTER {
        counter [25] = 25'b1;
    }

    @new stages[6] bit_stage {
        IN  [1] clk   = clk;
        IN  [1] reset = reset;
        IN  [1] din   = stage_in[IDX];
        OUT [1] dout  = stage_out[IDX];
    };

    ASYNCHRONOUS {
        reset <= por & rst_n;
        stage_in[0] <= counter[24];
        stage_in[5:1] <= stage_out[4:0];
        leds <= stage_out;
    }

    SYNCHRONOUS(CLK=clk RESET=reset RESET_ACTIVE=Low) {
        counter <= counter + 25'b1;
    }
@endmod
