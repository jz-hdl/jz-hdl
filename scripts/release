#!/usr/bin/env bash
set -euo pipefail

# Create a release: update version, build, test, tag, and package tarballs.
# Usage: scripts/release <version>
#   e.g. scripts/release 1.0.0

if [ $# -ne 1 ]; then
  echo "Usage: $0 <version>"
  echo "  e.g. $0 1.0.0"
  exit 1
fi

VERSION="$1"

# Validate version format (major.minor.patch)
if ! echo "$VERSION" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "Error: Version must be in the format MAJOR.MINOR.PATCH (e.g. 1.0.0)"
  exit 1
fi

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RELEASE_DIR="$REPO_ROOT/release"
SYNC_VERSION="$REPO_ROOT/scripts/sync_version.py"
TEMP_DIRS=()
VERSION_FILES=(
  "$REPO_ROOT/VERSION"
  "$REPO_ROOT/compiler/include/version.h"
  "$REPO_ROOT/docs/getting-started/cli-usage.md"
  "$REPO_ROOT/vscode-ext/package.json"
  "$REPO_ROOT/vscode-ext/package-lock.json"
)

cleanup_temp_dirs() {
  local dir
  for dir in "${TEMP_DIRS[@]}"; do
    if [ -n "$dir" ] && [ -d "$dir" ]; then
      rm -rf "$dir"
    fi
  done
}

rollback_version_bump() {
  local files=()
  local path

  for path in "${VERSION_FILES[@]}" "$REPO_ROOT/specification"; do
    if ! git -C "$REPO_ROOT" diff --quiet -- "$path"; then
      files+=("$path")
    fi
  done

  if [ ${#files[@]} -gt 0 ]; then
    git -C "$REPO_ROOT" restore --source=HEAD -- "${files[@]}"
  fi
}

abort_release() {
  echo "Error: $1. Aborting release."
  rollback_version_bump
  exit 1
}

trap cleanup_temp_dirs EXIT

# Ensure we're on a clean working tree
if ! git -C "$REPO_ROOT" diff --quiet || ! git -C "$REPO_ROOT" diff --cached --quiet; then
  echo "Error: Working tree has uncommitted changes. Commit or stash them first."
  exit 1
fi

echo "==> Releasing v${VERSION}"

# ---------------------------------------------------------------------------
# 1. Update version numbers
# ---------------------------------------------------------------------------
echo "==> Updating version to ${VERSION}..."
python3 "$SYNC_VERSION" "$VERSION"

# ---------------------------------------------------------------------------
# 2. Build and test
# ---------------------------------------------------------------------------
echo "==> Building artifacts and running tests..."

BUILD_DIR="$(mktemp -d)"
TEMP_DIRS+=("$BUILD_DIR")
VIEWER_SMOKE_DIR="$(mktemp -d)"
TEMP_DIRS+=("$VIEWER_SMOKE_DIR")
VIEWER_SMOKE_PATH="$VIEWER_SMOKE_DIR/release-viewer-smoke.jzw"
JZ_HDL_BIN="$BUILD_DIR/compiler/jz-hdl"
JZ_VIEWER_BIN="$BUILD_DIR/viewer/jz-viewer"
cmake -S "$REPO_ROOT" -B "$BUILD_DIR" \
  -DBUILD_TESTING=ON \
  -DCMAKE_BUILD_TYPE=Release \
  -DJZ_HDL_WERROR=ON
cmake --build "$BUILD_DIR" --parallel

echo "==> Running CTest..."
if ! ctest --test-dir "$BUILD_DIR" --output-on-failure; then
  abort_release "CTest tests failed"
fi

echo "==> Running validation tests..."
if ! JZ_HDL_BIN="$JZ_HDL_BIN" bash "$REPO_ROOT/compiler/tests/run_validation.sh"; then
  abort_release "Validation tests failed"
fi

echo "==> Running viewer smoke test..."
"$JZ_HDL_BIN" --simulate \
  "$REPO_ROOT/compiler/tests/golden/sim_select_annotations/test.jz" \
  --jzw \
  -o "$VIEWER_SMOKE_PATH"
"$JZ_VIEWER_BIN" --validate "$VIEWER_SMOKE_PATH"

echo "==> Building and smoke-testing VS Code extension..."
(
  cd "$REPO_ROOT/vscode-ext"
  npm ci
  npm run compile
  npm run smoke
)

# ---------------------------------------------------------------------------
# 3. Build docs site and PDFs for release artifacts
# ---------------------------------------------------------------------------
echo "==> Building and verifying docs site..."
"$REPO_ROOT/scripts/build-docs-site" --build-dir "$BUILD_DIR"

# ---------------------------------------------------------------------------
# 4. Commit version bump
# ---------------------------------------------------------------------------
echo "==> Committing version bump..."

git -C "$REPO_ROOT" add \
  CMakeLists.txt \
  VERSION \
  compiler/CMakeLists.txt \
  compiler/include/version.h \
  docs/getting-started/cli-usage.md \
  scripts/sync_version.py \
  specification/ \
  vscode-ext/package.json \
  vscode-ext/package-lock.json

git -C "$REPO_ROOT" commit -m "Bump version to ${VERSION}"

# ---------------------------------------------------------------------------
# 5. Tag the release
# ---------------------------------------------------------------------------
echo "==> Tagging v${VERSION}..."
git -C "$REPO_ROOT" tag -a "v${VERSION}" -m "Release v${VERSION}"

# ---------------------------------------------------------------------------
# 6. Build packages
# ---------------------------------------------------------------------------
echo "==> Building release packages..."
mkdir -p "$RELEASE_DIR"

cpack --config "$BUILD_DIR/CPackConfig.cmake" -B "$RELEASE_DIR"
cpack --config "$BUILD_DIR/CPackSourceConfig.cmake" -B "$RELEASE_DIR"

# ---------------------------------------------------------------------------
# 7. Done
# ---------------------------------------------------------------------------
echo ""
echo "Release v${VERSION} prepared:"
find "$RELEASE_DIR" -maxdepth 1 -type f | sort | sed 's/^/  /'
echo ""
echo "To publish:"
echo "  git push origin main --tags"
echo "  gh release create v${VERSION} \\"
echo "    release/*${VERSION}*.tar.gz \\"
echo "    --title \"v${VERSION}\" --notes \"Release v${VERSION}\""
