// PIN_DIFF_MISSING_PCLK: Differential INOUT pin missing required pclk attribute.
// Tests deserializer/serializer required clocks on INOUT_PINS.

@project(CHIP="XC7A35T-2FGG484") PIN_DIFF_MISSING_PCLK_inout_pin_no_pclk
    CLOCKS {
        sys_clk = { period=10.0 };
        serial_clk = { period=2.5 };
        parallel_clk = { period=10.0 };
        reset_n = { period=10.0 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        serial_clk = { standard=LVCMOS33 };
        parallel_clk = { standard=LVCMOS33 };
        reset_n = { standard=LVCMOS33 };
    }

    INOUT_PINS {
        valid_io = { mode=DIFFERENTIAL, standard=LVDS25, drive=8, width=4, fclk=serial_clk, pclk=parallel_clk, reset=reset_n };
        bad_io = { mode=DIFFERENTIAL, standard=LVDS25, drive=8, width=4, fclk=serial_clk, reset=reset_n };
    }

    MAP {
        sys_clk = "E3";
        serial_clk = "F3";
        parallel_clk = "G3";
        reset_n = "H3";
        valid_io = { P="A1", N="A2" };
        bad_io = { P="B1", N="B2" };
    }

    @top TopMod {
        IN    [1] clk = sys_clk;
        INOUT [4] io  = bad_io;
        OUT   [4] tx  = _;
    }
@endproj

@module TopMod
    PORT {
        IN    [1] clk;
        INOUT [4] io;
        OUT   [4] tx;
    }

    REGISTER {
        phase [1] = 1'b0;
        r [4] = 4'b0000;
    }

    ASYNCHRONOUS {
        tx = r;
        IF (phase) {
            io <= r;
        } ELSE {
            io <= 4'bzzzz;
        }
    }

    SYNCHRONOUS(CLK=clk) {
        phase <= ~phase;
        r <= io;
    }
@endmod
