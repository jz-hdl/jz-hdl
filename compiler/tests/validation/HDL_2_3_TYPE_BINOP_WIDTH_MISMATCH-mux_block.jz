// TYPE_BINOP_WIDTH_MISMATCH: MUX read in binary operator expression.
// Tests that mux[sel] contributes its selected element width to binop checks.
// Valid same-width MUX binop included to verify no false positives.

@project TYPE_BINOP_WIDTH_MISMATCH_mux_block
    @top TopMod {
        IN  [1] sel = _;
        IN  [8] a = _;
        IN  [8] b = _;
        IN  [4] small = _;
        OUT [8] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] sel;
        IN  [8] a;
        IN  [8] b;
        IN  [4] small;
        OUT [8] data;
    }

    WIRE {
        ok [8];
    }

    MUX {
        choices = a, b;
    }

    ASYNCHRONOUS {
        // Valid: MUX element and literal are both 8 bits
        ok <= choices[sel] + 8'h01;
        // Trigger: MUX element is 8 bits, small is 4 bits
        data <= choices[sel] + small;
    }
@endmod
