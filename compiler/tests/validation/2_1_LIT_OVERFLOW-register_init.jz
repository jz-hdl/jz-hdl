// LIT_OVERFLOW: Literal intrinsic bit-width exceeds declared width.
// Tests overflow in register initialization.
// Valid non-overflowing register init included to verify no false positives.

@project LIT_OVERFLOW_register_init
    @top TopMod {
        IN  [1] clk = _;
        OUT [4] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [4] data;
    }

    REGISTER {
        // Trigger: decimal overflow in register init, intrinsic 5 bits > declared 4
        r_bad [4] = 4'd16;
        // Valid: 4'd15 fits exactly in 4 bits
        r_ok [4] = 4'd15;
    }

    ASYNCHRONOUS {
        data = r_bad + r_ok;
    }

    SYNCHRONOUS(CLK=clk) {
        r_bad <= r_bad + 4'h1;
        r_ok <= r_ok + 4'h1;
    }
@endmod
