// INSTANCE_HAPPY_PATH: arrayed instance ports can be read with inst[index].port.

@project INSTANCE_HAPPY_PATH_array_port_access_ok
    @top TopMod {
        IN  [1] clk = _;
        IN  [2] din = _;
        OUT [2] data = _;
    }
@endproj

@module BitChild
    PORT {
        IN  [1] clk;
        IN  [1] din;
        OUT [1] data;
    }
    REGISTER {
        r [1] = 1'b0;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
    ASYNCHRONOUS {
        data = r;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [2] din;
        OUT [2] data;
    }
    WIRE {
        child_data [2];
    }
    @new inst_arr[2] BitChild {
        IN  [1] clk = clk;
        IN  [1] din = din[IDX];
        OUT [1] data = child_data[IDX];
    };
    ASYNCHRONOUS {
        data = {inst_arr[1].data, inst_arr[0].data};
    }
@endmod
