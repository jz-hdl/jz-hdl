// HAPPY_PATH: uadd intrinsic in sync-expr and new-binding contexts (§5.5.1).
// async-expr is already covered by 5_5_INTRINSIC_OPERATORS-happy_path.jz.
// check-expr and feature-cond are inapplicable: @check (§9.4) and @feature
// (§4.14) restrict expressions to literals, CONST/CONFIG, and a small set of
// constant operators — intrinsics like uadd are not allowed there. See
// audit/runner.log for the rationale.
// No diagnostics expected.

@project HAPPY_PATH_uadd_contexts_ok
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] a = _;
        IN  [8] b = _;
        OUT [9] sync_sum = _;
        OUT [9] new_sum = _;
    }
@endproj

// Helper: receives a uadd result via new-binding port assignment
@module HelperUadd
    PORT {
        IN  [9] sum_in;
        OUT [9] sum_out;
    }
    ASYNCHRONOUS {
        sum_out = sum_in;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [8] b;
        OUT [9] sync_sum;
        OUT [9] new_sum;
    }

    WIRE {
        async_sum [9];
    }

    REGISTER {
        r_sum [9] = 9'd0;
    }

    // new-binding: uadd result drives an instance input port
    @new inst_h HelperUadd {
        IN  [9] sum_in  = async_sum;
        OUT [9] sum_out = new_sum;
    };

    ASYNCHRONOUS {
        // async-expr (already covered elsewhere; needed here so async_sum has a driver)
        async_sum = uadd(a, b);
        sync_sum  = r_sum;
    }

    SYNCHRONOUS(CLK=clk) {
        // sync-expr: uadd used as RHS of a register assignment in SYNCHRONOUS
        r_sum <= uadd(a, b);
    }
@endmod
