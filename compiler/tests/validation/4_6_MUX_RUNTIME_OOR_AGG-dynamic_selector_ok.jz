// MUX §4.6 Req #8 and Req #24 happy-path:
// "If runtime out-of-range indices return 0."
// A dynamic selector whose value range exceeds the number of aggregation
// sources is accepted at compile time (the compiler cannot statically prove
// it is always out of range). Runtime out-of-range values yield zero;
// this test verifies the construct compiles cleanly.
// No diagnostics expected.

@project MUX_RUNTIME_OOR_AGG_dynamic_selector_ok
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [8] a = _;
        IN  [8] b = _;
        IN  [8] c = _;
        IN  [3] sel = _;
        OUT [8] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [8] b;
        IN  [8] c;
        IN  [3] sel;
        OUT [8] data;
    }

    // Aggregation with N = 3 sources. Valid indices are 0..2.
    MUX {
        agg_mux = a, b, c;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        // Trigger: dynamic 3-bit selector can carry values 0..7. Values 3..7
        // are runtime-out-of-range. The compiler cannot statically prove the
        // selector is always out-of-range, so this is legal; runtime OOR
        // yields zero at simulation time.
        data = agg_mux[sel] | r;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger: same runtime-OOR scenario in SYNC context.
        r <= agg_mux[sel];
    }
@endmod
