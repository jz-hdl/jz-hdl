// TEMPLATE_FORBIDDEN_DECL: LATCH declaration inside template body.
// Valid template with only @scratch included for negative testing.

@project TEMPLATE_FORBIDDEN_DECL_latch_in_template
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

// Valid: template using only scratch and params (no error)
@template valid_tmpl(a, b)
    @scratch tmp [1];
    tmp <= a;
    b <= tmp;
@endtemplate

// Trigger: LATCH declaration inside file-scoped template
@template latch_in_tmpl(a, b)
    LATCH {
        lt [1] D;
    }
    a <= b;
@endtemplate

@module HelperMod
    PORT {
        IN  [1] din;
        OUT [1] data;
    }

    ASYNCHRONOUS {
        data = din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    @new inst_a HelperMod {
        IN  [1] din = r;
        OUT [1] data = _;
    };

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
