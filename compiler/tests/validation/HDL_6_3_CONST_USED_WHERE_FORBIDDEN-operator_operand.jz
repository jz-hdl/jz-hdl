// CONST_USED_WHERE_FORBIDDEN: CONST used as operator operand in runtime expression.
// Tests module CONST used in arithmetic expression (r + SIZE) in runtime block.
// Valid compile-time CONST uses included to verify no false positives.

@project CONST_USED_WHERE_FORBIDDEN_operator_operand
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [CONFIG.WIDTH] data = _;
    }
@endproj

@module Helper
    CONST {
        SIZE = 4;
    }
    PORT {
        IN  [1] clk;
        IN  [SIZE] din;
        OUT [SIZE] dout;
    }
    REGISTER {
        r [SIZE] = 4'h0;
    }
    ASYNCHRONOUS {
        // Trigger: CONST as operator operand in async expression
        dout = r + SIZE;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [CONFIG.WIDTH] data;
    }

    WIRE {
        h_out [4];
    }

    @new inst_h Helper {
        IN  [1] clk = clk;
        IN  [4] din = 4'hA;
        OUT [4] dout = h_out;
    };

    REGISTER {
        r [CONFIG.WIDTH] = 8'h00;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= {4'h0, h_out};
    }
@endmod
