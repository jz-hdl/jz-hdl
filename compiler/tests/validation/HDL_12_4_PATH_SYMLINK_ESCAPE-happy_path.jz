// PATH_SYMLINK_ESCAPE: Symlink resolving inside the sandbox is allowed.
// Covers a valid @import through an in-sandbox symlink.
// No diagnostics expected.

@project PATH_SYMLINK_ESCAPE_valid_symlink_ok

    @import "HDL_12_4_PATH_SYMLINK_ESCAPE-happy_path_valid_symlink_lib.jz";

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    @new inst_sym PathSecurityImported {
        IN  [1] din = clk;
        OUT [1] dout = data;
    };
@endmod
