// HAPPY_PATH for SBIT_INDEX_OUT_OF_RANGE: sbit() with constant indices
// that are strictly within [0, W) must not trigger the diagnostic in any
// allowed context (ASYNCHRONOUS RHS, SYNCHRONOUS RHS).

@project SBIT_INDEX_OUT_OF_RANGE_in_range_ok
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] data = _;
        OUT [8] out_a = _;
        OUT [8] out_b = _;
    }
@endproj

// Helper module: in-range constant indices across ASYNC and SYNC
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] src;
        OUT [8] out_a;
        OUT [8] out_b;
    }
    REGISTER {
        r [8] = 8'd0;
    }
    ASYNCHRONOUS {
        // Valid: index 0 on 8-bit source (min valid).
        out_a <= sbit(src, 3'd0, 1'b1);
        out_b = r;
    }
    SYNCHRONOUS(CLK=clk) {
        // Valid: index 7 on 8-bit source (max valid).
        r <= sbit(src, 3'd7, 1'b0);
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] data;
        OUT [8] out_a;
        OUT [8] out_b;
    }
    WIRE {
        ha_a [8];
        ha_b [8];
    }
    REGISTER {
        r [8] = 8'd0;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] src = data;
        OUT [8] out_a = ha_a;
        OUT [8] out_b = ha_b;
    };

    ASYNCHRONOUS {
        // Valid: mid-range constant index.
        out_a <= sbit(data, 3'd3, 1'b1);
        out_b = r;
    }
    SYNCHRONOUS(CLK=clk) {
        // Valid: max in-range index.
        r <= sbit(data, 3'd7, 1'b0);
    }
@endmod
