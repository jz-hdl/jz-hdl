// ASYNC_ASSIGN_REGISTER: Register assigned in ASYNCHRONOUS block.
// Tests 5.1 assignment operators targeting registers in ASYNC blocks.
// Valid register reads in ASYNC and writes in SYNC verify no false positives.

@project ASYNC_ASSIGN_REGISTER_register_in_async
    @top TopMod {
        IN  [1] clk = _;
        IN  [1] sel = _;
        IN  [8] din = _;
        OUT [8] dout_a = _;
        OUT [8] dout_b = _;
        OUT [8] dout_c = _;
    }
@endproj

// Helper module: drive assignment targets a register in ASYNC.
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] din;
        OUT [8] dout;
    }

    REGISTER {
        r_drive [8] = 8'h00;
    }

    ASYNCHRONOUS {
        // Trigger 1: drive assignment writes a register.
        din => r_drive;
        // Valid: register read in ASYNC.
        dout = r_drive;
    }

    SYNCHRONOUS(CLK=clk) {
        r_drive <= din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] sel;
        IN  [8] din;
        OUT [8] dout_a;
        OUT [8] dout_b;
        OUT [8] dout_c;
    }

    REGISTER {
        r_alias [8] = 8'h00;
        r_recv [8] = 8'h00;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] din = din;
        OUT [8] dout = dout_a;
    };

    ASYNCHRONOUS {
        // Trigger 2: alias assignment writes a register.
        r_alias = din;

        // Trigger 3: receive assignment writes a register in SELECT branches.
        SELECT (sel) {
            CASE (1'b0) {
                r_recv <= din;
            }
            DEFAULT {
                r_recv <= din;
            }
        }

        // Valid: register reads in ASYNC.
        dout_b = r_alias;
        dout_c = r_recv;
    }

    SYNCHRONOUS(CLK=clk) {
        r_alias <= din;
        r_recv <= din;
    }
@endmod
