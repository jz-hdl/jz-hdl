// NET_DANGLING_UNUSED: Signal is neither driven nor read (dangling unused).
// LATCH declarations route to NET_DANGLING_UNUSED when no drivers/sinks are
// found, since they are not classified as PORT (WARN_UNUSED_PORT) or WIRE
// (WARN_UNUSED_WIRE). Properly-used latches are included to verify no false
// positives.

@project NET_DANGLING_UNUSED_unused_signal
    @top TopMod {
        IN  [1] clk    = _;
        IN  [1] enable = _;
        IN  [1] din    = _;
        OUT [1] data   = _;
    }
@endproj

// Helper module with an unused latch
@module HelperA
    PORT {
        IN  [1] enable;
        IN  [1] din;
        OUT [1] data;
    }

    LATCH {
        // Trigger 1: latch declared but never driven or read in helper
        dangling_a [1] D;
        // Valid: latch that IS used (guarded assign + read)
        used_lat [1] D;
    }

    ASYNCHRONOUS {
        used_lat <= enable : din;
        data     <= used_lat;
    }
@endmod

// Top module with more unused latches
@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] enable;
        IN  [1] din;
        OUT [1] data;
    }

    LATCH {
        // Trigger 2: unused latch in top module
        dangling_b [1] D;
        // Trigger 3: wider unused latch
        dangling_c [8] D;
        // Valid: latch that IS used
        ok_lat [1] D;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    @new inst_a HelperA {
        IN  [1] enable = enable;
        IN  [1] din    = din;
        OUT [1] data   = _;
    };

    ASYNCHRONOUS {
        ok_lat <= enable : r;
        data   <= ok_lat;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
