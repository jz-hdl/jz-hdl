// CLOCK_GEN_CHAINING_UNSUPPORTED: cross-unit CLOCK_GEN chaining on a chip
// whose PLL data does not support chaining.
// Target diagnostic: CLOCK_GEN_CHAINING_UNSUPPORTED on the second PLL input.
// Non-target diagnostics expected before edit: none.
// Planned fixture: declare a valid external input clock, drive an intermediate
// CLOCKS entry from the first PLL, then consume that intermediate clock from a
// second PLL on a chip whose PLL.chaining=false so only the chaining rule fires.

@project(CHIP="gw2ar-18-qn88-c8-i7") CLOCK_GEN_CHAINING_UNSUPPORTED_cross_unit_nonchaining
    CLOCKS {
        ext_clk = { period=10 };
        mid_clk;
        out_clk;
    }

    IN_PINS {
        ext_clk = { standard=LVCMOS33 };
    }

    MAP {
        ext_clk = 1;
    }

    CLOCK_GEN {
        PLL {
            IN REF_CLK ext_clk;
            OUT BASE mid_clk;

            CONFIG {
                IDIV = 0;
                FBDIV = 3;
                ODIV = 2;
            };
        };

        PLL {
            IN REF_CLK mid_clk;
            OUT BASE out_clk;

            CONFIG {
                IDIV = 0;
                FBDIV = 3;
                ODIV = 2;
            };
        };
    }

    @top TopMod {
        IN  [1] clk = ext_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
