// WARN_INCOMPLETE_SELECT_ASYNC: Incomplete ASYNC SELECT without DEFAULT.
// Tests incomplete coverage in ASYNC blocks across multiple modules.
// ASYNC SELECT with DEFAULT included for no false positive.

@project WARN_INCOMPLETE_SELECT_ASYNC_async_select_no_default
    @top TopMod {
        IN  [4] sel = _;
        OUT [1] out_a = _;
        OUT [1] out_b = _;
    }
@endproj

@module HelperA
    PORT {
        IN  [4] sel;
        OUT [1] out_a;
    }
    WIRE {
        temp_a [1];
    }
    ASYNCHRONOUS {
        // Trigger 1: incomplete ASYNC SELECT without DEFAULT in helper module
        out_a <= GND;
        SELECT (sel) {
            CASE 0 {
                temp_a <= VCC;
            }
            CASE 1 {
                temp_a <= GND;
            }
        }
    }
@endmod

@module TopMod
    PORT {
        IN  [4] sel;
        OUT [1] out_a;
        OUT [1] out_b;
    }
    WIRE {
        temp_a [1];
    }

    @new inst_a HelperA {
        IN  [4] sel = sel;
        OUT [1] out_a = _;
    };

    ASYNCHRONOUS {
        // Trigger 2: incomplete ASYNC SELECT without DEFAULT in top module
        out_a <= GND;
        SELECT (sel) {
            CASE 4'h0 {
                temp_a <= VCC;
            }
            CASE 4'h1 {
                temp_a <= GND;
            }
        }

        // Valid: ASYNC SELECT with DEFAULT (no false positive)
        SELECT (sel) {
            CASE 4'h0 {
                out_b <= VCC;
            }
            DEFAULT {
                out_b <= GND;
            }
        }
    }
@endmod
