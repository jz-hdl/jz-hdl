// PIN_BUS_WIDTH_INVALID: Valid INOUT_PINS bus widths compile cleanly.
// Exercises width-1 and multi-bit bidirectional buses with per-bit MAP entries.

@project PIN_BUS_WIDTH_INVALID_inout_bus_ok
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
    }

    INOUT_PINS {
        single_io[1] = { standard=LVCMOS33, drive=4 };
        data_bus[4] = { standard=LVCMOS18, drive=8 };
    }

    MAP {
        sys_clk = 1;
        single_io[0] = 2;
        data_bus[0] = 3;
        data_bus[1] = 4;
        data_bus[2] = 5;
        data_bus[3] = 6;
    }

    @top TopMod {
        IN    [1] clk = sys_clk;
        INOUT [1] single_pad = single_io;
        INOUT [4] bus = data_bus;
        OUT   [1] done = _;
    }
@endproj

@module TopMod
    PORT {
        IN    [1] clk;
        INOUT [1] single_pad;
        INOUT [4] bus;
        OUT   [1] done;
    }

    REGISTER {
        counter [4] = 4'b0000;
    }

    ASYNCHRONOUS {
        IF (counter == 4'b0000) {
            single_pad <= 1'b1;
            bus <= 4'b1010;
        } ELSE {
            single_pad <= 1'bz;
            bus <= 4'bzzzz;
        }
        done = single_pad;
    }

    SYNCHRONOUS(CLK=clk) {
        counter <= counter + 4'b0001;
    }
@endmod
