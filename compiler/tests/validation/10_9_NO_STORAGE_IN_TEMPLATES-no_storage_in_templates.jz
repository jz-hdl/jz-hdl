// Req #2 (10.9 Rationale): Templates may not introduce storage.
// Target diagnostic: TEMPLATE_FORBIDDEN_DECL.

@project REQ2_no_storage_in_templates
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

// Valid: scratch-only template remains purely combinational.
@template scratch_passthrough(src, dst)
    @scratch tmp [1];
    tmp <= src;
    dst <= tmp;
@endtemplate

// Trigger 1: register storage inside template body.
@template bad_register(src, dst)
    REGISTER {
        reg_tmp [1] = 1'b0;
    }
    dst <= src;
@endtemplate

// Trigger 2: latch storage inside template body.
@template bad_latch(src, dst)
    LATCH {
        latch_tmp [1] D;
    }
    dst <= src;
@endtemplate

// Trigger 3: memory storage inside template body.
@template bad_mem(src, dst)
    MEM {
        mem_tmp [1] [2] = 1'b0 {
            IN wr;
            OUT rd;
        };
    }
    dst <= src;
@endtemplate

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    WIRE {
        pass [1];
    }

    ASYNCHRONOUS {
        @apply scratch_passthrough(r, pass);
        data = pass;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
