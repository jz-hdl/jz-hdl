// COMPILE_ERRORS: Error reported from an imported file.
// Verifies that a violation inside an imported module keeps the imported
// file's source location in diagnostics.

@project COMPILE_ERRORS_error_in_imported_file
    @import "12_1_COMPILE_ERRORS-error_in_imported_file_lib.jz";

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    @new inst_bad ImportedBad {
        IN  [1] clk = clk;
        OUT [1] data = _;
    };

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
