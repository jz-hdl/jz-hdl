// HAPPY_PATH: Valid project with no @import directives.
// Covers §6.2.1 allowing projects to omit imports entirely.
// No diagnostics expected.

@project IMPORT_DIRECTIVE_no_imports_ok

    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
