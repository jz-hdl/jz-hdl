// DIRECTIVE_INVALID_CONTEXT: @endmod used inside module body (unexpected location).
// Existing test covers @module, @project, @blackbox, @import, @global, @endproj.
// This file adds the missing @endmod-inside-body context.
// The premature @endmod closes the module; the final @endmod is at file scope
// and triggers DIRECTIVE_INVALID_CONTEXT.

@project DIRECTIVE_INVALID_CONTEXT_endmod_in_body
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module HelperA
    PORT {
        IN  [1] din;
        OUT [1] data;
    }
    ASYNCHRONOUS {
        data = din;
    }
    // Trigger: @endmod inside module body (premature close)
    @endmod
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    @new inst_a HelperA {
        IN  [1] din = r;
        OUT [1] data = _;
    };

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
