// MEM_PORT_UNDEFINED: Declared MEM ports accessed through valid names only.
// Covers valid ASYNC read, SYNC read, and write port accesses with no
// undeclared MEM port references.

@project MEM_PORT_UNDEFINED_declared_ports_ok
    @top TopMod {
        IN  [1] clk = _;
        IN  [4] addr = _;
        IN  [8] wdata = _;
        OUT [8] data = _;
        OUT [8] helper_data = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM {
        mem_async [8] [16] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = mem_async.rd[addr];
    }

    SYNCHRONOUS(CLK=clk) {
        r <= r;
        mem_async.wr[addr] <= wdata;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] data;
        OUT [8] helper_data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM {
        mem_sync [8] [16] = 8'h00 {
            OUT rd SYNC;
            IN  wr;
        };
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [4] addr = addr;
        IN  [8] wdata = wdata;
        OUT [8] data = helper_data;
    };

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        mem_sync.rd.addr <= addr;
        r <= mem_sync.rd.data;
        mem_sync.wr[addr] <= wdata;
    }
@endmod
