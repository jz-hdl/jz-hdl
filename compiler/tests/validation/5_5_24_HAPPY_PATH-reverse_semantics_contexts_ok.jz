// HAPPY_PATH: reverse() behavioral requirements from §5.5.24.
// Exercises:
//   Req #1 - reverse the bit order of a bit-vector.
//   Req #2 - syntax `reverse(<source>)`.
//   Req #3 - result width is `width(source)`.
//   Req #4 - bit mapping `result[i] = source[width - 1 - i]`.
//   Req #5 - reverse() is allowed on ASYNCHRONOUS RHS.
//   Req #6 - reverse() is allowed on SYNCHRONOUS RHS.

@project HAPPY_PATH_reverse_semantics_contexts_ok
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [8] src8 = _;
        IN  [8] mask8 = _;
        IN  [1] src1 = _;
        OUT [8] out_async_plain = _;
        OUT [8] out_async_expr = _;
        OUT [1] out_async_one = _;
        OUT [8] out_sync = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [8] src8;
        IN  [8] mask8;
        IN  [1] src1;
        OUT [8] out_plain;
        OUT [8] out_expr;
        OUT [1] out_one;
    }

    ASYNCHRONOUS {
        // Req #1/#2/#3/#4/#5: reverse a plain 8-bit source on ASYNCHRONOUS RHS.
        out_plain = reverse(src8);
        // Req #1/#2/#3/#4/#5: reverse a valid bit-vector expression.
        out_expr = reverse(src8 ^ mask8);
        // Req #3/#5: a 1-bit source keeps width 1.
        out_one = reverse(src1);
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] src8;
        IN  [8] mask8;
        IN  [1] src1;
        OUT [8] out_async_plain;
        OUT [8] out_async_expr;
        OUT [1] out_async_one;
        OUT [8] out_sync;
    }

    WIRE {
        h_plain [8];
        h_expr  [8];
        h_one   [1];
    }

    REGISTER {
        r_sync [8] = 8'd0;
    }

    @new inst_h HelperMod {
        IN  [8] src8 = src8;
        IN  [8] mask8 = mask8;
        IN  [1] src1 = src1;
        OUT [8] out_plain = h_plain;
        OUT [8] out_expr = h_expr;
        OUT [1] out_one = h_one;
    };

    ASYNCHRONOUS {
        out_async_plain = h_plain;
        out_async_expr  = h_expr;
        out_async_one   = h_one;
        out_sync        = r_sync;
    }

    SYNCHRONOUS(CLK=clk) {
        // Req #1/#2/#3/#4/#6: reverse is also valid on SYNCHRONOUS RHS.
        r_sync <= reverse(src8 & mask8);
    }
@endmod
