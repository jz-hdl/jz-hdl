// RUN_WHILE_EQ_FORM: valid simulation @run_while(signal == value, timeout=unit=amount)
// syntax advances while the equality condition remains true.

@module RunWhileEqFormDut
    PORT {
        IN  [1] clk;
        OUT [8] count;
    }

    REGISTER {
        state [8] = 8'h00;
    }

    ASYNCHRONOUS {
        count = state;
    }

    SYNCHRONOUS(CLK=clk) {
        state <= state + 8'h01;
    }
@endmod

@simulation RunWhileEqFormDut
    CLOCK {
        clk = { period=10 };
    }

    WIRE {
        count [8];
    }

    @new dut RunWhileEqFormDut {
        clk [1] = clk;
        count [8] = count;
    }

    @run_while(count == 8'h00, timeout=ns=20)
@endsim
