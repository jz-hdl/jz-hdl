// HAPPY_PATH for WIDTHOF_INVALID_SYNTAX (§5.5.10):
// widthof() accepts plain identifiers (WIRE/REGISTER/PORT/BUS names) without
// slicing, concatenation, instance-qualification, or other expressions.

@project WIDTHOF_INVALID_SYNTAX_plain_identifier_ok
    @top TopMod {
        IN  [1]  clk = _;
        IN  [16] din = _;
        OUT [16] dout = _;
    }
@endproj

@module TopMod
    CONST {
        // Valid: plain PORT identifier.
        W_PORT = widthof(din);
    }
    PORT {
        IN  [1]  clk;
        IN  [16] din;
        OUT [16] dout;
    }
    WIRE {
        w_mid [W_PORT];
    }
    REGISTER {
        r_state [W_PORT] = W_PORT'd0;
    }
    ASYNCHRONOUS {
        w_mid = din;
        dout  = r_state;
    }
    SYNCHRONOUS(CLK=clk) {
        r_state <= w_mid;
    }
@endmod
