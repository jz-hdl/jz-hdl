// WIDTH_NONPOSITIVE_OR_NONINT: Negative declaration width rejected.
// Tests a negative WIRE width expression.
// Valid positive-width declarations included to verify no false positives.

@project WIDTH_NONPOSITIVE_OR_NONINT_negative_width
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] data_in = _;
        OUT [8] data_out = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] data_in;
        OUT [8] data_out;
    }
    WIRE {
        // Trigger: negative declaration width
        bad_w [-1];
    }
    REGISTER {
        r [8] = 8'h00;
    }
    ASYNCHRONOUS {
        data_out = r;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= data_in;
    }
@endmod
