// HAPPY_PATH: Valid @repeat usage compiles without diagnostics.
// Tests @repeat with count = 1 (single expansion, equivalent to no repeat).
// No diagnostics expected.

@project HAPPY_PATH_repeat_ok
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }
    REGISTER {
        r [1] = 1'b0;
    }
    ASYNCHRONOUS {
        data = r;
    }
    SYNCHRONOUS(CLK=clk) {
        // Valid: @repeat 1 — single expansion, no multi-assign
        @repeat 1
            r <= ~r;
        @end
    }
@endmod
