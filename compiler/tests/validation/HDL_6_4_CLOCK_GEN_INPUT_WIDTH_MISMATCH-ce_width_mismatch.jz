// CLOCK_GEN_INPUT_WIDTH_MISMATCH: connected CLOCK_GEN inputs must match chip-defined width.
// Uses BUF.CE on Gowin, which is width-1 in chip data.

@project(CHIP="gw2ar-18-qn88-c8-i7") CLOCK_GEN_INPUT_WIDTH_MISMATCH_ce_width_mismatch
    CLOCKS {
        ref_clk = { period=10 };
        ce_clk;
        buf_clk;
    }

    IN_PINS {
        ref_clk = { standard=LVCMOS33 };
        ce_clk = { mode=DIFFERENTIAL, standard=LVDS25, width=4, fclk=ref_clk, pclk=ref_clk, reset=ref_clk };
    }

    MAP {
        ref_clk = 1;
        ce_clk = { P=2, N=3 };
    }

    CLOCK_GEN {
        BUF {
            IN REF_CLK ref_clk;
            IN CE ce_clk;
            OUT BASE buf_clk;
        };
    }

    @top TopMod {
        IN  [1] clk = ref_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
