// TRISTATE_TRANSFORM_PER_BIT_FAIL: Per-bit tri-state pattern with different
// enable conditions per bit group. Verifies that the compiler detects when
// individual bit slices of the same signal have different z-assignment patterns.
// Contexts: helper module with per-bit tristate wire, top module with per-bit
// tristate wire.
// Expected: compiler emits TRISTATE_TRANSFORM_PER_BIT_FAIL for the per-bit
// pattern after identifying the tri-state transform candidates, while valid
// full-width z assignments remain transformable.

@project TRISTATE_TRANSFORM_PER_BIT_FAIL_per_bit
    @top TopMod {
        IN  [1] en_a = _;
        IN  [1] en_b = _;
        OUT [8] data = _;
    }
@endproj

// Helper module with per-bit tri-state: different enables for different slices
@module HelperMod
    PORT {
        IN  [1] en_a;
        IN  [1] en_b;
        OUT [8] data;
    }

    WIRE {
        w [8];
    }

    ASYNCHRONOUS {
        w[7:4] <= (en_a == 1'b1) ? 4'hA : 4'bzzzz;
        w[3:0] <= (en_b == 1'b1) ? 4'hB : 4'bzzzz;
        data <= w;
    }
@endmod

// Top module with per-bit tri-state pattern
@module TopMod
    PORT {
        IN  [1] en_a;
        IN  [1] en_b;
        OUT [8] data;
    }

    WIRE {
        w_top [8];
    }

    @new inst_h HelperMod {
        IN  [1] en_a = en_a;
        IN  [1] en_b = en_b;
        OUT [8] data = _;
    };

    ASYNCHRONOUS {
        w_top[7:4] <= (en_a == 1'b1) ? 4'hC : 4'bzzzz;
        w_top[3:0] <= (en_b == 1'b1) ? 4'hD : 4'bzzzz;
        data <= w_top;
    }
@endmod
