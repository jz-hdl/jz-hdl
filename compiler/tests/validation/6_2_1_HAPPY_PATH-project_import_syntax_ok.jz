// HAPPY_PATH: Valid @project with immediate @import directives, CONFIG, and @endproj.
// Covers the canonical §6.2.1 syntax with multiple imports and a top module
// resolved from an imported file.
// No diagnostics expected.

@project IMPORT_DIRECTIVE_project_import_syntax_ok

    @import "6_2_1_HAPPY_PATH-project_import_syntax_ok_top_lib.jz";
    @import "6_2_1_HAPPY_PATH-project_import_syntax_ok_helper_lib.jz";

    CONFIG {
        WIDTH = 8;
    }

    @top ImportedTop {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj
