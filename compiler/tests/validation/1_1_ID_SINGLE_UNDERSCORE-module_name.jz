// ID_SINGLE_UNDERSCORE: Single underscore `_` used as module name.
// Tests _ in module name declaration context (outside no-connect).
// Valid module names and valid _ in @top port binding included for no false positives.

@project ID_SINGLE_UNDERSCORE_module_name
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

// Trigger: _ used as module name
@module _
    PORT {
        IN  [1] din;
        OUT [1] data;
    }
    ASYNCHRONOUS {
        data = din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    @new inst_a _ {
        IN  [1] din = clk;
        OUT [1] data = _;
    };

    ASYNCHRONOUS {
        data = clk;
    }
@endmod
