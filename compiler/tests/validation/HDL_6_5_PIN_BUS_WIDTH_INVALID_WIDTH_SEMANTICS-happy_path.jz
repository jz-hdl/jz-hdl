// PIN_BUS_WIDTH_INVALID: Valid input bus widths compile cleanly.
// Exercises width-1 and multi-bit buses with per-bit MAP entries.

@project PIN_BUS_WIDTH_INVALID_width_semantics_ok
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        single_bit[1] = { standard=LVCMOS33 };
        nibble[4] = { standard=LVCMOS33 };
        byte_lane[8] = { standard=LVCMOS33 };
    }

    MAP {
        sys_clk = 1;
        single_bit[0] = 2;
        nibble[0] = 3;
        nibble[1] = 4;
        nibble[2] = 5;
        nibble[3] = 6;
        byte_lane[0] = 7;
        byte_lane[1] = 8;
        byte_lane[2] = 9;
        byte_lane[3] = 10;
        byte_lane[4] = 11;
        byte_lane[5] = 12;
        byte_lane[6] = 13;
        byte_lane[7] = 14;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
