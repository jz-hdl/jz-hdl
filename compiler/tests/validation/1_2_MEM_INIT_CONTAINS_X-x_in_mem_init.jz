// MEM_INIT_CONTAINS_X: Memory initialization literal contains x bits.
// §1.2 lists MEM initialization contents as an observable sink. This test
// exercises the MEM init observable-sink classification under §1.2.
// (Companion to 7_5_MEM_INIT_CONTAINS_X which covers §7.5.)

@project MEM_INIT_CONTAINS_X_x_in_mem_init
    @top TopMod {
        IN  [1] clk  = _;
        IN  [4] addr = _;
        OUT [8] data = _;
    }
@endproj

// Helper module: x in MEM init
@module HelperA
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        OUT [8] data;
    }

    MEM {
        // Trigger 1: partial x in MEM init literal
        m [8] [16] = 8'bxxxx_0000 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = m.rd[addr];
    }

    SYNCHRONOUS(CLK=clk) {
        m.wr[addr] <= 8'h00;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        OUT [8] data;
    }

    @new inst_a HelperA {
        IN  [1] clk  = clk;
        IN  [4] addr = addr;
        OUT [8] data = _;
    };

    // Trigger 2: all-x in MEM init literal in top module
    MEM {
        m [8] [16] = 8'bxxxx_xxxx {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    // Valid: no x in init (no error expected)
    MEM {
        m_ok [8] [16] = 8'h00 {
            OUT rd_ok ASYNC;
            IN  wr_ok;
        };
    }

    ASYNCHRONOUS {
        data = m.rd[addr] ^ m_ok.rd_ok[addr];
    }

    SYNCHRONOUS(CLK=clk) {
        m.wr[addr] <= 8'h00;
        m_ok.wr_ok[addr] <= 8'h00;
    }
@endmod
