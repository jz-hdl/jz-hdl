// HAPPY_PATH for WIDTHOF_WIDTH_NOT_RESOLVABLE (§5.5.10):
// widthof() succeeds when the referenced signal's width is fully resolvable
// from literals, earlier CONST definitions, and project CONFIG values.

@project WIDTHOF_WIDTH_NOT_RESOLVABLE_resolvable_width_ok
    CONFIG {
        CFG_W = 12;
    }

    @top TopMod {
        IN  [1]          clk = _;
        IN  [CONFIG.CFG_W] din = _;
        OUT [CONFIG.CFG_W] dout = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1]            clk;
        IN  [CONFIG.CFG_W] din;
        OUT [CONFIG.CFG_W] dout;
    }
    CONST {
        // Literal width is trivially resolvable.
        LIT_W  = 8;
        // Valid: widthof() on a PORT whose width comes from CONFIG.
        PORT_W = widthof(din);
    }
    WIRE {
        w_lit [LIT_W];
    }
    REGISTER {
        r_cfg [CONFIG.CFG_W] = CONFIG.CFG_W'd0;
    }
    ASYNCHRONOUS {
        w_lit = din[7:0];
        dout  = r_cfg;
    }
    SYNCHRONOUS(CLK=clk) {
        r_cfg <= din;
    }
@endmod
