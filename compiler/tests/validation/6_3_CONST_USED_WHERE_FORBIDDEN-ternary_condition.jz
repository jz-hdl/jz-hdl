// CONST_USED_WHERE_FORBIDDEN: CONST used as ternary condition in runtime expression.
// Tests module CONST used as condition in ternary (SIZE ? r : b) in runtime block.
// Valid compile-time CONST uses included to verify no false positives.

@project CONST_USED_WHERE_FORBIDDEN_ternary_condition
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [CONFIG.WIDTH] data = _;
    }
@endproj

@module Helper
    CONST {
        SIZE = 4;
    }
    PORT {
        IN  [1] clk;
        IN  [SIZE] a;
        IN  [SIZE] b;
        OUT [SIZE] dout;
    }
    REGISTER {
        r [SIZE] = 4'h0;
    }
    ASYNCHRONOUS {
        // Trigger: CONST as ternary condition in async expression
        dout = SIZE ? r : b;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= a;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [CONFIG.WIDTH] data;
    }

    WIRE {
        h_out [4];
    }

    @new inst_h Helper {
        IN  [1] clk = clk;
        IN  [4] a = 4'hA;
        IN  [4] b = 4'hB;
        OUT [4] dout = h_out;
    };

    REGISTER {
        r [CONFIG.WIDTH] = 8'h00;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= {4'h0, h_out};
    }
@endmod
