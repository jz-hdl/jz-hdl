// DIRECTIVE_INVALID_CONTEXT: Happy-path test for structural directives in
// their valid contexts.
// Exercises @project/@endproj at file scope, @module/@endmod at file scope,
// @new at module scope, @check at project and module scope, @feature at
// module scope, and @blackbox as a standalone module declaration.
// No diagnostics expected.

@project DIRECTIVE_INVALID_CONTEXT_valid_directives_ok
    CONFIG {
        WIDTH = 8;
    }

    // Valid: @check at project scope
    @check (CONFIG.WIDTH == 8, "config width must be 8");

    // Valid: @blackbox inside @project declares an external module
    @blackbox ExternalIp {
        PORT {
            IN  [1] clk;
            IN  [1] din;
            OUT [1] dout;
        }
    }

    @top TopMod {
        IN  [1] clk  = _;
        OUT [1] dout = _;
    }
@endproj

@module Helper
    PORT {
        IN  [1] clk;
        IN  [1] din;
        OUT [1] dout;
    }

    CONST {
        DEPTH = 4;
    }

    // Valid: @check at module scope
    @check (DEPTH > 0, "depth must be positive");

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        dout = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] dout;
    }

    CONST {
        USE_EXT = 0;
    }

    // Valid: @check at module scope
    @check (USE_EXT == 0 || USE_EXT == 1, "USE_EXT must be 0 or 1");

    REGISTER {
        r [1] = 1'b0;
    }

    // Valid: @new at module scope (structural instance)
    @new inst_helper Helper {
        IN  [1] clk  = clk;
        IN  [1] din  = r;
        OUT [1] dout = dout;
    };

    // Valid: @feature guard at module scope wrapping another @new instance
    @feature (USE_EXT == 1)
        @new inst_ext ExternalIp {
            IN  [1] clk  = clk;
            IN  [1] din  = r;
            OUT [1] dout = _;
        };
    @endfeat

    ASYNCHRONOUS {
        // dout driven by @new instance binding above
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
