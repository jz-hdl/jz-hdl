// NESTED_REPEAT_EXPANSION: nested @repeat blocks expand successfully in
// testbench mode.

@module NestedRepeatCounterDut
    PORT {
        IN  [1] clk;
        IN  [1] rst_n;
        OUT [8] count;
    }

    REGISTER {
        cnt [8] = 8'h00;
    }

    ASYNCHRONOUS {
        count <= cnt;
    }

    SYNCHRONOUS(CLK=clk RESET=rst_n RESET_ACTIVE=Low) {
        cnt <= cnt + 8'h01;
    }
@endmod

@testbench NestedRepeatCounterDut
    CLOCK {
        clk;
    }

    WIRE {
        rst_n [1];
        count [8];
    }

    TEST "nested @repeat expands inner blocks per outer iteration" {
        @new dut NestedRepeatCounterDut {
            clk   [1] = clk;
            rst_n [1] = rst_n;
            count [8] = count;
        }

        @setup {
            rst_n <= 1'b0;
        }

        @clock(clk, cycle=1)
        @update {
            rst_n <= 1'b1;
        }

        // Trigger 1: nesting is valid and expands to four post-reset clocks.
        @repeat 2
            @repeat 2
                @clock(clk, cycle=1)
            @end
        @end

        @expect_equal(count, 8'h04)
    }
@endtb
