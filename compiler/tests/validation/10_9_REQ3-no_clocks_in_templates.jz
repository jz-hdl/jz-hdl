// Req #3 (10.9 Rationale): Templates may not contain clocked logic.
// Target diagnostic: TEMPLATE_FORBIDDEN_BLOCK_HEADER.

@project REQ3_no_clocks_in_templates
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

// Trigger 1: clocked block header inside template body.
@template bad_clocked_logic(src, dst)
    SYNCHRONOUS(CLK=src) {
        dst <= src;
    }
@endtemplate

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
