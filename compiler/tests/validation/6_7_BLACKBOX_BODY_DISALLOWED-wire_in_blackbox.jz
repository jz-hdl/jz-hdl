// BLACKBOX_BODY_DISALLOWED: WIRE block inside @blackbox.
// Target diagnostic: the blackbox body semantic rule only.

@project BLACKBOX_BODY_DISALLOWED_wire_in_blackbox
    @blackbox bb_wire {
        PORT {
            IN  [1] din;
            OUT [1] dout;
        }
        WIRE {
            w [1];
        }
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
