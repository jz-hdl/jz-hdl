// MEM_CONST_ADDR_OUT_OF_RANGE: Constant address >= depth.
// mem [8] [3] has depth 3, so valid addresses are 0-2 and required width is 2.
// Triggers in async read and sync write contexts.
// Sized literals use the exact required width so only the out-of-range rule fires.

@project MEM_CONST_ADDR_OUT_OF_RANGE_const_addr_overflow
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] wdata = _;
        OUT [8] data = _;
    }
@endproj

// Helper: constant addr >= depth in async read and sync write
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] wdata;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM {
        mem_a [8] [3] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
            IN  wr2;
        };
    }

    ASYNCHRONOUS {
        // Trigger 1: addr 2'b11 >= depth 3
        data = mem_a.rd[2'b11];
    }

    SYNCHRONOUS(CLK=clk) {
        r <= r;
        // Valid: addr 2'b00 is within range
        mem_a.wr[2'b00] <= wdata;
        // Trigger 2: addr 2'b11 >= depth 3 in sync write
        mem_a.wr2[2'b11] <= 8'hAA;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] wdata;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM {
        mem_b [8] [3] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
            IN  wr2;
        };
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] wdata = wdata;
        OUT [8] data = _;
    };

    ASYNCHRONOUS {
        // Trigger 3: addr 2'b11 >= depth 3 in top module
        data = mem_b.rd[2'b11];
    }

    SYNCHRONOUS(CLK=clk) {
        r <= r;
        // Valid: addr 2'b10 is last valid (depth-1)
        mem_b.wr[2'b10] <= wdata;
        // Trigger 4: addr 2'b11 >= depth 3 in sync write in top
        mem_b.wr2[2'b11] <= 8'hBB;
    }
@endmod
