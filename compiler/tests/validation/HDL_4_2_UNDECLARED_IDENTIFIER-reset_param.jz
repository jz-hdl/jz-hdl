// UNDECLARED_IDENTIFIER: Undeclared name in SYNCHRONOUS RESET parameter.
// Tests that the compiler catches an undeclared signal used as RESET=<name>.

@project UNDECLARED_IDENTIFIER_reset_param
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

// Helper module: undeclared RESET parameter
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [1] din;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    // Trigger: undeclared identifier in RESET parameter
    SYNCHRONOUS(CLK=clk RESET=no_such_rst) {
        r <= din;
    }
@endmod

// Top module — structurally valid, no triggers
@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [1] din = r;
        OUT [1] data = _;
    };

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
