// PORT_MISSING_WIDTH: OUT port declared without mandatory [N] width.
// Trigger is on OUT port direction. Valid ports with width included for no false positives.

@project PORT_MISSING_WIDTH_out_missing_width
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] din = _;
        OUT [8] dout = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] din;
        // Trigger: OUT port without width
        OUT data_out;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data_out <= r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] din;
        OUT [8] dout;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] din = din;
        OUT data_out = dout;
    };

    ASYNCHRONOUS {
    }

    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
@endmod
