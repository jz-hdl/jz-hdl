// MUX_SELECTOR_OUT_OF_RANGE_CONST: Selector statically provable outside valid index range.
// Tests out-of-range constant indices on aggregation and auto-slice MUXes
// in both ASYNCHRONOUS and SYNCHRONOUS blocks.
// Sized literals use the exact required selector width so only the out-of-range
// rule fires.

@project MUX_SELECTOR_OUT_OF_RANGE_CONST_static_index_oob
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [8] a = _;
        IN  [8] b = _;
        IN  [8] c = _;
        OUT [8] data = _;
    }
@endproj

// Helper module: out-of-range on aggregation MUX
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [8] b;
        IN  [8] c;
        OUT [8] data;
    }

    // 3-element aggregation: valid indices are 0, 1, and 2. Required selector width is 2.
    MUX {
        agg3 = a, b, c;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        // Trigger 1: exact-width static index 2'b11 on 3-element MUX in ASYNC
        data = agg3[2'b11] | r;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger 2: exact-width static index 2'b11 on 3-element MUX in SYNC
        r <= agg3[2'b11];
    }
@endmod

// Top module: out-of-range on auto-slice MUX
@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [8] b;
        IN  [8] c;
        OUT [8] data;
    }

    WIRE {
        w24 [24];
        helper_out [8];
    }

    // 3-element auto-slice: 24 bits / 8 = 3 elements, valid indices 0, 1, and 2.
    MUX {
        slice3 [8] = w24;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] a = a;
        IN  [8] b = b;
        IN  [8] c = c;
        OUT [8] data = helper_out;
    };

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        w24 = {a, b, c};
        // Trigger 3: exact-width static index 2'b11 on 3-element auto-slice MUX in ASYNC
        data = slice3[2'b11] | helper_out | r;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger 4: exact-width static index 2'b11 on 3-element auto-slice MUX in SYNC
        r <= slice3[2'b11];
        // Valid: index 2'b10 is in range (no false positive)
    }
@endmod
