// PATH_SYMLINK_ESCAPE: Symlink resolving outside the sandbox is forbidden.
// Tests symlink rejection in @import context.

@project PATH_SYMLINK_ESCAPE_symlink_escape

    // Trigger 1: symlink target is outside compiler/tests/validation.
    @import "HDL_12_4_PATH_SYMLINK_ESCAPE-happy_path_escape_lib.jz";

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
