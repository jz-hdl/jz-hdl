// UNDECLARED_IDENTIFIER: undefined instance head in an instance-qualified access.
// Tests that `inst.port` reports an undeclared identifier when `inst` does not exist.

@project UNDECLARED_IDENTIFIER_undefined_instance_name
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module ChildMod
    PORT {
        IN  [1] din;
        OUT [1] dout;
    }

    ASYNCHRONOUS {
        dout = din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    @new inst_ok ChildMod {
        IN  [1] din = r;
        OUT [1] dout = _;
    };

    ASYNCHRONOUS {
        // Trigger 1: instance-qualified access uses an undefined instance name.
        data = ghost_inst.dout;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
