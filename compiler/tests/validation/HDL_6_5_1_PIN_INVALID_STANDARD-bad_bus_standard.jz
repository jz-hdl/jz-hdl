// PIN_INVALID_STANDARD: Invalid electrical standard in an IN_PINS bus declaration.
// Valid scalar and bus declarations are included to verify no false positives.

@project PIN_INVALID_STANDARD_bad_bus_standard
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        // Valid: scalar pin declaration (no trigger)
        valid_in = { standard=LVCMOS18 };
        // Valid: supported standard on bus declaration (no trigger)
        valid_bus[4] = { standard=LVCMOS12 };
        // Trigger 1: invalid standard on IN_PINS bus declaration
        bad_bus[2] = { standard=FAKESTD };
    }

    MAP {
        sys_clk = 1;
        valid_in = 2;
        valid_bus[0] = 3;
        valid_bus[1] = 4;
        valid_bus[2] = 5;
        valid_bus[3] = 6;
        bad_bus[0] = 7;
        bad_bus[1] = 8;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
