// PIN_INVALID_STANDARD + PIN_BUS_WIDTH_INVALID: Valid IN_PINS bus declarations.
// Exercises supported standards with legal bus widths and complete MAP coverage.

@project PIN_INVALID_STANDARD_PIN_BUS_WIDTH_INVALID_bus_in_pins_ok
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        data_bus[4] = { standard=LVCMOS18 };
        cfg_bus[2] = { standard=LVCMOS12 };
    }

    MAP {
        sys_clk = 1;
        data_bus[0] = 2;
        data_bus[1] = 3;
        data_bus[2] = 4;
        data_bus[3] = 5;
        cfg_bus[0] = 6;
        cfg_bus[1] = 7;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
