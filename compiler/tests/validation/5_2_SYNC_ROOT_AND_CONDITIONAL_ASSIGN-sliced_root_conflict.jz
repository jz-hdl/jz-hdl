// SYNC_ROOT_AND_CONDITIONAL_ASSIGN: Root-level sliced register assignment
// combined with nested conditional sliced assignment to overlapping bits.

@project SYNC_ROOT_AND_CONDITIONAL_ASSIGN_sliced_root_conflict
    @top TopMod {
        IN  [1] clk = _;
        IN  [1] sel = _;
        IN  [4] a = _;
        IN  [4] b = _;
        OUT [8] out = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] sel;
        IN  [4] a;
        IN  [4] b;
        OUT [8] out;
    }
    REGISTER {
        r [8] = 8'h00;
    }
    ASYNCHRONOUS {
        out = r;
    }
    SYNCHRONOUS(CLK=clk) {
        r[7:4] <= a;
        IF (sel) {
            r[5:2] <= b;
        }
    }
@endmod
