// PIN_DRIVE_FORBIDDEN_ON_INPUT: drive attribute is forbidden on IN_PINS.
// Target diagnostic: PIN_DRIVE_FORBIDDEN_ON_INPUT.
// Non-target diagnostics: none; the pin has a valid standard, map entry, and top binding.

@project PIN_DRIVE_FORBIDDEN_ON_INPUT_drive_on_input
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        // Valid: no drive attribute on IN_PINS.
        valid_in = { standard=LVCMOS18 };
        // Trigger 1: drive attribute present on IN_PINS.
        bad_in = { standard=LVCMOS33, drive=8 };
    }

    OUT_PINS {
        valid_out = { standard=LVCMOS33, drive=8 };
    }

    MAP {
        sys_clk = 1;
        valid_in = 2;
        bad_in = 3;
        valid_out = 4;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        IN  [1] ok = valid_in;
        IN  [1] bad = bad_in;
        OUT [1] data = valid_out;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] ok;
        IN  [1] bad;
        OUT [1] data;
    }

    REGISTER {
        sampled [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = sampled;
    }

    SYNCHRONOUS(CLK=clk) {
        sampled <= ok & bad;
    }
@endmod
