// Library file for HDL_6_2_1_IMPORT_FILE_MULTIPLE_TIMES-case_normalized_dup.jz
// Contains a valid imported module for case-normalized duplicate import tests.

@module ImportedMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
