// COMMENT_IN_TOKEN: Comment inside a port name declaration.
// Valid port names included to verify no false positives.

@project COMMENT_IN_TOKEN_port_name
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] result = _;
    }
@endproj

@module Helper
    PORT {
        IN  [1] clk;
        // Trigger: port name declaration
        OUT [1] da/**/ta;
    }
    REGISTER {
        r [1] = 1'b0;
    }
    ASYNCHRONOUS {
        data = r;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] result;
    }
    WIRE {
        w [1];
    }

    @new inst_h Helper {
        IN  [1] clk = clk;
        OUT [1] data = w;
    };

    ASYNCHRONOUS {
        result = w;
    }
@endmod
