// TEMPLATE_FORBIDDEN_DIRECTIVE: @check directive in file-scoped template.
// Tests that compile-time assertion @check is rejected inside template body.

@project TEMPLATE_FORBIDDEN_DIRECTIVE_check_in_template
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

// Trigger: @check directive inside file-scoped template
@template check_tmpl(a, b)
    @check (1, "this should not be here");
    a <= b;
@endtemplate

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
