// MARK_IF_CONDITION_COLOR_FORM: valid @mark_if(<condition>, <color>) syntax in @simulation.

@module MarkIfConditionColorFormDut
    PORT {
        IN  [1] clk;
        OUT [1] flag;
    }

    REGISTER {
        state [1] = 1'b0;
    }

    ASYNCHRONOUS {
        flag = state;
    }

    SYNCHRONOUS(CLK=clk) {
        state <= ~state;
    }
@endmod

@simulation MarkIfConditionColorFormDut
    CLOCK {
        clk = { period=10 };
    }

    WIRE {
        flag [1];
    }

    @new dut MarkIfConditionColorFormDut {
        clk [1] = clk;
        flag [1] = flag;
    }

    @run(ns=10)
    @mark_if(flag, GREEN)
    @run(ns=10)
@endsim
