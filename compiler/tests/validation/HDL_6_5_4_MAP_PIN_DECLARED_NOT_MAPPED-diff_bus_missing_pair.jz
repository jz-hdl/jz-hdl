// MAP_PIN_DECLARED_NOT_MAPPED: Differential bus requires one P/N pair per bit.
// Trigger 1 covers a differential bus declaration with width [2] but only one
// mapped pair in MAP. Valid differential scalar and fully mapped bus controls
// verify no false positives.

@project MAP_PIN_DECLARED_NOT_MAPPED_diff_bus_missing_pair
    IN_PINS {
        clk = { standard=LVCMOS33 };
        diff_ok = { mode=DIFFERENTIAL, standard=LVDS25 };
        // Trigger 1: differential bus bit 1 is missing its required P/N pair.
        diff_bus[2] = { mode=DIFFERENTIAL, standard=LVDS25 };
        diff_bus_ok[2] = { mode=DIFFERENTIAL, standard=LVDS25 };
    }

    OUT_PINS {
        led = { standard=LVCMOS33, drive=8 };
    }

    MAP {
        clk = 1;
        diff_ok = { P=2, N=3 };
        diff_bus[0] = { P=4, N=5 };
        // diff_bus[1] intentionally omitted
        diff_bus_ok[0] = { P=6, N=7 };
        diff_bus_ok[1] = { P=8, N=9 };
        led = 10;
    }

    @top TopMod {
        IN  [1] clk_in = clk;
        IN  [1] din_ok = diff_ok;
        IN  [2] din_bus_ok = diff_bus_ok;
        OUT [1] data = led;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk_in;
        IN  [1] din_ok;
        IN  [2] din_bus_ok;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r ^ din_ok ^ din_bus_ok[0] ^ din_bus_ok[1];
    }

    SYNCHRONOUS(CLK=clk_in) {
        r <= ~r;
    }
@endmod
