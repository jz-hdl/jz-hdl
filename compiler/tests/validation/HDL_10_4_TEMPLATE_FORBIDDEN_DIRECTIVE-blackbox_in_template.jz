// TEMPLATE_FORBIDDEN_DIRECTIVE: @blackbox directive in file-scoped template.
// Tests that structural @blackbox is rejected inside template body.

@project TEMPLATE_FORBIDDEN_DIRECTIVE_blackbox_in_template
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

// Trigger: @blackbox directive inside file-scoped template
@template bb_tmpl(a, b)
    @blackbox ExtBlock {
        IN  [1] din;
        OUT [1] dout;
    }
    a <= b;
@endtemplate

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
