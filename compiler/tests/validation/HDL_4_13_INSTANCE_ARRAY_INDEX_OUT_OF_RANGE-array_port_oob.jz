// INSTANCE_ARRAY_INDEX_OUT_OF_RANGE: arrayed instance port index must be in range.
// Target diagnostic: INSTANCE_ARRAY_INDEX_OUT_OF_RANGE.
// Non-target diagnostics expected: none. The child output port exists, the
// instance is an array, and all instance bindings are complete and width-correct.

@project INSTANCE_ARRAY_INDEX_OUT_OF_RANGE_array_port_oob
    @top TopMod {
        IN  [1] din = _;
        OUT [1] data = _;
    }
@endproj

@module Child
    PORT {
        IN  [1] din;
        OUT [1] data;
    }
    ASYNCHRONOUS {
        data = din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] din;
        OUT [1] data;
    }
    WIRE {
        child_data [2];
    }
    @new inst_arr[2] Child {
        IN  [1] din = din;
        OUT [1] data = child_data[IDX];
    };
    ASYNCHRONOUS {
        data = inst_arr[2].data;
    }
@endmod
