// SELECT_CHAIN_MULTIPLE_SIGNALS: consecutive @select directives may share the same run window.

@module SelectChainMultipleSignalsDut
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        state [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = state;
    }

    SYNCHRONOUS(CLK=clk) {
        state <= ~state;
    }
@endmod

@simulation SelectChainMultipleSignalsDut
    CLOCK {
        clk = { period=10 };
    }

    WIRE {
        data [1];
    }

    TAP {
        dut.state;
    }

    @new dut SelectChainMultipleSignalsDut {
        clk [1] = clk;
        data [1] = data;
    }

    @select(data, YELLOW)
    @select(dut.state, CYAN)
    @run(ns=10)
@endsim
