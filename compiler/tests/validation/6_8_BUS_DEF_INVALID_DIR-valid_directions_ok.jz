// HAPPY_PATH: BUS definitions accept IN, OUT, and INOUT signal directions.
// No diagnostics expected.

@project BUS_DEF_INVALID_DIR_valid_directions_ok
    BUS GOOD_BUS {
        OUT   [1] source_to_target;
        IN    [1] target_to_source;
        INOUT [2] bidir;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
