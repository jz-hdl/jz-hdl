// TEMPLATE_FORBIDDEN_DIRECTIVE: @apply directive in file-scoped template.
// Tests that @apply (template expansion) is rejected inside template body.
// A valid template is defined separately so the @apply has a real target.

@project TEMPLATE_FORBIDDEN_DIRECTIVE_apply_in_template
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

// Valid helper template used as @apply target
@template helper_tmpl(a, b)
    a <= b;
@endtemplate

// Trigger: @apply directive inside file-scoped template
@template apply_tmpl(a, b)
    @apply helper_tmpl(a, b);
@endtemplate

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
