// TB_BUS_NOT_FOUND: testbench BUS wire declarations must reference a BUS
// definition in scope.
// Target diagnostic: TB_BUS_NOT_FOUND on the unknown BUS declaration.
// Non-target diagnostics: none.
// Fixture plan: one valid module, one valid TEST, valid scalar clock/wire
// wiring, and one unused BUS wire declaration with an unknown BUS id.

@module UnknownTbBusWireDut
    PORT {
        IN  [1] clk;
        IN  [1] data_in;
        OUT [1] data_out;
    }

    ASYNCHRONOUS {
        data_out = data_in;
    }
@endmod

@testbench UnknownTbBusWireDut
    CLOCK {
        clk;
    }

    WIRE {
        data_in [1];
        data_out [1];
        BUS MISSING_BUS probe;
    }

    TEST "unknown BUS wire id is rejected" {
        @new dut UnknownTbBusWireDut {
            clk [1] = clk;
            data_in [1] = data_in;
            data_out [1] = data_out;
        }

        @setup {
            data_in <= 1'b0;
        }
    }
@endtb
