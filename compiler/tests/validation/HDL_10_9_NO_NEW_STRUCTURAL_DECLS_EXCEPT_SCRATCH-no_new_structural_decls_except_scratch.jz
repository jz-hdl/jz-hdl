// Req #1 (10.9 Rationale): Templates must not introduce new structural
// declarations except @scratch wires.
// Target diagnostic: TEMPLATE_FORBIDDEN_DECL.

@project REQ1_no_new_structural_decls_except_scratch
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

// Valid: @scratch is the only declaration form allowed inside templates.
@template scratch_only(buf_in, buf_out)
    @scratch tmp [1];
    tmp <= buf_in;
    buf_out <= tmp;
@endtemplate

// Trigger 1: structural WIRE declaration inside template body.
@template bad_structural_decl(buf_in, buf_out)
    WIRE {
        illegal_wire [1];
    }
    buf_out <= buf_in;
@endtemplate

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    WIRE {
        pass [1];
    }

    ASYNCHRONOUS {
        @apply scratch_only(r, pass);
        data = pass;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
