// HAPPY_PATH: lzc() behavioral requirements from §5.5.15.
// Exercises:
//   Req #1 - syntax `lzc(<source>)`.
//   Req #2 - result width is clog2(width(source) + 1).
//   Req #3 - source accepts any bit-vector expression with width >= 1.
//   Req #4 - counts consecutive zero bits from the MSB; all-zero source
//            returns width(source) at runtime.
//   Req #5 - lzc() is allowed on ASYNCHRONOUS RHS.
//   Req #6 - lzc() is allowed on SYNCHRONOUS RHS.

@project HAPPY_PATH_lzc_semantics_ok
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [8] src8 = _;
        IN  [8] mask8 = _;
        IN  [1] src1 = _;
        IN  [8] zeros8 = _;
        OUT [4] out_async_plain = _;
        OUT [4] out_async_expr = _;
        OUT [1] out_async_one = _;
        OUT [4] out_sync = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [8] src8;
        IN  [8] mask8;
        IN  [1] src1;
        OUT [4] out_plain;
        OUT [4] out_expr;
        OUT [1] out_one;
    }

    ASYNCHRONOUS {
        // Req #1/#2/#5: plain 8-bit source on ASYNCHRONOUS RHS yields 4 bits.
        out_plain = lzc(src8);
        // Req #3/#5: any bit-vector expression (here, `src8 & mask8`) is valid.
        out_expr  = lzc(src8 & mask8);
        // Req #2/#3/#5: minimum-width 1-bit source yields clog2(1 + 1) = 1 bit.
        out_one   = lzc(src1);
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] src8;
        IN  [8] mask8;
        IN  [1] src1;
        IN  [8] zeros8;
        OUT [4] out_async_plain;
        OUT [4] out_async_expr;
        OUT [1] out_async_one;
        OUT [4] out_sync;
    }

    WIRE {
        h_plain [4];
        h_expr  [4];
        h_one   [1];
    }

    REGISTER {
        r_sync [4] = 4'd0;
    }

    @new inst_h HelperMod {
        IN  [8] src8 = src8;
        IN  [8] mask8 = mask8;
        IN  [1] src1 = src1;
        OUT [4] out_plain = h_plain;
        OUT [4] out_expr = h_expr;
        OUT [1] out_one = h_one;
    };

    ASYNCHRONOUS {
        out_async_plain = h_plain;
        out_async_expr  = h_expr;
        out_async_one   = h_one;
        out_sync        = r_sync;
    }

    SYNCHRONOUS(CLK=clk) {
        // Req #4/#6: when `zeros8` is all zero at runtime, lzc returns 8.
        r_sync <= lzc(zeros8);
    }
@endmod
