// TERNARY_BRANCH_WIDTH_MISMATCH: MUX read in ternary branch.
// Tests that mux[sel] contributes its selected element width to ternary checks.
// Valid same-width MUX ternary included to verify no false positives.

@project TERNARY_BRANCH_WIDTH_MISMATCH_mux_context
    @top TopMod {
        IN  [1] sel = _;
        IN  [1] choose_mux = _;
        IN  [8] a = _;
        IN  [8] b = _;
        IN  [4] small = _;
        OUT [8] data = _;
        OUT [8] ok_data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] sel;
        IN  [1] choose_mux;
        IN  [8] a;
        IN  [8] b;
        IN  [4] small;
        OUT [8] data;
        OUT [8] ok_data;
    }

    MUX {
        choices = a, b;
    }

    ASYNCHRONOUS {
        // Trigger: MUX element is 8 bits, small is 4 bits
        data <= choose_mux ? choices[sel] : small;
        // Valid: both branches are 8 bits
        ok_data <= choose_mux ? choices[sel] : a;
    }
@endmod
