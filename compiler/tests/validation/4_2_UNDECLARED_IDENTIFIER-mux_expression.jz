// UNDECLARED_IDENTIFIER: Undeclared identifier in MUX selector expression.
// Tests that the compiler catches undeclared signals used as MUX index.

@project UNDECLARED_IDENTIFIER_mux_expression
    @top TopMod {
        IN  [1] clk = _;
        OUT [8] data = _;
    }
@endproj

// Helper module: undeclared identifier in MUX selector
@module HelperMod
    PORT {
        IN  [8] din_a;
        IN  [8] din_b;
        OUT [8] data;
    }

    MUX {
        my_mux = din_a, din_b;
    }

    ASYNCHRONOUS {
        // Trigger: undeclared identifier 'ghost_sel' as MUX selector
        data = my_mux[ghost_sel];
    }
@endmod

// Top module — structurally valid, no triggers
@module TopMod
    PORT {
        IN  [1] clk;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    @new inst_h HelperMod {
        IN  [8] din_a = r;
        IN  [8] din_b = r;
        OUT [8] data = _;
    };

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= r;
    }
@endmod
