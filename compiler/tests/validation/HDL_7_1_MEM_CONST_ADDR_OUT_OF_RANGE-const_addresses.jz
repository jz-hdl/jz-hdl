// MEM_CONST_ADDR_OUT_OF_RANGE: Constant addresses must fit the inferred MEM address width.
// Depth 1 has a 1-bit address, so only address 0 is valid.

@project MEM_CONST_ADDR_OUT_OF_RANGE_const_addresses
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] wdata = _;
        OUT [8] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] wdata;
        OUT [8] data;
    }

    MEM {
        mem_one [8] [1] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = mem_one.rd[1'b1];
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger 2: constant write address outside depth 1.
        mem_one.wr[1'b1] <= wdata;
    }
@endmod
