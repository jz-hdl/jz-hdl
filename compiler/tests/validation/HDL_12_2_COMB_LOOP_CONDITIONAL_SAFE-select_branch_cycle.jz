// COMB_LOOP_CONDITIONAL_SAFE: Cycles across mutually exclusive SELECT/CASE branches.
// Tests that the compiler warns (not errors) when cycles exist only
// across mutually exclusive CASE branches. Valid linear paths included
// to verify no false positives.

@project COMB_LOOP_CONDITIONAL_SAFE_select_branch_cycle
    @top TopMod {
        IN  [2] sel = _;
        IN  [1] in_a = _;
        OUT [1] out_a = _;
        OUT [1] out_b = _;
    }
@endproj

// Helper: conditional-safe cycle across SELECT/CASE branches
@module HelperSelect
    PORT {
        IN  [2] sel;
        IN  [1] in_a;
        OUT [1] out_a;
        OUT [1] out_b;
    }

    WIRE {
        a [1];
        b [1];
    }

    ASYNCHRONOUS {
        // Trigger: cycle only across mutually exclusive CASE branches
        SELECT (sel) {
            CASE 2'b00 {
                a <= in_a;
                b <= a;
            }
            CASE 2'b01 {
                b <= in_a;
                a <= b;
            }
            DEFAULT {
                a <= in_a;
                b <= in_a;
            }
        }
        out_a = a;
        out_b = b;
    }
@endmod

@module TopMod
    PORT {
        IN  [2] sel;
        IN  [1] in_a;
        OUT [1] out_a;
        OUT [1] out_b;
    }

    WIRE {
        x [1];
        y [1];
    }

    @new inst_sel HelperSelect {
        IN  [2] sel = sel;
        IN  [1] in_a = in_a;
        OUT [1] out_a = _;
        OUT [1] out_b = _;
    };

    ASYNCHRONOUS {
        // Trigger: cycle only across mutually exclusive CASE branches
        SELECT (sel) {
            CASE 2'b10 {
                x <= in_a;
                y <= x;
            }
            CASE 2'b11 {
                y <= in_a;
                x <= y;
            }
            DEFAULT {
                x <= in_a;
                y <= in_a;
            }
        }
        out_a = x;
        out_b = y;
    }
@endmod
