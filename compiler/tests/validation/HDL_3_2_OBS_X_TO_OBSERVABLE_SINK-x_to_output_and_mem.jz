// OBS_X_TO_OBSERVABLE_SINK: x bits driving observable sinks.
// Covers ASYNCHRONOUS output ports and SYNCHRONOUS MEM write ports.

@project OBS_X_TO_OBSERVABLE_SINK_x_to_output_and_mem
    @top TopMod {
        IN  [1] clk = _;
        IN  [2] addr = _;
        IN  [8] val = _;
        OUT [8] out_a = _;
        OUT [8] out_b = _;
        OUT [8] out_c = _;
        OUT [8] out_d = _;
    }
@endproj

// Helper module: x bits driving output port in ASYNCHRONOUS block
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] val;
        OUT [8] out_a;
        OUT [8] out_b;
    }
    REGISTER {
        r_ok [8] = 8'h00;
    }
    ASYNCHRONOUS {
        // Trigger: ASYNC → output port (x-bit expression driving OUT directly)
        out_a <= val + 8'bxxxx_0000;
        // Valid: no x bits driving output (no false positive)
        out_b = r_ok;
    }
    SYNCHRONOUS(CLK=clk) {
        r_ok <= val;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [2] addr;
        IN  [8] val;
        OUT [8] out_a;
        OUT [8] out_b;
        OUT [8] out_c;
        OUT [8] out_d;
    }
    WIRE {
        ha_a [8];
        ha_b [8];
    }
    REGISTER {
        r_ok [8] = 8'h00;
    }
    MEM {
        m [8] [4] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] val = val;
        OUT [8] out_a = ha_a;
        OUT [8] out_b = ha_b;
    };

    ASYNCHRONOUS {
        // Trigger: ASYNC → output port in top module
        out_a <= ha_a | 8'b0000_xxxx;
        // Valid: no x bits (no false positive)
        out_b = ha_b;
        out_c = r_ok;
        out_d = m.rd[addr];
    }
    SYNCHRONOUS(CLK=clk) {
        r_ok <= val;
        // Trigger: SYNC -> MEM write port
        m.wr[addr] <= val | 8'bxxxx_0000;
    }
@endmod
