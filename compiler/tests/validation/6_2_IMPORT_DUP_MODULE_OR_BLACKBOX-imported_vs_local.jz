// IMPORT_DUP_MODULE_OR_BLACKBOX: Imported module name duplicates a local blackbox.
// The local blackbox collides with SharedLocal from the imported file.

@project IMPORT_DUP_MODULE_OR_BLACKBOX_imported_vs_local
    @import "6_2_IMPORT_DUP_MODULE_OR_BLACKBOX-imported_vs_local_imported.jz";

    @blackbox SharedLocal {
        PORT {
            IN  [1] din;
            OUT [1] data;
        }
    }

    @top TopMod {
        IN  [1] din = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] din;
        OUT [1] data;
    }
    @new inst_shared SharedLocal {
        IN  [1] din = din;
        OUT [1] data = _;
    };
    ASYNCHRONOUS {
        data = din;
    }
@endmod
