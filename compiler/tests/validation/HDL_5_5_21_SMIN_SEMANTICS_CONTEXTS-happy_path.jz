// HAPPY_PATH: smin() coverage for §5.5.21.
// Exercises:
//   Req #1 - syntax `smin(<a>, <b>)`.
//   Req #2 - allowed on ASYNCHRONOUS RHS.
//   Req #3 - allowed on SYNCHRONOUS RHS.

@project HAPPY_PATH_smin_semantics_contexts_ok
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [3] small_a = _;
        IN  [5] wide_b = _;
        IN  [4] async_left = _;
        IN  [4] async_right = _;
        IN  [2] sync_small = _;
        IN  [6] sync_wide = _;
        OUT [5] out_mixed_width = _;
        OUT [4] out_async_same_width = _;
        OUT [6] out_sync = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [3] small_a;
        IN  [5] wide_b;
        IN  [4] async_left;
        IN  [4] async_right;
        OUT [5] mixed_width;
        OUT [4] async_same_width;
    }

    ASYNCHRONOUS {
        // Req #1/#2: mixed-width signed minimum is valid on ASYNCHRONOUS RHS.
        mixed_width = smin(small_a, wide_b);
        // Req #1/#2: same-width signed minimum is valid on ASYNCHRONOUS RHS.
        async_same_width = smin(async_left, async_right);
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [3] small_a;
        IN  [5] wide_b;
        IN  [4] async_left;
        IN  [4] async_right;
        IN  [2] sync_small;
        IN  [6] sync_wide;
        OUT [5] out_mixed_width;
        OUT [4] out_async_same_width;
        OUT [6] out_sync;
    }

    WIRE {
        h_mixed [5];
        h_async [4];
    }

    REGISTER {
        r_sync [6] = 6'd0;
    }

    @new inst_h HelperMod {
        IN  [3] small_a = small_a;
        IN  [5] wide_b = wide_b;
        IN  [4] async_left = async_left;
        IN  [4] async_right = async_right;
        OUT [5] mixed_width = h_mixed;
        OUT [4] async_same_width = h_async;
    };

    ASYNCHRONOUS {
        out_mixed_width = h_mixed;
        out_async_same_width = h_async;
        out_sync = r_sync;
    }

    SYNCHRONOUS(CLK=clk) {
        // Req #1/#3: signed minimum is valid on SYNCHRONOUS RHS.
        r_sync <= smin(sync_small, sync_wide);
    }
@endmod
