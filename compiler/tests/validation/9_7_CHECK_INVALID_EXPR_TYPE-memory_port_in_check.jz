// CHECK_INVALID_EXPR_TYPE: Memory port field used in @check expression.
// S9.4 lists "any memory port" as a forbidden operand in @check.
// Valid @check with CONST included to verify no false positives.

@project CHECK_INVALID_EXPR_TYPE_memory_port_in_check
    CONFIG {
        DEPTH = 16;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [4] addr = _;
        IN  [8] wdata = _;
        OUT [8] data = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    CONST { SIZE = 4; }

    MEM {
        mem_h [8] [16] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    // Valid: CONST in @check (no error)
    @check (SIZE > 0, "size ok");

    // Trigger: memory port field in @check expression
    @check (mem_h.rd == 8'h00, "mem port in check");

    ASYNCHRONOUS {
        data = mem_h.rd[addr];
    }

    SYNCHRONOUS(CLK=clk) {
        mem_h.wr[addr] <= wdata;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    CONST { WIDTH = 8; }

    // Valid: CONST in @check (no error)
    @check (WIDTH == 8, "width ok");

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [4] addr = addr;
        IN  [8] wdata = wdata;
        OUT [8] data = _;
    };

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= wdata;
    }
@endmod
