// ASYNC_INVALID_STATEMENT_TARGET: LHS in ASYNC assignment is not assignable.
// This file keeps its historical suffix, but the fixture intentionally uses
// CONST targets because MEM SYNC .addr assignments fire the MEM-specific rule.
// Valid port assignments in the same branches verify no false positives.

@project ASYNC_INVALID_STATEMENT_TARGET_mem_sync_in_async
    @top TopMod {
        IN  [1] sel = _;
        IN  [4] addr = _;
        IN  [8] wdata = _;
        OUT [8] rdata_a = _;
        OUT [8] rdata_b = _;
    }
@endproj

// Helper module: CONST assigned in an ASYNC IF branch.
@module HelperMod
    PORT {
        IN  [1] sel;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] rdata;
    }

    CONST {
        HELPER_CONST = 8;
    }

    ASYNCHRONOUS {
        IF (sel) {
            // Trigger 1: CONST is not assignable.
            HELPER_CONST <= wdata;
            rdata <= wdata;
        } ELSE {
            rdata <= {4'h0, addr};
        }
    }
@endmod

@module TopMod
    PORT {
        IN  [1] sel;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] rdata_a;
        OUT [8] rdata_b;
    }

    CONST {
        TOP_CONST = 16;
    }

    @new inst_h HelperMod {
        IN  [1] sel = sel;
        IN  [4] addr = addr;
        IN  [8] wdata = wdata;
        OUT [8] rdata = rdata_a;
    };

    ASYNCHRONOUS {
        SELECT (sel) {
            CASE (1'b0) {
                // Trigger 2: CONST is not assignable.
                TOP_CONST = wdata;
                rdata_b <= {4'h0, addr};
            }
            DEFAULT {
                rdata_b <= wdata;
            }
        }
    }
@endmod
