// CDC_HAPPY_PATH: CDC source register may be read in ASYNCHRONOUS logic.
// Exercises the §4.12 exception that combinational reads of the source
// register are allowed even after the CDC entry defines its home domain.

@project CDC_HAPPY_PATH_source_reg_async_read_ok
    @top TopMod {
        IN  [1] clk_a = _;
        IN  [1] clk_b = _;
        OUT [1] out_top = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk_a;
        IN  [1] clk_b;
        OUT [1] helper_out;
    }

    REGISTER {
        src_flag [1] = 1'b0;
        helper_seen [1] = 1'b0;
    }

    CDC {
        BIT src_flag (clk_a) => src_flag_sync (clk_b);
    }

    ASYNCHRONOUS {
        // Valid: source register read in ASYNCHRONOUS logic.
        helper_out = src_flag ^ helper_seen;
    }

    SYNCHRONOUS(CLK=clk_a) {
        src_flag <= ~src_flag;
    }

    SYNCHRONOUS(CLK=clk_b) {
        helper_seen <= src_flag_sync;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk_a;
        IN  [1] clk_b;
        OUT [1] out_top;
    }

    REGISTER {
        top_src [1] = 1'b0;
        top_seen [1] = 1'b0;
    }

    CDC {
        BIT top_src (clk_a) => top_sync (clk_b);
    }

    @new helper HelperMod {
        IN  [1] clk_a = clk_a;
        IN  [1] clk_b = clk_b;
        OUT [1] helper_out = _;
    };

    ASYNCHRONOUS {
        // Valid: source register read in ASYNCHRONOUS logic.
        out_top = top_src ^ top_seen;
    }

    SYNCHRONOUS(CLK=clk_a) {
        top_src <= ~top_src;
    }

    SYNCHRONOUS(CLK=clk_b) {
        top_seen <= top_sync;
    }
@endmod
