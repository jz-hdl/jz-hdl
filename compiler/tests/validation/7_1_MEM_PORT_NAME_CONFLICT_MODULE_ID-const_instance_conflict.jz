// MEM_PORT_NAME_CONFLICT_MODULE_ID: MEM port name conflicts with module-level identifier.
// Tests conflict with CONST name and instance name contexts.

@project MEM_PORT_NAME_CONFLICT_MODULE_ID_const_instance_conflict
    @top TopMod {
        IN  [1] clk = _;
        IN  [4] addr = _;
        IN  [8] wdata = _;
        OUT [8] data = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM {
        mem_a [8] [16] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = mem_a.rd[addr] ^ r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= wdata;
        mem_a.wr[addr] <= wdata;
    }
@endmod

@module TopMod
    CONST {
        MY_CONST = 4;
    }

    PORT {
        IN  [1] clk;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    // Trigger: CONST name — MEM port name conflicts with CONST name
    MEM {
        mem_b [8] [16] = 8'h00 {
            OUT rd_b ASYNC;
            IN  MY_CONST;
        };
    }

    // Trigger: instance name — MEM port name conflicts with instance name
    MEM {
        mem_c [8] [16] = 8'h00 {
            OUT inst_h ASYNC;
            IN  wr_c;
        };
    }

    // Valid: unique port names (no error expected)
    MEM {
        mem_ok [8] [16] = 8'h00 {
            OUT rd_ok ASYNC;
            IN  wr_ok;
        };
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [4] addr = addr;
        IN  [8] wdata = wdata;
        OUT [8] data = _;
    };

    ASYNCHRONOUS {
        data = mem_b.rd_b[addr] ^ mem_ok.rd_ok[addr] ^ mem_c.inst_h[addr];
    }

    SYNCHRONOUS(CLK=clk) {
        r <= r;
        mem_b.MY_CONST[addr] <= wdata;
        mem_ok.wr_ok[addr] <= wdata;
        mem_c.wr_c[addr] <= wdata;
    }
@endmod
