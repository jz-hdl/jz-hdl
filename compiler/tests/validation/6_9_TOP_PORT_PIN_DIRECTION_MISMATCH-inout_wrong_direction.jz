// TOP_PORT_PIN_DIRECTION_MISMATCH: INOUT top ports must bind only to INOUT_PINS.
// Tests INOUT port bound to IN_PINS, INOUT port bound to OUT_PINS.
// Valid INOUT->INOUT_PINS binding included for no false positives.

@project TOP_PORT_PIN_DIRECTION_MISMATCH_inout_wrong_direction
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        in_only = { standard=LVCMOS33 };
    }

    OUT_PINS {
        out_only = { standard=LVCMOS33, drive=8 };
    }

    INOUT_PINS {
        shared_bus[4] = { standard=LVCMOS33, drive=8 };
    }

    MAP {
        sys_clk = 1;
        in_only = 2;
        out_only = 3;
        shared_bus[0] = 4;
        shared_bus[1] = 5;
        shared_bus[2] = 6;
        shared_bus[3] = 7;
    }

    @top TopMod {
        IN    [1] clk = sys_clk;
        // Trigger 1: INOUT port bound to IN_PINS
        INOUT [1] bad_inout_in = in_only;
        // Trigger 2: INOUT port bound to OUT_PINS
        INOUT [1] bad_inout_out = out_only;
        // Valid: INOUT port bound to INOUT_PINS
        INOUT [4] ok_bus = shared_bus;
    }
@endproj

@module TopMod
    PORT {
        IN    [1] clk;
        INOUT [1] bad_inout_in;
        INOUT [1] bad_inout_out;
        INOUT [4] ok_bus;
    }

    REGISTER {
        drive_toggle [1] = 1'b0;
        drive_value  [4] = 4'h0;
    }

    ASYNCHRONOUS {
        IF (drive_toggle) {
            bad_inout_in <= 1'b1;
            bad_inout_out <= 1'b0;
            ok_bus <= drive_value;
        } ELSE {
            bad_inout_in <= 1'bz;
            bad_inout_out <= 1'bz;
            ok_bus <= 4'bz;
        }
    }

    SYNCHRONOUS(CLK=clk) {
        drive_toggle <= ~drive_toggle;
        drive_value <= ok_bus;
    }
@endmod
