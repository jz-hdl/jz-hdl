// CLOCK_NAME_NOT_TOP_IN_PORT: external clock is declared and pinned but not bound to any IN port on @top.
// Target diagnostic: CLOCK_NAME_NOT_TOP_IN_PORT.
// Non-target diagnostics: none; both clocks are declared in IN_PINS and MAP, and the bound top module is otherwise valid.

@project CLOCK_NAME_NOT_TOP_IN_PORT_missing_top_binding
    CLOCKS {
        // Valid: bound to an IN port on the top module.
        sys_clk = { period=10 };
        // Trigger 1: declared and mapped, but not bound to any IN port on @top.
        aux_clk = { period=20 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        aux_clk = { standard=LVCMOS33 };
    }

    MAP {
        sys_clk = 1;
        aux_clk = 2;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
