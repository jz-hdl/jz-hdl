// HAPPY_PATH for GBIT_INDEX_OUT_OF_RANGE: gbit() with constant indices
// that are strictly within [0, W) must not trigger the diagnostic in any
// allowed context (ASYNCHRONOUS RHS, SYNCHRONOUS RHS).

@project GBIT_INDEX_OUT_OF_RANGE_in_range_ok
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] data = _;
        OUT [1] out_a = _;
        OUT [1] out_b = _;
    }
@endproj

// Helper module: in-range constant indices across ASYNC and SYNC
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] src;
        OUT [1] out_a;
        OUT [1] out_b;
    }
    REGISTER {
        r [1] = 1'b0;
    }
    ASYNCHRONOUS {
        // Valid: index 0 on 8-bit source (min valid).
        out_a <= gbit(src, 3'd0);
        out_b = r;
    }
    SYNCHRONOUS(CLK=clk) {
        // Valid: index 7 on 8-bit source (max valid).
        r <= gbit(src, 3'd7);
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] data;
        OUT [1] out_a;
        OUT [1] out_b;
    }
    WIRE {
        ha_a [1];
        ha_b [1];
    }
    REGISTER {
        r [1] = 1'b0;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] src = data;
        OUT [1] out_a = ha_a;
        OUT [1] out_b = ha_b;
    };

    ASYNCHRONOUS {
        // Valid: mid-range constant index.
        out_a <= gbit(data, 3'd3);
        out_b = r;
    }
    SYNCHRONOUS(CLK=clk) {
        // Valid: max in-range index.
        r <= gbit(data, 3'd7);
    }
@endmod
