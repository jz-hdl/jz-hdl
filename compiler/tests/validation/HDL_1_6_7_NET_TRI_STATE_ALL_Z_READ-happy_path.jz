// §1.6.7 Req #2: Structural masking must eliminate all unknown bits
// before a z-carrying value reaches an observable sink. This happy-path
// test shows the correct pattern: read a tri-state INOUT bus only when
// an external/structural condition guarantees a determinate (non-z)
// value, so no unknown bits propagate to REGISTERs, OUT ports, MEM
// init, or top-level pins.

@project(CHIP=GENERIC) OBS_STRUCTURAL_MASKING_OK
    CLOCKS {
        sys_clk = { period=10.0 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        rd_en_pin = { standard=LVCMOS33 };
    }

    OUT_PINS {
        out_pin[8] = { standard=LVCMOS33, drive=8 };
    }

    INOUT_PINS {
        io_pin[8] = { standard=LVCMOS33, drive=8 };
    }

    MAP {
        sys_clk   = 1;
        rd_en_pin = 2;
        out_pin[0] = 3;
        out_pin[1] = 4;
        out_pin[2] = 5;
        out_pin[3] = 6;
        out_pin[4] = 7;
        out_pin[5] = 8;
        out_pin[6] = 9;
        out_pin[7] = 10;
        io_pin[0] = 11;
        io_pin[1] = 12;
        io_pin[2] = 13;
        io_pin[3] = 14;
        io_pin[4] = 15;
        io_pin[5] = 16;
        io_pin[6] = 17;
        io_pin[7] = 18;
    }

    @top TopMod {
        IN    [1] clk    = sys_clk;
        IN    [1] rd_en  = rd_en_pin;
        OUT   [8] out    = out_pin;
        INOUT [8] io     = io_pin;
    }
@endproj

@module TopMod
    PORT {
        IN    [1] clk;
        IN    [1] rd_en;
        OUT   [8] out;
        INOUT [8] io;
    }

    REGISTER {
        // Happy: register only loads io when rd_en guarantees an external drive
        r_latched [8] = 8'h00;
    }

    ASYNCHRONOUS {
        // Happy: io is released (z) when we are not driving; structural
        // masking: the OUT port always has a determinate value (0xA5 or
        // a released path conditioned by rd_en). When rd_en is low, the
        // external driver supplies a determinate value.
        io <= rd_en ? 8'bzzzz_zzzz : 8'hA5;

        // Happy: OUT is driven by a register (non-z, determinate)
        out <= r_latched;
    }

    SYNCHRONOUS(CLK=clk) {
        // Happy: only latch io when rd_en gates the read path — external
        // peer is driving, so the value is determinate
        IF (rd_en) {
            r_latched <= io;
        } ELSE {
            r_latched <= r_latched;
        }
    }
@endmod
