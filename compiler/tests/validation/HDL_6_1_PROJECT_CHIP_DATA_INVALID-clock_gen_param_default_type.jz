// PROJECT_CHIP_DATA_INVALID: clock_gen parameter defaults must be strings or numbers.

@project(CHIP="HDL_6_1_PROJECT_CHIP_DATA_INVALID-clock_gen_param_default_type") PROJECT_CHIP_DATA_INVALID_clock_gen_param_default_type
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    ASYNCHRONOUS {
        data = clk;
    }
@endmod
