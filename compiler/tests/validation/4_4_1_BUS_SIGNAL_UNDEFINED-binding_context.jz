// BUS_SIGNAL_UNDEFINED: Access to a nonexistent BUS signal in a @new port-
// binding expression. Extends the ASYNC-only coverage for Reqs #34, #35.

@project BUS_SIGNAL_UNDEFINED_binding_context
    BUS MY_BUS {
        OUT [8] tx;
        IN  [8] rx;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [8] dout_a = _;
    }
@endproj

// Leaf module consuming an 8-bit port
@module Consumer
    PORT {
        IN  [1] clk;
        IN  [8] din;
        OUT [8] data_out;
    }

    REGISTER {
        rc [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data_out <= rc;
    }

    SYNCHRONOUS(CLK=clk) {
        rc <= din;
    }
@endmod

// Intermediate module owns a BUS TARGET port and binds a child's din to a
// nonexistent BUS signal in the @new port-binding expression.
@module BindingMod
    PORT {
        IN  [1] clk;
        BUS MY_BUS TARGET tbus;
        OUT [8] data_out;
    }

    ASYNCHRONOUS {
        tbus.rx <= 8'h00;
    }

    // Trigger 1: @new binding expression references a BUS signal that is not
    // declared in BUS MY_BUS (`bogus` is not one of {tx, rx}).
    @new inst_c Consumer {
        IN  [1] clk = clk;
        IN  [8] din = tbus.bogus;
        OUT [8] data_out = data_out;
    };
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [8] dout_a;
    }

    @new inst_b BindingMod {
        IN  [1] clk = clk;
        BUS MY_BUS TARGET tbus = _;
        OUT [8] data_out = dout_a;
    };

    ASYNCHRONOUS {
    }
@endmod
