// KEYWORD_AS_IDENTIFIER: Happy-path test for identifiers that resemble but are
// not exactly reserved keywords.
// The reserved list is case-sensitive and applies only to UPPERCASE forms like
// CONST, PORT, WIRE, REGISTER, LATCH, MEM, MUX, CDC, IN, OUT, INOUT,
// ASYNCHRONOUS, SYNCHRONOUS, IF, ELIF, ELSE, SELECT, CASE, DEFAULT,
// OVERRIDE, CONFIG, CLOCKS, IN_PINS, OUT_PINS, INOUT_PINS, MAP, IDX, VCC, GND.
// Near-keywords (different casing, suffixes, prefixes) remain valid.
// No diagnostics expected.

@project KEYWORD_AS_IDENTIFIER_valid_identifiers_ok
    CONFIG {
        // Near-keyword CONFIG entry name (config-name context)
        config_v = 8;
    }

    @top TopMod {
        IN  [1] clk  = _;
        OUT [1] dout = _;
    }
@endproj

// Module name that resembles a keyword but isn't one
@module Register_Bank
    PORT {
        IN  [1] clk;
        // Port names: lowercase versions of keywords are valid
        IN  [1] in_bit;
        IN  [1] port_val;
        OUT [1] out_bit;
        OUT [1] wire_x;
    }

    // CONST names: underscore-suffixed and lowercase-keyword-like
    CONST {
        idx      = 4;
        const_v  = 1;
        Mux      = 2;
        myVCC    = 3;
    }

    // REGISTER names: keyword-adjacent identifiers
    REGISTER {
        register_r [1] = 1'b0;
        latch_r    [1] = 1'b0;
        mem_r      [1] = 1'b0;
        selectOne  [1] = 1'b0;
    }

    WIRE {
        case_w    [1];
        default_w [1];
        ifCond    [1];
        mux_a     [8];
        mux_b     [8];
    }

    // LATCH name: near-keyword identifier (latch-name context)
    LATCH {
        latch_d [1] D;
    }

    // MEM name: near-keyword identifier (mem-name context)
    MEM {
        mem_store [1] [4] = 1'b0 {
            OUT mem_rd ASYNC;
            IN  mem_wr;
        };
    }

    // MUX name: near-keyword identifier (mux-name context)
    MUX {
        mux_sel = mux_a, mux_b;
    }

    ASYNCHRONOUS {
        out_bit   = register_r;
        wire_x    = latch_r;
        case_w    = mem_r;
        default_w = selectOne;
        ifCond    = register_r;
        mux_a     <= 8'b00000000;
        mux_b     <= 8'b11111111;
        latch_d   <= in_bit : mem_store.mem_rd[2'b00];
    }

    SYNCHRONOUS(CLK=clk) {
        register_r <= in_bit;
        latch_r    <= port_val;
        mem_r      <= ~mem_r;
        selectOne  <= ~selectOne;
        mem_store.mem_wr[2'b00] <= in_bit;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] dout;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    // Instance name resembles a keyword but is valid
    @new port_inst Register_Bank {
        IN  [1] clk      = clk;
        IN  [1] in_bit   = r;
        IN  [1] port_val = r;
        OUT [1] out_bit  = dout;
        OUT [1] wire_x   = _;
    };

    ASYNCHRONOUS {
        // wires/regs using near-keyword names; valid in expressions
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
