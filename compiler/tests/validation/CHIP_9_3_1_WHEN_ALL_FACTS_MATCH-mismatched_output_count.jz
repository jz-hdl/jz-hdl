// WHEN_ALL_FACTS_MATCH: a clock_gen variant matches only when every fact in
// its `when` object matches the elaborated unit facts.
// Trigger 1 mismatches only output.count while input.REF_CLK.source still matches.

@project(CHIP="CHIP_9_3_1_WHEN_ALL_FACTS_MATCH-mismatched_output_count") WHEN_ALL_FACTS_MATCH_mismatched_output_count
    CLOCKS {
        ref_clk = { period=10 };
        pll_clk;
    }

    IN_PINS {
        ref_clk = { standard=LVCMOS33 };
    }

    MAP {
        ref_clk = 1;
    }

    CLOCK_GEN {
        // Trigger 1: input.REF_CLK.source matches "pad", but output.count is 1
        // and the chip variants only match output.count=2.
        PLL {
            IN REF_CLK ref_clk;
            OUT PRIMARY pll_clk;
        };
    }

    @top TopMod {
        IN  [1] clk = pll_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
