// PROJECT_CHIP_DATA_INVALID: differential.type must use the validated vocabulary.

@project(CHIP="HDL_6_1_PROJECT_CHIP_DATA_INVALID-invalid_differential_type") PROJECT_CHIP_DATA_INVALID_invalid_differential_type
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    ASYNCHRONOUS {
        data = clk;
    }
@endmod
