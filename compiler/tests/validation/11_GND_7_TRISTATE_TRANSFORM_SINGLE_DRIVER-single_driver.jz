// TRISTATE_TRANSFORM_SINGLE_DRIVER: Single-driver tri-state net transformed.
// Verifies that a single-driver tri-state wire (one ternary with z fallback)
// triggers TRISTATE_TRANSFORM_SINGLE_DRIVER warning when transformed.
// Contexts: helper module with single-driver tristate wire, top module with
// single-driver tristate wire.
// Expected: compiler emits INFO_TRISTATE_TRANSFORM and the
// TRISTATE_TRANSFORM_SINGLE_DRIVER warning for each single-driver net.

@project TRISTATE_TRANSFORM_SINGLE_DRIVER_single_driver
    @top TopMod {
        IN  [1] en = _;
        OUT [8] data = _;
    }
@endproj

// Helper module with single-driver tri-state wire
@module HelperMod
    PORT {
        IN  [1] en;
        IN  [8] din;
        OUT [8] data;
    }

    WIRE {
        w [8];
    }

    ASYNCHRONOUS {
        w <= (en == 1'b1) ? din : 8'bzzzz_zzzz;
        data <= w;
    }
@endmod

// Top module with single-driver tri-state wire
@module TopMod
    PORT {
        IN  [1] en;
        OUT [8] data;
    }

    WIRE {
        w_top [8];
    }

    @new inst_h HelperMod {
        IN  [1] en = en;
        IN  [8] din = 8'hFF;
        OUT [8] data = _;
    };

    ASYNCHRONOUS {
        w_top <= (en == 1'b1) ? 8'hCC : 8'bzzzz_zzzz;
        data <= w_top;
    }
@endmod
