// CONFIG_USED_WHERE_FORBIDDEN: CONFIG used as operator operand in runtime expression.
// Tests CONFIG.WIDTH used in arithmetic expression (x + CONFIG.WIDTH) in runtime block.
// Valid compile-time CONFIG uses included to verify no false positives.

@project CONFIG_USED_WHERE_FORBIDDEN_operator_operand
    CONFIG {
        WIDTH = 8;
        DEPTH = 4;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [CONFIG.WIDTH] din = _;
        OUT [CONFIG.WIDTH] data = _;
    }
@endproj

@module Helper
    PORT {
        IN  [1] clk;
        IN  [CONFIG.WIDTH] din;
        OUT [CONFIG.WIDTH] dout;
    }
    REGISTER {
        r [CONFIG.WIDTH] = 8'h00;
    }
    ASYNCHRONOUS {
        // Trigger: CONFIG as operator operand in async expression
        dout = r + CONFIG.WIDTH;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [CONFIG.WIDTH] din;
        OUT [CONFIG.WIDTH] data;
    }

    WIRE {
        h_out [CONFIG.WIDTH];
    }

    @new inst_h Helper {
        IN  [1] clk = clk;
        IN  [CONFIG.WIDTH] din = din;
        OUT [CONFIG.WIDTH] dout = h_out;
    };

    REGISTER {
        r [CONFIG.WIDTH] = 8'h00;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= h_out;
    }
@endmod
