// TEMPLATE_FORBIDDEN_DIRECTIVE: @global directive in file-scoped template.
// Tests that structural @global is rejected inside template body.

@project TEMPLATE_FORBIDDEN_DIRECTIVE_global_in_template
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

// Trigger: @global directive inside file-scoped template
@template global_tmpl(a, b)
    @global CONSTS
        MY_VAL [8] = 8'hFF;
    @endglob
    a <= b;
@endtemplate

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
