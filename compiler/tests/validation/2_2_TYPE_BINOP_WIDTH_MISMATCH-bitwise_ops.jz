// TYPE_BINOP_WIDTH_MISMATCH: Bitwise binary operators reject mismatched operand widths.
// Tests width mismatch for &, |, ^ operators
// across ASYNCHRONOUS and SYNCHRONOUS blocks in multiple modules.
// Valid same-width bitwise operations included to verify no false positives.

@project TYPE_BINOP_WIDTH_MISMATCH_bitwise_ops
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] a = _;
        IN  [4] b = _;
        OUT [8] result = _;
    }
@endproj

// Helper: width mismatch in bitwise AND
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [4] b;
        OUT [8] data;
    }
    REGISTER {
        r [8] = 8'd0;
    }
    ASYNCHRONOUS {
        // Valid: same-width bitwise OR (no false positive)
        data <= r | 8'd0;
    }
    SYNCHRONOUS(CLK=clk) {
        // Trigger: bitwise AND with mismatched widths (8 vs 4)
        r <= a & b;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [4] b;
        OUT [8] result;
    }
    WIRE {
        h_data [8];
    }
    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] a = a;
        IN  [4] b = b;
        OUT [8] data = h_data;
    };
    REGISTER {
        r1 [8] = 8'd0;
        r2 [8] = 8'd0;
    }
    ASYNCHRONOUS {
        // Valid: same-width bitwise XOR reads both registers (no false positive)
        result <= r1 ^ r2;
    }
    SYNCHRONOUS(CLK=clk) {
        // Trigger: bitwise OR with mismatched widths (8 vs 4)
        r1 <= a | b;
        // Trigger: bitwise XOR with mismatched widths (8 vs 4)
        r2 <= a ^ b;
    }
@endmod
