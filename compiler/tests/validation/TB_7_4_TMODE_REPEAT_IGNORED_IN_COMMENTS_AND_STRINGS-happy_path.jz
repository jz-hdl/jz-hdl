// REPEAT_IGNORED_IN_COMMENTS_AND_STRINGS: @repeat text inside comments and
// string literals is ignored by the repeat expander.

@module RepeatIgnoredInCommentsAndStringsDut
    PORT {
        IN  [1] clk;
        IN  [1] rst_n;
        OUT [8] count;
    }

    REGISTER {
        cnt [8] = 8'h00;
    }

    ASYNCHRONOUS {
        count <= cnt;
    }

    SYNCHRONOUS(CLK=clk RESET=rst_n RESET_ACTIVE=Low) {
        cnt <= cnt + 8'h01;
    }
@endmod

@testbench RepeatIgnoredInCommentsAndStringsDut
    CLOCK {
        clk;
    }

    WIRE {
        rst_n [1];
        count [8];
    }

    TEST "@repeat text inside comments and strings stays inert" {
        @new dut RepeatIgnoredInCommentsAndStringsDut {
            clk   [1] = clk;
            rst_n [1] = rst_n;
            count [8] = count;
        }

        @setup {
            rst_n <= 1'b0;
        }

        // Trigger 1: this fake repeat block is inside comments and must not
        // expand into additional clocks.
        // @repeat 99
        //     @clock(clk, cycle=1)
        // @end

        @clock(clk, cycle=1)
        @update {
            rst_n <= 1'b1;
        }

        // Trigger 2: @repeat text inside this string literal must print as-is.
        @print("literal @repeat 99 IDX @end")

        @repeat 2
            @clock(clk, cycle=1)
        @end

        @expect_equal(count, 8'h02)
    }
@endtb
