// COMMENT_IN_TOKEN: Comment inside a MEM name.
// Valid mem names included to verify no false positives.

@project COMMENT_IN_TOKEN_mem_name
    @top TopMod {
        IN  [1] clk = _;
        IN  [1] din = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] din;
        OUT [1] data;
    }

    MEM {
        // Trigger: comment inside mem name
        my/**/mem [1] [4] = 1'b0 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = din;
    }
@endmod
