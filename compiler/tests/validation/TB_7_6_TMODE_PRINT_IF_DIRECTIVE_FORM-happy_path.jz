// PRINT_IF_DIRECTIVE_FORM: Valid @print_if directive syntax in a TEST sequence.
// Exercises @print_if(<condition>, "<format_string>", <arg1>, <arg2>, ...)
// with a multibit testbench wire condition and positional signal arguments.

@module PrintIfDirectiveFormDut
    PORT {
        IN  [1] clk;
        IN  [8] data_in;
        OUT [8] data_out;
    }

    REGISTER {
        state [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data_out = state;
    }

    SYNCHRONOUS(CLK=clk) {
        state <= data_in;
    }
@endmod

@testbench PrintIfDirectiveFormDut
    CLOCK {
        clk;
    }

    WIRE {
        emit [2];
        data_in [8];
        data_out [8];
    }

    TEST "valid @print_if call form" {
        @new dut PrintIfDirectiveFormDut {
            clk [1] = clk;
            data_in [8] = data_in;
            data_out [8] = data_out;
        }

        @setup {
            emit <= 2'b10;
            data_in <= 8'h3C;
        }

        @clock(clk, cycle=1)
        @print_if(emit, "data=%h tick=%tick bits=%b", data_out, data_out)
        @expect_equal(data_out, 8'h3C)
    }
@endtb
