// HAPPY_PATH: Imported files contribute valid module and blackbox declarations.
// Covers §6.2.1 imported-file content and imported namespace visibility without
// duplicate names or duplicate paths.
// No diagnostics expected.

@project IMPORT_DIRECTIVE_imported_namespace_ok

    @import "6_2_1_IMPORTED_NAMESPACE-happy_path_content_lib.jz";
    @import "6_2_1_IMPORTED_NAMESPACE-happy_path_imported_namespace_helper_lib.jz";

    CONFIG {
        WIDTH = 8;
    }

    @top ImportedTop {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj
