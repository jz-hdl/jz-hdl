// MUX_NAME_DUPLICATE: MUX identifier duplicates another MUX name in the same module.
// One trigger for MUX-name context. Valid MUX included for negative testing.

@project MUX_NAME_DUPLICATE_dup_mux
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [8] a = _;
        IN  [8] b = _;
        IN  [8] c = _;
        OUT [8] data = _;
    }
@endproj

// Helper module: two MUXes with the same name
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [8] b;
        IN  [8] c;
        OUT [8] data;
    }

    MUX {
        shared = a, b;
    }

    // Trigger: MUX name — 'shared' duplicates the MUX name declared above
    MUX {
        shared = b, c;
    }

    // Valid MUX — unique name, no conflict
    MUX {
        ok_mux = a, c;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data = ok_mux[1'b0] | r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= a;
    }
@endmod

// Top module: instantiates helper, has valid MUX (no dup)
@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [8] b;
        IN  [8] c;
        OUT [8] data;
    }

    WIRE {
        helper_out [8];
    }

    MUX {
        top_mux = a, b;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] a = a;
        IN  [8] b = b;
        IN  [8] c = c;
        OUT [8] data = helper_out;
    };

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data = top_mux[1'b0] | helper_out | r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= a;
    }
@endmod
