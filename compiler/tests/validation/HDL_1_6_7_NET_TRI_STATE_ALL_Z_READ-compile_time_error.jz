// §1.6.7 Req #7: Failure to structurally eliminate all unknown bits
// results in a compile-time error. This negative test confirms that
// each unmasked z reaching an observable sink (REGISTER next-state,
// OUT port, top-level pin) produces an `error` severity diagnostic
// (not a warning) — i.e. the build fails at compile time.

@project(CHIP=GENERIC) OBS_Z_COMPILE_TIME_ERROR
    CLOCKS {
        sys_clk = { period=10.0 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33, drive=8 };
        en_pin  = { standard=LVCMOS33, drive=8 };
    }

    OUT_PINS {
        out_pin[8] = { standard=LVCMOS33, drive=8 };
    }

    MAP {
        sys_clk   = 1;
        en_pin    = 2;
        out_pin[0] = 3;
        out_pin[1] = 4;
        out_pin[2] = 5;
        out_pin[3] = 6;
        out_pin[4] = 7;
        out_pin[5] = 8;
        out_pin[6] = 9;
        out_pin[7] = 10;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        IN  [1] en  = en_pin;
        OUT [8] pin_data = out_pin;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] en;
        OUT [8] pin_data;
    }

    WIRE {
        // Trigger: wire driven only with z in every branch
        w_allz [8];
    }

    REGISTER {
        // Trigger sink: z-carrying net feeds this register next-state
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        IF (en) {
            w_allz <= 8'bzzzz_zzzz;
        } ELSE {
            w_allz <= 8'bzzzz_zzzz;
        }
        // Trigger sink: z-carrying net feeds top-level pin via OUT port
        pin_data <= r ^ w_allz;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger sink: z-carrying net feeds REGISTER next-state
        r <= w_allz;
    }
@endmod
