// CHECK_FAILED: true @check conditions do not emit diagnostics.
// Exercises passing @check directives in project scope and module scope
// so the CHECK_FAILED rule has a dedicated happy-path fixture.

@project CHECK_FAILED_true_conditions_ok
    CONFIG {
        WIDTH = 8;
        DEPTH = 64;
    }

    // Valid: project CONFIG equality evaluates true.
    @check (CONFIG.WIDTH == 8, "width is 8");

    // Valid: nonzero arithmetic result is truthy at project scope.
    @check (CONFIG.DEPTH - 63, "depth minus 63 is nonzero");

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] din;
        OUT [1] data;
    }

    CONST { SIZE = 4; }

    // Valid: module CONST comparison evaluates true.
    @check (SIZE == 4, "size is 4");

    // Valid: CONST arithmetic result is nonzero.
    @check (SIZE * 2, "double size is nonzero");

    ASYNCHRONOUS {
        data = din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    CONST { SIZE = 16; }
    CONST { ADDR_W = 4; }

    // Valid: CONST equality in top module.
    @check (SIZE == 16, "size ok");

    // Valid: compile-time intrinsic result evaluates true.
    @check (ADDR_W == clog2(SIZE), "addr width matches");

    @new inst_a HelperMod {
        IN  [1] din = r;
        OUT [1] data = _;
    };

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
