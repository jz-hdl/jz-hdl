// §1.6.7 Req #6: Structural masking must eliminate all unknown bits
// before a z-carrying value reaches a top-level project pin (OUT_PINS
// or INOUT_PINS). Negative test: a wire with only z drivers feeds the
// top module's OUT port which is mapped to OUT_PINS.

@project(CHIP=GENERIC) OBS_Z_TO_TOP_LEVEL_PIN
    CLOCKS {
        sys_clk = { period=10.0 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        en_pin  = { standard=LVCMOS33 };
    }

    OUT_PINS {
        out_pin[8] = { standard=LVCMOS33, drive=8 };
    }

    MAP {
        sys_clk   = 1;
        en_pin    = 2;
        out_pin[0] = 3;
        out_pin[1] = 4;
        out_pin[2] = 5;
        out_pin[3] = 6;
        out_pin[4] = 7;
        out_pin[5] = 8;
        out_pin[6] = 9;
        out_pin[7] = 10;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        IN  [1] en  = en_pin;
        OUT [8] out_data = out_pin;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] en;
        OUT [8] out_data;
    }

    WIRE {
        // Trigger: wire carries only z on every branch
        w_allz [8];
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        IF (en) {
            w_allz <= 8'bzzzz_zzzz;
        } ELSE {
            w_allz <= 8'bzzzz_zzzz;
        }
        // Trigger: z-carrying wire feeding top module OUT mapped to OUT_PINS
        out_data <= w_allz;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
