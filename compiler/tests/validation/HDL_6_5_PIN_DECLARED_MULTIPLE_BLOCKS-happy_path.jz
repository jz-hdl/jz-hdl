// PIN_DECLARED_MULTIPLE_BLOCKS: Pin names unique across all PIN blocks.
// Exercises distinct names in IN_PINS, OUT_PINS, and INOUT_PINS.

@project PIN_DECLARED_MULTIPLE_BLOCKS_cross_block_unique_ok
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        sensor_in = { standard=LVCMOS33 };
        cfg_bus[2] = { standard=LVCMOS18 };
    }

    OUT_PINS {
        status_led = { standard=LVCMOS33, drive=8 };
        data_out[2] = { standard=LVCMOS18, drive=4 };
    }

    INOUT_PINS {
        ctrl_io = { standard=LVCMOS33, drive=4 };
        aux_io = { standard=LVCMOS18, drive=8 };
    }

    MAP {
        sys_clk = 1;
        sensor_in = 2;
        cfg_bus[0] = 3;
        cfg_bus[1] = 4;
        status_led = 5;
        data_out[0] = 6;
        data_out[1] = 7;
        ctrl_io = 8;
        aux_io = 9;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
