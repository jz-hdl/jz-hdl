// CONST_UNDEFINED_IN_WIDTH_OR_SLICE: truly-undefined identifier used as slice
// bound (not declared as WIRE/REGISTER/PORT/CONST/CONFIG anywhere).
//
// Observable behavior: UNDECLARED_IDENTIFIER (priority 1) fires from the
// general identifier-resolution pass and preempts CONST_UNDEFINED_IN_WIDTH_OR_SLICE
// (priority 0) in the per-line diagnostic display. This test documents that
// interaction — the slice-check still *detects* the undefined name, but the
// higher-priority rule is what surfaces to the user.

@project CONST_UNDEFINED_IN_WIDTH_OR_SLICE_truly_undefined
    @top TopMod {
        IN  [8] bus   = _;
        OUT [4] out_a = _;
        OUT [4] out_b = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [8] bus;
        OUT [4] out_a;
        OUT [4] out_b;
    }

    ASYNCHRONOUS {
        // Trigger 1: UNDEF_MSB is not declared anywhere
        out_a = bus[UNDEF_MSB:0];
        // Trigger 2: both bounds undeclared
        out_b = bus[UNDEF_HI:UNDEF_LO];
    }
@endmod
