// Req #41: DLL syntax is accepted even when chip data is unavailable.
// This verifies DLL participates in CLOCK_GEN parsing and generic validation.

@project DLL_no_chip_data
    CLOCKS {
        ref_clk = { period=10 };
        dll_clk;
    }

    IN_PINS {
        ref_clk = { standard=LVCMOS33 };
    }

    MAP {
        ref_clk = 1;
    }

    CLOCK_GEN {
        DLL {
            IN REF_CLK ref_clk;
            OUT BASE dll_clk;
        };
    }

    @top TopMod {
        IN  [1] clk = ref_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
