// PIN_WIDTH_REQUIRES_DIFFERENTIAL: width on non-differential INOUT pin.
// Tests that width= on INOUT_PINS without mode=DIFFERENTIAL fires an error.
// Valid differential IN pin with width included for no false positives.

@project PIN_WIDTH_REQUIRES_DIFFERENTIAL_width_inout_no_diff
    CLOCKS {
        sys_clk = { period=10 };
        fast_clk = { period=2 };
        parallel_clk = { period=10 };
        reset_n = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        fast_clk = { standard=LVCMOS33 };
        parallel_clk = { standard=LVCMOS33 };
        reset_n = { standard=LVCMOS33 };
        // Valid: width on differential IN pin (no trigger)
        valid_diff = { standard=LVDS25, mode=DIFFERENTIAL, width=10, fclk=fast_clk, pclk=parallel_clk, reset=reset_n };
    }

    INOUT_PINS {
        // Valid: INOUT pin without width (no trigger)
        valid_io = { standard=LVCMOS33, drive=4 };
        // Trigger: width on non-differential INOUT pin
        bad_io = { standard=LVCMOS33, drive=4, width=10 };
    }

    MAP {
        sys_clk = 1;
        fast_clk = 2;
        parallel_clk = 3;
        reset_n = 4;
        valid_diff = { P=5, N=6 };
        valid_io = 7;
        bad_io = 8;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
