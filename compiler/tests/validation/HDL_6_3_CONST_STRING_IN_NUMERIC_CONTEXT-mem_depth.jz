// CONST_STRING_IN_NUMERIC_CONTEXT: String CONFIG value used as MEM depth.
// Target diagnostic: CONST_STRING_IN_NUMERIC_CONTEXT.
// Non-target diagnostics before the fix: MEM_UNDEFINED_CONST_IN_WIDTH.

@project CONST_STRING_IN_NUMERIC_CONTEXT_mem_depth
    CONFIG {
        WIDTH = 8;
        FIRMWARE = "out/fw.bin";
    }

    @top TopMod {
        IN  [4] addr = _;
        OUT [CONFIG.WIDTH] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [4] addr;
        OUT [CONFIG.WIDTH] data;
    }

    MEM {
        mem_a [CONFIG.WIDTH] [CONFIG.FIRMWARE] = 8'h00 {
            OUT rd ASYNC;
        };
    }

    ASYNCHRONOUS {
        data = mem_a.rd[addr];
    }
@endmod
