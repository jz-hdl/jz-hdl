// Library file for 5_5_WIDTHOF_INVALID_SYNTAX-imported_module_signal.jz
// Declares a module whose internal signals the main file attempts to query.

@module LibHelper
    PORT {
        IN  [1]  clk;
        IN  [16] din;
        OUT [16] dout;
    }
    REGISTER {
        r [16] = 16'd0;
    }
    ASYNCHRONOUS {
        dout = r;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
@endmod
