// PIN_PULL_INVALID: Invalid pull value on OUT_PINS.
// Tests that invalid pull values on output pins fire PIN_PULL_INVALID
// (not PIN_PULL_ON_OUTPUT, since the value check runs first).
// Valid pull on IN_PINS included to verify no false positives.

@project PIN_PULL_INVALID_bad_pull_on_output
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        // Valid: pull=UP on IN_PINS (no trigger)
        valid_in = { standard=LVCMOS33, pull=UP };
    }

    OUT_PINS {
        // Valid: no pull attribute (no trigger)
        valid_out = { standard=LVCMOS33, drive=8 };
        // Trigger: invalid pull value on OUT_PINS
        bad_pull_out = { standard=LVCMOS33, drive=8, pull=KEEPER };
    }

    MAP {
        sys_clk = 1;
        valid_in = 2;
        valid_out = 3;
        bad_pull_out = 4;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
