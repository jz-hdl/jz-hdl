// WIDTHOF_INVALID_SYNTAX: widthof() argument must be a plain identifier;
// qualified references to signals of an imported module are forbidden.
// Spec §5.5.10: widthof() does not resolve imported module signals.

@project WIDTHOF_INVALID_SYNTAX_imported_module_signal

    @import "5_5_WIDTHOF_INVALID_SYNTAX-imported_module_signal_lib.jz";

    @top TopMod {
        IN  [1]  clk = _;
        IN  [16] din = _;
        OUT [16] dout = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1]  clk;
        IN  [16] din;
        OUT [16] dout;
    }
    WIRE {
        h_dout [16];
    }

    @new inst_h LibHelper {
        IN  [1]  clk  = clk;
        IN  [16] din  = din;
        OUT [16] dout = h_dout;
    };

    CONST {
        // Trigger 1: widthof() on a qualified reference to an imported
        // module's internal signal (module-qualified; no instance).
        BAD_W = widthof(LibHelper.r);
        // Valid: widthof() on a local WIRE (no false positive).
        GOOD_W = widthof(h_dout);
    }

    ASYNCHRONOUS {
        dout = h_dout;
    }
@endmod
