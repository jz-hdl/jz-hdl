// HAPPY_PATH: Valid project-level CLOCKS block with unique clock names.
// Exercises the §6.10 uniqueness rule without triggering duplicate-clock diagnostics.

@project HAPPY_PATH_clock_name_uniqueness_ok
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
    }

    MAP {
        sys_clk = 1;
    }

    @top TopMod {
        IN  [1] sys_clk = sys_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] sys_clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=sys_clk) {
        r <= ~r;
    }
@endmod
