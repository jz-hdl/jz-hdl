// TRISTATE_TRANSFORM_BLACKBOX_PORT: VCC variant of blackbox INOUT port error.
// Trigger: blackbox module's INOUT port connected to wire with local tri-state driver.
// Context: VCC default variant of blackbox port tri-state connection.

@project BLACKBOX_PORT_vcc_blackbox_inout
    @blackbox ExtMod {
        PORT {
            IN    [1] en;
            INOUT [8] data;
        }
    }

    @top TopMod {
        IN  [1] en = _;
        IN  [8] din = _;
        OUT [8] result = _;
    }
@endproj

// Driver module with standard ternary z pattern
@module DriverMod
    PORT {
        IN    [1] en;
        IN    [8] din;
        INOUT [8] data;
    }

    ASYNCHRONOUS {
        data <= (en == 1'b1) ? din : 8'bzzzz_zzzz;
    }
@endmod

// Trigger: VCC default variant — blackbox INOUT on shared wire
@module TopMod
    PORT {
        IN  [1] en;
        IN  [8] din;
        OUT [8] result;
    }

    WIRE {
        bus [8];
    }

    @new inst_drv DriverMod {
        IN    [1] en = en;
        IN    [8] din = din;
        INOUT [8] data = bus;
    };

    @new inst_ext ExtMod {
        IN    [1] en = en;
        INOUT [8] data = bus;
    };

    ASYNCHRONOUS {
        result <= bus;
    }
@endmod
