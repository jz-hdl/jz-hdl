// PIN_INVALID_STANDARD: Valid IN_PINS standards compile cleanly.
// Exercises scalar input pin declarations with supported standards.

@project PIN_INVALID_STANDARD_in_pins_ok
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        data_in = { standard=LVCMOS18 };
        cfg_in = { standard=LVCMOS12 };
    }

    MAP {
        sys_clk = 1;
        data_in = 2;
        cfg_in = 3;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
