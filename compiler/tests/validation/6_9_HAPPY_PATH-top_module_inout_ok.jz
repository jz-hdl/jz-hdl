// HAPPY_PATH: Valid @top INOUT port bound to INOUT_PINS.
// No diagnostics expected.

@project HAPPY_PATH_top_module_inout_ok
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
    }

    INOUT_PINS {
        data_bus[4] = { standard=LVCMOS33, drive=8 };
    }

    MAP {
        sys_clk = 1;
        data_bus[0] = 2;
        data_bus[1] = 3;
        data_bus[2] = 4;
        data_bus[3] = 5;
    }

    @top TopMod {
        IN    [1] clk = sys_clk;
        INOUT [4] bus = data_bus;
    }
@endproj

@module TopMod
    PORT {
        IN    [1] clk;
        INOUT [4] bus;
    }

    REGISTER {
        drive_value [4] = 4'h0;
        drive_enable [1] = 1'b0;
    }

    ASYNCHRONOUS {
        IF (drive_enable) {
            bus <= drive_value;
        } ELSE {
            bus <= 4'bz;
        }
    }

    SYNCHRONOUS(CLK=clk) {
        drive_value <= bus;
        drive_enable <= ~drive_enable;
    }
@endmod
