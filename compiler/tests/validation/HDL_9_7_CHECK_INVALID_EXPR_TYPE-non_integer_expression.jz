// CHECK_INVALID_EXPR_TYPE: @check expression produces a non-integer value.
// Covers vector-valued forms that are not valid integer constant expressions in
// compile-time checks. Valid scalar @check uses are included for no false positives.

@project CHECK_INVALID_EXPR_TYPE_non_integer_expression
    CONFIG {
        WIDTH = 8;
        DEPTH = 16;
    }

    // Valid: scalar constant expression at project scope.
    @check (CONFIG.WIDTH == 8, "project width ok");

    // Trigger 1: concatenation produces a non-integer vector in @check.
    @check ({CONFIG.WIDTH, 4'd1}, "concat in project check");

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] din;
        OUT [1] data;
    }

    CONST {
        HELPER_OK = 1;
    }

    // Valid: scalar CONST expression at module scope.
    @check (HELPER_OK, "helper const ok");

    ASYNCHRONOUS {
        data = din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    CONST {
        WIDTH_OK = 8;
        MASK = 8'hA5;
    }

    // Valid: scalar CONST expression at module scope.
    @check (WIDTH_OK == CONFIG.WIDTH, "top width ok");

    // Trigger 2: slice produces a non-integer vector in @check.
    @check (MASK[7:4], "slice in module check");

    @new helper HelperMod {
        IN  [1] din = r;
        OUT [1] data = _;
    };

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
