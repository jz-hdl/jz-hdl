// MUX_AGG_SOURCE_INVALID: CONST identifier used as aggregation source.
// One trigger for const-as-source context. Valid sources included for negative testing.

@project MUX_AGG_SOURCE_INVALID_const_source
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [8] a = _;
        IN  [1] sel = _;
        OUT [8] data = _;
    }
@endproj

// Helper module: CONST used as MUX aggregation source
@module HelperMod
    CONST {
        MY_VAL = 42;
    }

    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [1] sel;
        OUT [8] data;
    }

    // Trigger: const as source — 'MY_VAL' is a CONST, not a readable signal
    MUX {
        bad_mux = a, MY_VAL;
    }

    // Valid MUX — only signal sources
    MUX {
        ok_mux = a, a;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data = ok_mux[sel] | r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= a;
    }
@endmod

// Top module: instantiates helper, valid MUX only
@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [1] sel;
        OUT [8] data;
    }

    WIRE {
        helper_out [8];
    }

    MUX {
        top_mux = a, a;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] a = a;
        IN  [1] sel = sel;
        OUT [8] data = helper_out;
    };

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data = top_mux[sel] | helper_out | r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= a;
    }
@endmod
