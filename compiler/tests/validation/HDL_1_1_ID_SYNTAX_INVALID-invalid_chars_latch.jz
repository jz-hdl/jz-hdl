// ID_SYNTAX_INVALID: Character-class violation in latch-name context.
// Hyphen in a LATCH name; the lexer splits it into separate tokens,
// causing an ID_SYNTAX_INVALID diagnostic.

@project ID_SYNTAX_INVALID_invalid_chars_latch
    @top TopMod {
        IN  [1] clk = _;
        IN  [1] enable = _;
        IN  [1] din = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] enable;
        IN  [1] din;
        OUT [1] data;
    }

    // Trigger: hyphen in latch-name
    LATCH {
        my-lat [1] D;
    }

    ASYNCHRONOUS {
        data = din;
    }
@endmod
