// WIDTH_NONPOSITIVE_OR_NONINT: Valid positive widths accepted.
// Exercises positive widths on PORT, WIRE, and REGISTER declarations.
// No diagnostics expected.

@project WIDTH_NONPOSITIVE_OR_NONINT_valid_widths
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] data_in = _;
        OUT [8] data_out = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] data_in;
        OUT [8] data_out;
    }
    WIRE {
        stage [8];
    }
    REGISTER {
        acc [8] = 8'd0;
    }
    ASYNCHRONOUS {
        stage = acc;
        data_out = stage;
    }
    SYNCHRONOUS(CLK=clk) {
        acc <= data_in;
    }
@endmod
