// BLACKBOX_BODY_DISALLOWED: MEM block inside @blackbox.
// Target diagnostic: the blackbox body semantic rule only.

@project BLACKBOX_BODY_DISALLOWED_mem_in_blackbox
    @blackbox bb_mem {
        PORT {
            IN  [1] din;
            OUT [1] dout;
        }
        MEM {
            mem [8] [4] = 8'h00 {};
        }
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
