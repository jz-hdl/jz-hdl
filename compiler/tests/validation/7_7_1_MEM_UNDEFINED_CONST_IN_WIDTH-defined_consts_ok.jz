// MEM_UNDEFINED_CONST_IN_WIDTH: declared CONST values in MEM dimensions are valid.

@project MEM_UNDEFINED_CONST_IN_WIDTH_defined_consts_ok
    @top TopMod {
        IN  [1] clk = _;
        IN  [2] addr = _;
        IN  [8] wdata = _;
        OUT [8] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [2] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    CONST {
        WORD_W = 8;
        DEPTH = 4;
    }

    MEM {
        mem_ok [WORD_W] [DEPTH] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = mem_ok.rd[addr];
    }

    SYNCHRONOUS(CLK=clk) {
        mem_ok.wr[addr] <= wdata;
    }
@endmod
