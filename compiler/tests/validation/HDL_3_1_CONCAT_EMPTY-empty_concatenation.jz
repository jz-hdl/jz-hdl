// CONCAT_EMPTY: Empty concatenation {} is not allowed.
// Focuses on operator-category placements in async and sync blocks.
// Valid multi-piece concatenations are included to verify no false positives.

@project CONCAT_EMPTY_operator_category_empty_concat
    @top TopMod {
        IN  [1] clk = _;
        IN  [4] nibble = _;
        OUT [8] out_a = _;
        OUT [8] out_b = _;
        OUT [8] out_c = _;
    }
@endproj

// Helper module with empty concatenation triggers in expression positions
@module HelperConcat
    PORT {
        IN  [1] clk;
        IN  [4] nibble;
        OUT [8] out_a;
        OUT [8] out_b;
        OUT [8] out_c;
    }
    REGISTER {
        r [8] = 8'd0;
    }
    ASYNCHRONOUS {
        // Trigger 1: empty concatenation in async
        out_a = {};
        // Valid: multi-piece concatenation (no false positive)
        out_b = {nibble[3:0], nibble};
        out_c = r;
    }
    SYNCHRONOUS(CLK=clk) {
        // Trigger 2: empty concatenation in sync
        r <= {};
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] nibble;
        OUT [8] out_a;
        OUT [8] out_b;
        OUT [8] out_c;
    }
    WIRE {
        ha_a [8];
        ha_b [8];
        ha_c [8];
    }
    REGISTER {
        r [8] = 8'd0;
    }

    @new inst_concat HelperConcat {
        IN  [1] clk = clk;
        IN  [4] nibble = nibble;
        OUT [8] out_a = ha_a;
        OUT [8] out_b = ha_b;
        OUT [8] out_c = ha_c;
    };

    ASYNCHRONOUS {
        // Trigger 3: empty concatenation in top async
        out_a = {};
        out_b = ha_b;
        out_c = r;
    }
    SYNCHRONOUS(CLK=clk) {
        // Trigger 4: empty concatenation in top sync
        r <= {};
    }
@endmod
