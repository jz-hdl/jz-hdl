// IMPORT_FILE_MULTIPLE_TIMES: Same file imported twice using different path forms.
// Tests duplicate detection after traversal-free relative path normalization.

@project IMPORT_FILE_MULTIPLE_TIMES_case_normalized_dup

    // Valid: first import of the library file.
    @import "HDL_6_2_1_IMPORT_FILE_MULTIPLE_TIMES-happy_path_case_normalized_dup_lib.jz";

    // Trigger 1: same file imported again via a normalized current-directory path.
    @import "././HDL_6_2_1_IMPORT_FILE_MULTIPLE_TIMES-happy_path_case_normalized_dup_lib.jz";

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    @new inst_a ImportedMod {
        IN  [1] clk = clk;
        OUT [1] data = _;
    };

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
