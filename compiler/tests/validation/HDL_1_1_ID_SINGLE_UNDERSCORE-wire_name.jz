// ID_SINGLE_UNDERSCORE: Single underscore `_` used as wire name.
// Tests _ in WIRE declaration context (outside no-connect).
// Valid wire names and valid _ in @new port binding included for no false positives.

@project ID_SINGLE_UNDERSCORE_wire_name
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module HelperA
    PORT {
        IN  [1] din;
        OUT [1] data;
    }
    ASYNCHRONOUS {
        data = din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    WIRE {
        // Valid: multi-char wire name (should NOT trigger)
        valid_wire [1];
        // Trigger: _ used as wire name
        _ [1];
    }

    @new inst_a HelperA {
        IN  [1] din = clk;
        // Valid: _ as no-connect in @new port binding (should NOT trigger)
        OUT [1] data = _;
    };

    ASYNCHRONOUS {
        valid_wire = clk;
        data = valid_wire;
    }
@endmod
