// COMMENT_IN_TOKEN: Comment inside a module instance name in @new.
// Valid instance names included to verify no false positives.

@project COMMENT_IN_TOKEN_instance_name
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] result = _;
    }
@endproj

@module Helper
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }
    REGISTER {
        r [1] = 1'b0;
    }
    ASYNCHRONOUS {
        data = r;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] result;
    }
    WIRE {
        w [1];
    }

    // Trigger: instance name split by an inline block comment
    @new in/**/st Helper {
        IN  [1] clk  = clk;
        OUT [1] data = w;
    };

    ASYNCHRONOUS {
        result = w;
    }
@endmod
