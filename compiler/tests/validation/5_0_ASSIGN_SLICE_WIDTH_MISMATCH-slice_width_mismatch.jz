// ASSIGN_SLICE_WIDTH_MISMATCH: Slice assignment where source and destination
// slice widths differ. This fixture stays in ASYNCHRONOUS contexts because
// register slice mismatches in SYNCHRONOUS blocks are covered by
// SYNC_SLICE_WIDTH_MISMATCH.

@project ASSIGN_SLICE_WIDTH_MISMATCH_slice_width_mismatch
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [8] din = _;
        OUT [8] dout_a = _;
        OUT [8] dout_b = _;
    }
@endproj

// Helper module: slice width mismatches in ASYNC
@module HelperMod
    PORT {
        IN  [8] din;
        OUT [8] dout;
    }

    ASYNCHRONOUS {
        // Trigger 1: LHS slice narrower than RHS slice (4 vs 5, ASYNC helper)
        dout[7:4] <= din[4:0];
        // Trigger 2: LHS slice wider than RHS slice (4 vs 3, ASYNC helper)
        dout[3:0] <= din[2:0];
    }
@endmod

@module TopMod
    PORT {
        IN  [8] din;
        OUT [8] dout_a;
        OUT [8] dout_b;
    }

    @new inst_h HelperMod {
        IN  [8] din = din;
        OUT [8] dout = dout_a;
    };

    ASYNCHRONOUS {
        // Trigger 4: slice mismatch with receive operator (4 vs 6, ASYNC top)
        dout_b[7:4] <= din[5:0];
        // Valid: same-width slice assignment (4 = 4, no error)
        dout_b[3:0] <= din[3:0];
    }
@endmod
