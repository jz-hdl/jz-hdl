// MEM_PORT_NAME_CONFLICT_MODULE_ID: MEM port name conflicts with module-level identifier.
// Covers latch-name, mem-name, and mux-name contexts.

@project MEM_PORT_NAME_CONFLICT_MODULE_ID_latch_mem_mux_conflict
    @top TopMod {
        IN  [1] clk = _;
        IN  [4] addr = _;
        IN  [8] in0 = _;
        IN  [8] in1 = _;
        IN  [8] wdata = _;
        OUT [8] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        IN  [8] in0;
        IN  [8] in1;
        IN  [8] wdata;
        OUT [8] data;
    }

    LATCH {
        lat_q [8] D;
    }

    MUX {
        mux_q = in0, in1;
    }

    MEM {
        other_mem [8] [16] = 8'h00 {
            OUT rd_other ASYNC;
            IN  wr_other;
        };
    }

    MEM {
        mem_conflict [8] [16] = 8'h00 {
            // Trigger 1: conflicts with LATCH name.
            OUT lat_q ASYNC;
            // Trigger 2: conflicts with MEM name.
            IN  other_mem;
            // Trigger 3: conflicts with MUX name.
            OUT mux_q ASYNC;
        };
    }

    ASYNCHRONOUS {
        lat_q <= clk : in0;
        data = mem_conflict.lat_q[addr] ^ mem_conflict.mux_q[addr] ^ other_mem.rd_other[addr] ^ mux_q[0];
    }

    SYNCHRONOUS(CLK=clk) {
        mem_conflict.other_mem[addr] <= wdata;
        other_mem.wr_other[addr] <= wdata;
    }
@endmod
