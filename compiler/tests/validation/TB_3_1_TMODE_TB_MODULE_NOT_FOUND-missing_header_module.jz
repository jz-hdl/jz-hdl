// TB_MODULE_NOT_FOUND: @testbench header must name an in-scope module.
// Trigger 1: The @testbench header references a module that is not defined or imported.

@testbench MissingDut
    @import "TB_3_1_TMODE_TB_MODULE_NOT_FOUND-missing_header_module_helper_lib.jz";

    CLOCK {
        clk;
    }

    WIRE {
        rst_n [1];
        data [1];
    }

    TEST "header module must exist" {
        @new dut ImportedDut {
            clk [1] = clk;
            rst_n [1] = rst_n;
            data [1] = data;
        }

        @setup {
            rst_n <= 1'b0;
        }
    }
@endtb
