// PATH_OUTSIDE_SANDBOX: Existing file under the sandbox root is allowed.
// Covers valid @file() resolution within compiler/tests/validation.
// No diagnostics expected.

@project PATH_OUTSIDE_SANDBOX_valid_sandbox_ok
    @top TopMod {
        IN  [1] clk = _;
        IN  [2] addr = _;
        OUT [8] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [2] addr;
        OUT [8] data;
    }

    MEM {
        rom [8] [4] = @file("mem_exact_4bytes.bin") {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = rom.rd[addr];
    }

    SYNCHRONOUS(CLK=clk) {
        rom.wr[addr] <= 8'h00;
    }
@endmod
