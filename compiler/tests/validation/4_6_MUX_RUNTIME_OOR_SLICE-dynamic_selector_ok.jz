// MUX §4.6 Req #38 happy-path:
// "If <selector> may be out of range at runtime, the result is all zeros"
// (auto-slicing form).
// A dynamic selector with the exact required width is accepted even though
// some runtime values remain out of range; runtime OOR yields zero.
// This test verifies the construct compiles cleanly.
// No diagnostics expected.

@project MUX_RUNTIME_OOR_SLICE_dynamic_selector_ok
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [24] wide = _;
        IN  [2] sel = _;
        OUT [8] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [24] wide;
        IN  [2] sel;
        OUT [8] data;
    }

    // K = 24/8 = 3. Valid indices 0..2.
    MUX {
        slice_mux [8] = wide;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        // Trigger: exact-width 2-bit selector can carry values 0..3. Value 3
        // is runtime-out-of-range. Not statically provable as always OOR, so
        // compilation succeeds; runtime OOR yields zero.
        data = slice_mux[sel] | r;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger: same runtime-OOR scenario in SYNC context.
        r <= slice_mux[sel];
    }
@endmod
