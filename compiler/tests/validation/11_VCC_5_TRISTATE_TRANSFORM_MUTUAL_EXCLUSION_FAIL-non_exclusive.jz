// TRISTATE_TRANSFORM_MUTUAL_EXCLUSION_FAIL: VCC default variant.
// Verifies that non-mutually-exclusive enable conditions on multiple tri-state
// drivers emit TRISTATE_TRANSFORM_MUTUAL_EXCLUSION_FAIL under --tristate-default=VCC.
// Trigger: two instances driving same wire with same enable (non-exclusive).

@project TRISTATE_TRANSFORM_MUTUAL_EXCLUSION_FAIL_non_exclusive_vcc
    @top TopMod {
        IN  [1] en = _;
        OUT [8] data = _;
    }
@endproj

// Driver module with conditional tri-state output via INOUT
@module DriverMod
    PORT {
        IN    [1] en;
        INOUT [8] data;
    }

    ASYNCHRONOUS {
        IF (en) {
            data <= 8'hBB;
        } ELSE {
            data <= 8'bzzzz_zzzz;
        }
    }
@endmod

// Top module: two instances drive same wire with same enable (non-exclusive)
@module TopMod
    PORT {
        IN  [1] en;
        OUT [8] data;
    }

    WIRE {
        bus [8];
    }

    // Trigger: non-mutually-exclusive enables (same enable for both instances)
    @new inst_a DriverMod {
        IN    [1] en = en;
        INOUT [8] data = bus;
    };

    @new inst_b DriverMod {
        IN    [1] en = en;
        INOUT [8] data = bus;
    };

    ASYNCHRONOUS {
        data <= bus;
    }
@endmod
