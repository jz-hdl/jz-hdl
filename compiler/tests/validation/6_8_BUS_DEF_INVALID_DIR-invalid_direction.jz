// BUS_DEF_INVALID_DIR: BUS signal direction must be IN, OUT, or INOUT.
// Target diagnostic: BUS_DEF_INVALID_DIR.
// Non-target diagnostics: none; the project and top module are otherwise valid.

@project BUS_DEF_INVALID_DIR_invalid_direction
    BUS BAD_BUS {
        BIDIR [1] data;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
