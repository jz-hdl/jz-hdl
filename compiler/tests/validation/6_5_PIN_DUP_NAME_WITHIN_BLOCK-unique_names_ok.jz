// PIN_DUP_NAME_WITHIN_BLOCK: Distinct IN_PINS names compile cleanly.
// Exercises unique scalar and bus pin declarations in one IN_PINS block.

@project PIN_DUP_NAME_WITHIN_BLOCK_unique_names_ok
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        btn = { standard=LVCMOS33 };
        cfg = { standard=LVCMOS18 };
        sense_line = { standard=LVCMOS12 };
        addr_bus[4] = { standard=LVCMOS33 };
    }

    MAP {
        sys_clk = 1;
        btn = 2;
        cfg = 3;
        sense_line = 4;
        addr_bus[0] = 5;
        addr_bus[1] = 6;
        addr_bus[2] = 7;
        addr_bus[3] = 8;
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
