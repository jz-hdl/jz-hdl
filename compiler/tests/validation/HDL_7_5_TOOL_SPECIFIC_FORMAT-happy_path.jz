// HAPPY_PATH: Tool-specific file extension is accepted for MEM @file init.
// Uses an unknown extension that the compiler treats as a raw binary payload.
// No diagnostics expected.

@project HAPPY_PATH_tool_specific_format_ok
    @top TopMod {
        IN  [1] clk = _;
        IN  [2] addr = _;
        OUT [8] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [2] addr;
        OUT [8] data;
    }

    MEM {
        rom [8] [4] = @file("mem_exact_4bytes.toolbin") {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = rom.rd[addr];
    }

    SYNCHRONOUS(CLK=clk) {
        rom.wr[addr] <= 8'h00;
    }
@endmod
