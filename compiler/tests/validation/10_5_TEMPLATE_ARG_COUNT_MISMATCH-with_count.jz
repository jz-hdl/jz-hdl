// TEMPLATE_ARG_COUNT_MISMATCH: @apply with count parameter and wrong argument count.
// Tests that the compiler detects arg count mismatches even when @apply[N] is used.
// Valid @apply[N] with correct args included to verify no false positives.

@project TEMPLATE_ARG_COUNT_MISMATCH_with_count
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@template two_param(a, b)
    a <= b;
@endtemplate

@module HelperMod
    PORT {
        IN  [1] din;
        OUT [1] data;
    }

    WIRE {
        w1 [1];
    }

    ASYNCHRONOUS {
        // Valid: @apply[1] with correct arg count (no error)
        @apply[1] two_param(w1, din);
        // Trigger: @apply[N] with too few args
        @apply[3] two_param(w1);
        data = w1;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    @new inst_a HelperMod {
        IN  [1] din = r;
        OUT [1] data = _;
    };

    REGISTER {
        r [1] = 1'b0;
    }

    WIRE {
        w1 [1];
    }

    ASYNCHRONOUS {
        // Valid: @apply[1] with correct arg count (no error)
        @apply[1] two_param(w1, r);
        data = w1;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger: @apply[N] with too many args in SYNC
        @apply[2] two_param(r, clk, clk);
        r <= ~r;
    }
@endmod
