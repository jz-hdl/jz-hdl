// LIT_INVALID_CONTEXT: lit() used where a compile-time integer constant is required.
// Tests lit() in width-bracket context (WIRE declaration width).
// Valid lit() in ASYNC block included to verify no false positives.

@project LIT_INVALID_CONTEXT_width_bracket
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] data_in = _;
        OUT [8] out_a = _;
        OUT [8] out_b = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] val;
        OUT [8] out_a;
        OUT [8] out_b;
    }
    WIRE {
        // Trigger: lit() in wire width bracket
        w_bad [lit(4, 3)];
        w_good [8];
    }
    REGISTER {
        r [8] = 8'd0;
    }
    ASYNCHRONOUS {
        w_bad = val;
        w_good = val;
        out_a = w_bad;
        out_b <=z r;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= val;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] data_in;
        OUT [8] out_a;
        OUT [8] out_b;
    }
    WIRE {
        ha_a [8];
        ha_b [8];
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] val = data_in;
        OUT [8] out_a = ha_a;
        OUT [8] out_b = ha_b;
    };

    ASYNCHRONOUS {
        out_a = ha_a;
        out_b = ha_b;
    }
@endmod
