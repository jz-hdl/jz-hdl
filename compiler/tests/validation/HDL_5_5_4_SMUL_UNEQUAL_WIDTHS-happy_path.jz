// HAPPY_PATH: §5.5.4 smul(a, b) accepts operands of unequal widths.
// max_bits = MAX(width(a), width(b)); each operand is sign-extended to
// max_bits bits before multiplication. Result width is 2 * max_bits.
// Exercises Reqs #3, #4 (sign-extend a/b to max_bits) and #8 (narrower
// operand sign-extended before multiplication). No diagnostics expected.

@project SMUL_UNEQUAL_WIDTHS_ok
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1]  clk = _;
        IN  [4]  a4  = _;
        IN  [8]  b8  = _;
        IN  [3]  c3  = _;
        IN  [5]  d5  = _;
        OUT [16] prod_a4_b8 = _;
        OUT [10] prod_c3_d5 = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1]  clk;
        IN  [4]  a4;
        IN  [8]  b8;
        IN  [3]  c3;
        IN  [5]  d5;
        OUT [16] prod_a4_b8;
        OUT [10] prod_c3_d5;
    }

    REGISTER {
        r_a4b8 [16] = 16'd0;
        r_c3d5 [10] = 10'd0;
    }

    ASYNCHRONOUS {
        // smul with a narrower LHS operand: width(a4)=4, width(b8)=8.
        // max_bits = 8; a4 is sign-extended from 4 to 8 bits before
        // multiplication; result width = 2 * 8 = 16.
        prod_a4_b8 = r_a4b8;
        // smul with a narrower RHS operand: width(c3)=3, width(d5)=5.
        // max_bits = 5; c3 is sign-extended from 3 to 5 bits before
        // multiplication; result width = 2 * 5 = 10.
        prod_c3_d5 = r_c3d5;
    }

    SYNCHRONOUS(CLK=clk) {
        r_a4b8 <= smul(a4, b8);
        r_c3d5 <= smul(c3, d5);
    }
@endmod
