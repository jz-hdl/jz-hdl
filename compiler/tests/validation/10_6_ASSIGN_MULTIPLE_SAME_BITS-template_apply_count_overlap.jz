// ASSIGN_MULTIPLE_SAME_BITS: @apply with count causing overlapping wire bit assignments.
// When @apply[count] expands a template targeting the same wire without
// IDX-differentiated slicing, multiple expansions assign the same bits,
// violating exclusive assignment after expansion.
// Valid use: single @apply (no count overlap).

@project ASSIGN_MULTIPLE_SAME_BITS_template_count_overlap
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] out_a = _;
        OUT [1] out_b = _;
    }
@endproj

@template set_val(out)
    out <= VCC;
@endtemplate

@module HelperMod
    PORT {
        IN  [1] clk;
        OUT [1] out_a;
    }

    WIRE {
        w [1];
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        // Valid: single @apply, no overlap
        @apply set_val(w);
        out_a = w;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] out_a;
        OUT [1] out_b;
    }

    WIRE {
        w1 [1];
        w2 [1];
        ha [1];
    }

    REGISTER {
        r [1] = 1'b0;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        OUT [1] out_a = ha;
    };

    ASYNCHRONOUS {
        // Trigger: @apply[2] without IDX causes overlapping wire bit assignments
        @apply[2] set_val(w1);

        // Valid: single @apply, no overlap
        @apply set_val(w2);

        out_a = w1 | ha;
        out_b = w2;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
