// SELECT_DIRECTIVE_FORM: valid @select(<signal>, <color>) syntax in @simulation.

@module SelectDirectiveFormDut
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        state [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = state;
    }

    SYNCHRONOUS(CLK=clk) {
        state <= ~state;
    }
@endmod

@simulation SelectDirectiveFormDut
    CLOCK {
        clk = { period=10 };
    }

    WIRE {
        data [1];
    }

    @new dut SelectDirectiveFormDut {
        clk [1] = clk;
        data [1] = data;
    }

    @select(data, YELLOW)
    @run(ns=10)
@endsim
