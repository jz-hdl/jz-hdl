// LATCH_AS_CLOCK_OR_CDC: LATCH may not be used as a CDC clock.
// Tests latch identifier used as destination clock in a CDC block.
// Valid CDC with port clocks included to verify no false positives.

@project LATCH_AS_CLOCK_OR_CDC_latch_as_cdc_clock
    @top TopMod {
        IN  [1] clk_a = _;
        IN  [1] clk_b = _;
        IN  [1] enable = _;
        IN  [1] din = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk_a;
        IN  [1] clk_b;
        IN  [1] enable;
        IN  [1] din;
        OUT [1] data;
    }

    LATCH {
        lat_clk [1] D;
    }

    REGISTER {
        reg_b [1] = 1'b0;
        reg_c [1] = 1'b0;
    }

    CDC {
        // Trigger: latch used as destination clock
        BIT reg_b (clk_a) => sync_b (lat_clk);
        // Valid: normal port clocks (no error)
        BIT reg_c (clk_a) => sync_c (clk_b);
    }

    ASYNCHRONOUS {
        lat_clk <= enable : din;
        data <= sync_b | sync_c;
    }

    SYNCHRONOUS(CLK=clk_a) {
        reg_b <= din;
        reg_c <= din;
    }
@endmod
