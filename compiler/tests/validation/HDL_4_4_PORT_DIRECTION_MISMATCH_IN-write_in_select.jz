// PORT_DIRECTION_MISMATCH_IN: Cannot assign to IN port in SELECT branch.
// Trigger is write to IN port inside SELECT CASE. Valid reads included for no false positives.
// ASYNC_UNDEFINED_PATH_NO_DRIVER cascades because compiler tracks the invalid write as a driver.

@project PORT_DIRECTION_MISMATCH_IN_write_in_select
    @top TopMod {
        IN  [1] clk = _;
        IN  [2] sel = _;
        IN  [8] din = _;
        OUT [8] dout = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [2] sel;
        IN  [8] data_in;
        OUT [8] data_out;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data_out <= data_in;
        SELECT (sel) {
            CASE (2'b00) {
                // Trigger: write to IN port inside SELECT CASE
                data_in <= r;
            }
            DEFAULT {
            }
        }
    }

    SYNCHRONOUS(CLK=clk) {
        r <= data_in;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [2] sel;
        IN  [8] din;
        OUT [8] dout;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [2] sel = sel;
        IN  [8] data_in = din;
        OUT [8] data_out = dout;
    };

    ASYNCHRONOUS {
        dout <= r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
@endmod
