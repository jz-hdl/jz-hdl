// SELECT_DEFAULT_RECOMMENDED_ASYNC happy-path: ASYNC SELECT with DEFAULT.
// The warning fires when ASYNC SELECT omits DEFAULT; with DEFAULT present
// the rule is not triggered. Verifies no false positives across modules and
// including a nested ASYNC SELECT.

@project SELECT_DEFAULT_RECOMMENDED_ASYNC_async_with_default_ok
    @top TopMod {
        IN  [4] sel = _;
        IN  [4] sub = _;
        OUT [1] out_a = _;
        OUT [1] out_b = _;
    }
@endproj

@module HelperA
    PORT {
        IN  [4] sel;
        OUT [1] out_a;
    }
    ASYNCHRONOUS {
        // ASYNC SELECT with DEFAULT in helper.
        SELECT (sel) {
            CASE 4'h0 {
                out_a <= VCC;
            }
            CASE 4'h1 {
                out_a <= GND;
            }
            DEFAULT {
                out_a <= GND;
            }
        }
    }
@endmod

@module TopMod
    PORT {
        IN  [4] sel;
        IN  [4] sub;
        OUT [1] out_a;
        OUT [1] out_b;
    }

    @new inst_a HelperA {
        IN  [4] sel = sel;
        OUT [1] out_a = out_a;
    };

    ASYNCHRONOUS {
        // Nested ASYNC SELECT, both levels have DEFAULT.
        SELECT (sel) {
            CASE 4'h0 {
                SELECT (sub) {
                    CASE 4'h0 {
                        out_b <= VCC;
                    }
                    DEFAULT {
                        out_b <= GND;
                    }
                }
            }
            DEFAULT {
                out_b <= GND;
            }
        }
    }
@endmod
