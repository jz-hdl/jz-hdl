// CLOCK_GEN_OPTIONAL_INPUTS: optional chip-defined CLOCK_GEN inputs may be omitted.
// Exercises BUF with required REF_CLK and omitted optional CE input.

@project(CHIP="gw2ar-18-qn88-c8-i7") CLOCK_GEN_OPTIONAL_INPUTS_happy_path
    CLOCKS {
        ref_clk = { period=10 };
        buf_clk;
    }

    IN_PINS {
        ref_clk = { standard=LVCMOS33 };
    }

    MAP {
        ref_clk = 1;
    }

    CLOCK_GEN {
        BUF {
            IN REF_CLK ref_clk;
            OUT BASE buf_clk;
        };
    }

    @top TopMod {
        IN  [1] clk = buf_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
