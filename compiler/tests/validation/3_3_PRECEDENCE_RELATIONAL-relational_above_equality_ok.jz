// PRECEDENCE: §3.3 Req #8 — Relational ops `<`, `>`, `<=`, `>=` bind
// tighter than equality `==`, `!=`. `(a < b) == p` uses relational first.
// Relational ops produce 1-bit results; equality on those requires a
// 1-bit RHS to satisfy binop width rules.
// No diagnostics expected.

@project PRECEDENCE_relational_above_equality_ok
    CONFIG {
        WIDTH = 8;
    }
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] a = _;
        IN  [8] b = _;
        IN  [1] p = _;
        OUT [1] out_eq_lt = _;
        OUT [1] out_ne_gt = _;
        OUT [1] out_eq_le = _;
        OUT [1] out_ne_ge = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [8] b;
        IN  [1] p;
        OUT [1] out_eq_lt;
        OUT [1] out_ne_gt;
        OUT [1] out_eq_le;
        OUT [1] out_ne_ge;
    }
    REGISTER {
        r_eq_lt [1] = 1'b0;
        r_ne_gt [1] = 1'b0;
        r_eq_le [1] = 1'b0;
        r_ne_ge [1] = 1'b0;
    }
    ASYNCHRONOUS {
        // < binds tighter than == : (a < b) == p
        out_eq_lt = ((a < b) == p) | r_eq_lt;
        // > binds tighter than != : (a > b) != p
        out_ne_gt = ((a > b) != p) | r_ne_gt;
        // <= binds tighter than == : (a <= b) == p
        out_eq_le = ((a <= b) == p) | r_eq_le;
        // >= binds tighter than != : (a >= b) != p
        out_ne_ge = ((a >= b) != p) | r_ne_ge;
    }
    SYNCHRONOUS(CLK=clk) {
        r_eq_lt <= (a < b) == p;
        r_ne_gt <= (a > b) != p;
        r_eq_le <= (a <= b) == p;
        r_ne_ge <= (a >= b) != p;
    }
@endmod
