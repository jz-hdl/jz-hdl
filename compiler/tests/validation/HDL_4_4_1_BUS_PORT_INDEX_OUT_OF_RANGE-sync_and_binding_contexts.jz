// BUS_PORT_INDEX_OUT_OF_RANGE: out-of-range arrayed BUS index in SYNCHRONOUS
// block RHS expressions and in @new port-binding expressions. Extends the
// ASYNC-only coverage of bus_index_bounds for Reqs #13, #18, #20, #39, #40.

@project BUS_PORT_INDEX_OUT_OF_RANGE_sync_and_binding_contexts
    BUS MY_BUS {
        OUT [8] tx;
        IN  [8] rx;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [8] din = _;
        OUT [8] dout_a = _;
        OUT [8] dout_b = _;
        OUT [8] dout_c = _;
    }
@endproj

// Module: out-of-range index in SYNCHRONOUS RHS, SOURCE role (reads rx)
@module SyncSrcMod
    PORT {
        IN  [1] clk;
        BUS MY_BUS SOURCE [2] sbus;
        OUT [8] data_out;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        sbus[0].tx <= 8'h00;
        sbus[1].tx <= 8'h00;
        data_out <= r;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger 1: SYNC RHS uses out-of-range index (count=2, valid 0..1)
        r <= sbus[5].rx;
    }
@endmod

// Module: out-of-range index in SYNCHRONOUS RHS, TARGET role (reads tx)
@module SyncTgtMod
    PORT {
        IN  [1] clk;
        IN  [8] din;
        BUS MY_BUS TARGET [2] tbus;
        OUT [8] data_out;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        tbus[0].rx <= 8'h00;
        tbus[1].rx <= 8'h00;
        data_out <= r;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger 2: SYNC RHS uses out-of-range index (count=2, valid 0..1)
        r <= tbus[7].tx ^ din;
    }
@endmod

// Leaf module consuming a narrow port value; its din will be driven from an
// out-of-range BUS index via a @new binding expression in a parent module.
@module Consumer
    PORT {
        IN  [1] clk;
        IN  [8] din;
        OUT [8] data_out;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data_out <= r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
@endmod

// Intermediate module that owns an arrayed BUS TARGET port so we can reference
// an out-of-range index in a @new binding expression.
@module BindingMod
    PORT {
        IN  [1] clk;
        BUS MY_BUS TARGET [2] tbus;
        OUT [8] data_out;
    }

    ASYNCHRONOUS {
        tbus[0].rx <= 8'h00;
        tbus[1].rx <= 8'h00;
    }

    // Trigger 3: @new binding expression uses an out-of-range BUS index
    // on this module's arrayed TARGET bus (count=2, valid 0..1).
    @new inst_c Consumer {
        IN  [1] clk = clk;
        IN  [8] din = tbus[9].tx;
        OUT [8] data_out = data_out;
    };
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] din;
        OUT [8] dout_a;
        OUT [8] dout_b;
        OUT [8] dout_c;
    }

    @new inst_s SyncSrcMod {
        IN  [1] clk = clk;
        BUS MY_BUS SOURCE [2] sbus = _;
        OUT [8] data_out = dout_a;
    };

    @new inst_t SyncTgtMod {
        IN  [1] clk = clk;
        IN  [8] din = din;
        BUS MY_BUS TARGET [2] tbus = _;
        OUT [8] data_out = dout_b;
    };

    @new inst_b BindingMod {
        IN  [1] clk = clk;
        BUS MY_BUS TARGET [2] tbus = _;
        OUT [8] data_out = dout_c;
    };

    ASYNCHRONOUS {
    }
@endmod
