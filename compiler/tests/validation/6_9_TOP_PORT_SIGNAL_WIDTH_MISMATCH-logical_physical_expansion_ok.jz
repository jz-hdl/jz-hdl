// TOP_PORT_SIGNAL_WIDTH_MISMATCH: matching logical widths bind cleanly in @top.
// Exercises single-ended and differential pins where logical width matches the
// bound top-module port width. No diagnostics expected.

@project(CHIP="XC7A35T-2FGG484") TOP_PORT_SIGNAL_WIDTH_MISMATCH_logical_physical_expansion_ok
    CLOCKS {
        sys_clk = { period=10.0 };
        serial_clk = { period=2.5 };
        parallel_clk = { period=10.0 };
        reset_n = { period=10.0 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        serial_clk = { standard=LVCMOS33 };
        parallel_clk = { standard=LVCMOS33 };
        reset_n = { standard=LVCMOS33 };
        btn[2] = { standard=LVCMOS33 };
        diff_rx = { mode=DIFFERENTIAL, standard=LVDS25, width=4, fclk=serial_clk, pclk=parallel_clk, reset=reset_n };
    }

    OUT_PINS {
        led[2] = { standard=LVCMOS33, drive=8 };
        diff_tx = { mode=DIFFERENTIAL, standard=LVDS25, drive=8, width=4, fclk=serial_clk, pclk=parallel_clk, reset=reset_n };
    }

    INOUT_PINS {
        diff_io = { mode=DIFFERENTIAL, standard=LVDS25, drive=8, width=4, fclk=serial_clk, pclk=parallel_clk, reset=reset_n };
    }

    MAP {
        sys_clk = "E3";
        serial_clk = "F3";
        parallel_clk = "G3";
        reset_n = "H3";
        btn[0] = "J1";
        btn[1] = "J2";
        led[0] = "K1";
        led[1] = "K2";
        diff_rx = { P="A1", N="A2" };
        diff_tx = { P="B1", N="B2" };
        diff_io = { P="C1", N="C2" };
    }

    @top TopMod {
        IN    [1] clk      = sys_clk;
        IN    [2] buttons  = btn;
        IN    [4] rx_data  = diff_rx;
        OUT   [2] leds     = led;
        OUT   [4] tx_data  = diff_tx;
        INOUT [4] io_data  = diff_io;
    }
@endproj

@module Helper
    PORT {
        IN  [1] clk;
        IN  [2] buttons;
        IN  [4] rx_data;
        OUT [4] helper_data;
    }

    REGISTER {
        latched [4] = 4'b0000;
    }

    ASYNCHRONOUS {
        helper_data = latched;
    }

    SYNCHRONOUS(CLK=clk) {
        latched <= { rx_data[3:2], buttons };
    }
@endmod

@module TopMod
    PORT {
        IN    [1] clk;
        IN    [2] buttons;
        IN    [4] rx_data;
        OUT   [2] leds;
        OUT   [4] tx_data;
        INOUT [4] io_data;
    }

    @new helper_inst Helper {
        IN  [1] clk = clk;
        IN  [2] buttons = buttons;
        IN  [4] rx_data = rx_data;
        OUT [4] helper_data = _;
    };

    REGISTER {
        phase [1] = 1'b0;
        tx_reg [4] = 4'b0000;
        io_reg [4] = 4'b0000;
    }

    ASYNCHRONOUS {
        leds = buttons;
        tx_data = tx_reg;
        IF (phase) {
            io_data <= io_reg;
        } ELSE {
            io_data <= 4'bzzzz;
        }
    }

    SYNCHRONOUS(CLK=clk) {
        phase <= ~phase;
        tx_reg <= rx_data;
        io_reg <= { buttons, rx_data[1:0] };
    }
@endmod
