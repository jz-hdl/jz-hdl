// PIN_INVALID_STANDARD: Invalid electrical standard in INOUT_PINS bus declaration.
// Valid INOUT_PINS bus declarations are included to verify no false positives.

@project PIN_INVALID_STANDARD_inout_bus_bad_standard
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
    }

    INOUT_PINS {
        // Valid: recognized standard on INOUT_PINS bus (no trigger)
        ok_bus[2] = { standard=LVCMOS18, drive=4 };
        // Trigger 1: invalid standard on INOUT_PINS bus
        bad_bus[2] = { standard=BADSTD, drive=8 };
    }

    MAP {
        sys_clk = 1;
        ok_bus[0] = 2;
        ok_bus[1] = 3;
        bad_bus[0] = 4;
        bad_bus[1] = 5;
    }

    @top TopMod {
        IN    [1] clk = sys_clk;
        INOUT [2] valid_pad = ok_bus;
        INOUT [2] invalid_pad = bad_bus;
        OUT   [1] done = _;
    }
@endproj

@module TopMod
    PORT {
        IN    [1] clk;
        INOUT [2] valid_pad;
        INOUT [2] invalid_pad;
        OUT   [1] done;
    }

    REGISTER {
        state [2] = 2'b00;
    }

    ASYNCHRONOUS {
        IF (state == 2'b00) {
            valid_pad <= 2'b01;
            invalid_pad <= 2'b10;
        } ELSE {
            valid_pad <= 2'bzz;
            invalid_pad <= 2'bzz;
        }
        done = valid_pad[0];
    }

    SYNCHRONOUS(CLK=clk) {
        state <= state + 2'b01;
    }
@endmod
