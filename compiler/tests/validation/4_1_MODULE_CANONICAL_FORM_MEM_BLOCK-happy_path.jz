// MODULE_CANONICAL_FORM: Happy path for §4.1 Reqs #20-25 — MEM block canonical form.
// Exercises all MEM syntax elements:
//   #20: MEM(type=[BLOCK|DISTRIBUTED]) {
//   #21: <mem_id> [<word_width>] [<depth>] = <init> {
//   #22: OUT <port_id> [ASYNC | SYNC];
//   #23: IN  <port_id> { WRITE_MODE = <mode>; };
//   #24: };  (end of mem declaration)
//   #25: }   (end of MEM block)

@project MODULE_CANONICAL_FORM_mem_block_ok
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [4] addr = _;
        IN  [8] wdata = _;
        OUT [8] rdata = _;
    }
@endproj

// Helper: DISTRIBUTED type MEM with ASYNC read port
@module DistMem
    PORT {
        IN  [4] addr;
        OUT [8] rdata;
    }

    // Req #20: MEM(type=DISTRIBUTED) {
    MEM(type=DISTRIBUTED) {
        // Req #21: <mem_id> [<word_width>] [<depth>] = <init> {
        mem_d [8] [16] = 8'h00 {
            // Req #22: OUT <port_id> ASYNC
            OUT rd ASYNC;
        };  // Req #24: };
    }  // Req #25: }

    ASYNCHRONOUS {
        rdata = mem_d.rd[addr];
    }
@endmod

// Top: BLOCK type MEM with SYNC OUT and IN with explicit WRITE_MODE
@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] rdata;
    }

    // Req #20: MEM(type=BLOCK) {
    MEM(type=BLOCK) {
        // Req #21: mem_id with word_width, depth, init
        mem_b [8] [16] = 8'h00 {
            // Req #22: OUT port with SYNC mode
            OUT rd_sync SYNC;
            // Req #23: IN port with WRITE_MODE attribute block
            IN  wr_b { WRITE_MODE = READ_FIRST; };
        };  // Req #24
    }  // Req #25

    @new inst_d DistMem {
        IN  [4] addr = addr;
        OUT [8] rdata = _;
    };

    REGISTER {
        r_rdata [8] = 8'h00;
    }

    ASYNCHRONOUS {
        rdata = r_rdata;
    }

    SYNCHRONOUS(CLK=clk) {
        mem_b.rd_sync.addr <= addr;
        r_rdata <= mem_b.rd_sync.data;
        mem_b.wr_b[addr] <= wdata;
    }
@endmod
