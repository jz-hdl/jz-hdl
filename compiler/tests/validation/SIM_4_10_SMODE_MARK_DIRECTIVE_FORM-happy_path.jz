// MARK_DIRECTIVE_FORM: valid @mark(<color>) syntax in @simulation.

@module MarkDirectiveFormDut
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        state [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = state;
    }

    SYNCHRONOUS(CLK=clk) {
        state <= ~state;
    }
@endmod

@simulation MarkDirectiveFormDut
    CLOCK {
        clk = { period=10 };
    }

    WIRE {
        data [1];
    }

    @new dut MarkDirectiveFormDut {
        clk [1] = clk;
        data [1] = data;
    }

    @mark(GREEN)
    @run(ns=10)
@endsim
