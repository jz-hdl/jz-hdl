// EXAMPLES: §10.7 example expansion remains subject to normal exclusive
// assignment analysis. The CLAMP example expands into conditional register
// assignments, which must still conflict with a root-level assignment.

@project EXAMPLES_clamp_expansion_exclusive_assignment
    CONFIG {
        WIDTH = 16;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [16] in_val = _;
        OUT [16] data = _;
    }
@endproj

@template CLAMP(val, lo, hi, out)
    IF (val < lo) {
        out <= lo;
    } ELIF (val > hi) {
        out <= hi;
    } ELSE {
        out <= val;
    }
@endtemplate

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [16] in_val;
        OUT [16] data;
    }

    REGISTER {
        counter [16] = 16'h0000;
        limited [16] = 16'h0000;
    }

    ASYNCHRONOUS {
        data = limited;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger 1: root assignment plus expanded CLAMP assignments to counter.
        counter <= in_val;
        @apply CLAMP(counter, 16'h0004, 16'h0FFF, counter);

        // Valid: the example form by itself remains legal.
        @apply CLAMP(in_val, 16'h0004, 16'h0FFF, limited);
    }
@endmod
