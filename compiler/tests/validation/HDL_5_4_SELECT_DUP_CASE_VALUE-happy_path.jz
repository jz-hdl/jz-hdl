// SELECT_DUP_CASE_VALUE happy-path: unique CASE values across ASYNC and SYNC SELECT.
// Verifies no false-positive duplicate diagnostics for valid SELECTs with
// distinct literal values, @global values, and fall-through labels.

@global OPCODES
    NOP = 4'h0;
    ADD = 4'h1;
    SUB = 4'h2;
@endglob

@project SELECT_DUP_CASE_VALUE_unique_case_values_ok
    @top TopMod {
        IN  [1] clk = _;
        IN  [4] sel = _;
        OUT [1] out_a = _;
        OUT [1] out_b = _;
    }
@endproj

@module HelperA
    PORT {
        IN  [4] sel;
        OUT [1] out_a;
    }
    ASYNCHRONOUS {
        // Unique CASE values in ASYNC; includes fall-through with distinct labels.
        SELECT (sel) {
            CASE 4'h0
            CASE 4'h1 {
                out_a <= VCC;
            }
            CASE 4'h2 {
                out_a <= GND;
            }
            DEFAULT {
                out_a <= GND;
            }
        }
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] sel;
        OUT [1] out_a;
        OUT [1] out_b;
    }

    @new inst_a HelperA {
        IN  [4] sel = sel;
        OUT [1] out_a = out_a;
    };

    REGISTER {
        r [1] = 1'b0;
    }
    ASYNCHRONOUS {
        out_b <= r;
    }
    SYNCHRONOUS(CLK=clk) {
        // Unique @global CASE values in SYNC SELECT.
        SELECT (sel) {
            CASE OPCODES.NOP {
                r <= GND;
            }
            CASE OPCODES.ADD {
                r <= VCC;
            }
            CASE OPCODES.SUB {
                r <= GND;
            }
            DEFAULT {
                r <= GND;
            }
        }
    }
@endmod
