// BUS_SIGNAL_READ_FROM_WRITABLE: Reading a writable BUS signal on the RHS in
// a SYNCHRONOUS block expression. Extends ASYNC-only coverage for Reqs #10, #36.
// (A @new binding trigger is not included: the compiler currently does not
// apply this check in new-binding expression context — logged separately.)

@project BUS_SIGNAL_READ_FROM_WRITABLE_sync_and_binding_contexts
    BUS MY_BUS {
        OUT [8] tx;  // writable in SOURCE role
        IN  [8] rx;  // writable in TARGET role
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [8] dout_a = _;
        OUT [8] dout_b = _;
    }
@endproj

// Module reading a writable BUS signal in SYNCHRONOUS RHS
@module SyncReadMod
    PORT {
        IN  [1] clk;
        BUS MY_BUS SOURCE sbus;
        OUT [8] data_out;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        sbus.tx <= r;
        data_out <= r;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger 1: SYNC RHS reads sbus.tx (writable from SOURCE) — forbidden
        r <= sbus.tx;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [8] dout_a;
        OUT [8] dout_b;
    }

    REGISTER {
        scratch [8] = 8'h00;
    }

    @new inst_s SyncReadMod {
        IN  [1] clk = clk;
        BUS MY_BUS SOURCE sbus = _;
        OUT [8] data_out = dout_a;
    };

    ASYNCHRONOUS {
        dout_b <= scratch;
    }

    SYNCHRONOUS(CLK=clk) {
        scratch <= scratch + 8'h1;
    }
@endmod
