// HAPPY_PATH: SYNC OUT .data is readable in ASYNCHRONOUS and SYNCHRONOUS blocks.
// Historical regression fixture retained at the same path.

@project HAPPY_PATH_sync_data_in_async
    @top TopMod {
        IN  [1] clk = _;
        IN  [4] addr = _;
        OUT [8] data = _;
    }
@endproj

// Helper: consume the same SYNC read port from both runtime contexts.
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM {
        mem_a [8] [16] = 8'h00 {
            OUT rd SYNC;
        };
    }

    SYNCHRONOUS(CLK=clk) {
        mem_a.rd.addr <= addr;
        r <= mem_a.rd.data;
    }

    ASYNCHRONOUS {
        data = mem_a.rd.data ^ r;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM {
        mem_b [8] [16] = 8'h00 {
            OUT rd SYNC;
        };
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [4] addr = addr;
        OUT [8] data = _;
    };

    SYNCHRONOUS(CLK=clk) {
        mem_b.rd.addr <= addr;
        r <= mem_b.rd.data;
    }

    ASYNCHRONOUS {
        data = mem_b.rd.data ^ inst_h.data ^ r;
    }
@endmod
