// TRACE_TOGGLE_MULTIPLE_TIMES: valid repeated @trace toggles in @simulation.

@module TraceToggleMultipleTimesDut
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        state [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = state;
    }

    SYNCHRONOUS(CLK=clk) {
        state <= ~state;
    }
@endmod

@simulation TraceToggleMultipleTimesDut
    CLOCK {
        clk = { period=10 };
    }

    WIRE {
        data [1];
    }

    @new dut TraceToggleMultipleTimesDut {
        clk [1] = clk;
        data [1] = data;
    }

    @trace(state=off)
    @run(ns=10)

    @trace(state=on)
    @run(ns=10)

    @trace(state=off)
    @run(ns=10)

    @trace(state=on)
    @run(ns=10)
@endsim
