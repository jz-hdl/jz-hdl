// ID_SYNTAX_INVALID: Leading-digit violation in module-name context.
// A module name starting with a digit; the lexer produces a number token
// instead of an identifier, causing a PARSE000 parser error.

@project ID_SYNTAX_INVALID_invalid_chars_module
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

// Trigger: leading digit in module-name
@module 1Foo
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }
    ASYNCHRONOUS {
        data = clk;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }
    ASYNCHRONOUS {
        data = clk;
    }
@endmod
