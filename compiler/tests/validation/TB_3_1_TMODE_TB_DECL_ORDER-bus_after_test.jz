// TB_DECL_ORDER: BUS definitions inside @testbench must appear before CLOCK/WIRE/TEST.
// Trigger 1: BUS appears after a TEST block.

@module DeclOrderBusDut
    PORT {
        IN  [1] clk;
        OUT [1] out;
    }

    ASYNCHRONOUS {
        out <= clk;
    }
@endmod

@testbench DeclOrderBusDut
    CLOCK {
        clk;
    }

    WIRE {
        out [1];
    }

    TEST "late bus is rejected" {
        @new dut DeclOrderBusDut {
            clk [1] = clk;
            out [1] = out;
        }

        @setup {
        }
    }

    // Trigger 1: BUS after TEST is not allowed.
    BUS LATE_BUS {
        OUT [1] bit;
    }
@endtb
