// PIN_DIFF_FCLK_INVALID: Differential pin fclk must reference CLOCKS or CLOCK_GEN output.
// Tests invalid fclk reference on a differential output pin.

@project(CHIP="XC7A35T-2FGG484") PIN_DIFF_FCLK_INVALID_bad_fclk
    CLOCKS {
        sys_clk = { period=10.0 };
        serial_clk = { period=2.5 };
        parallel_clk = { period=10.0 };
        reset_n = { period=10.0 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        serial_clk = { standard=LVCMOS33 };
        parallel_clk = { standard=LVCMOS33 };
        reset_n = { standard=LVCMOS33 };
    }

    OUT_PINS {
        valid_tx = { mode=DIFFERENTIAL, standard=LVDS25, drive=8, width=4, fclk=serial_clk, pclk=parallel_clk, reset=reset_n };
        bad_fclk = { mode=DIFFERENTIAL, standard=LVDS25, drive=8, width=4, fclk=no_such_clk, pclk=parallel_clk, reset=reset_n };
    }

    MAP {
        sys_clk = "E3";
        serial_clk = "F3";
        parallel_clk = "G3";
        reset_n = "H3";
        valid_tx = { P="A1", N="A2" };
        bad_fclk = { P="B1", N="B2" };
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        OUT [4] tx  = bad_fclk;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [4] tx;
    }

    REGISTER {
        r [4] = 4'b0000;
    }

    ASYNCHRONOUS {
        tx = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= r + 4'b0001;
    }
@endmod
