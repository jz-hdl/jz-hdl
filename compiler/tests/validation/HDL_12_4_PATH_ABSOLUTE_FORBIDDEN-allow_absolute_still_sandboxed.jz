// PATH_ABSOLUTE_FORBIDDEN: --allow-absolute-paths disables only the absolute-path check.
// The validation runner enables absolute paths for this file so the sandbox
// check still rejects an absolute path outside compiler/tests/validation.

@project PATH_ABSOLUTE_FORBIDDEN_allow_absolute_still_sandboxed

    // Trigger 1: absolute path remains subject to sandbox validation.
    @import "__JZ_COMPILER_TESTS_DIR__/path_security_escape_target.jz";

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
