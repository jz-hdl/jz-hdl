// RPT_EXPANDED_SIZE_LIMIT_EXCEEDED: @repeat expansion exceeds the configured
// expanded-size limit.
// Trigger: 1024 iterations of a large comment body exceed the default
// 1048576-byte expanded-size ceiling.

@project RPT_EXPANDED_SIZE_LIMIT_EXCEEDED_expanded_size_limit
    @top TopMod {
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        OUT [1] data;
    }

    ASYNCHRONOUS {
        @repeat 1024
            // 
            // 
        @end
        data <= 1'b0;
    }
@endmod
