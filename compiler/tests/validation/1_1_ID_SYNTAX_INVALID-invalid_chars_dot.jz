// ID_SYNTAX_INVALID: Dot in identifier violates the regex
// ^[A-Za-z_][A-Za-z0-9_]{0,254}$.
// The lexer emits '.' as JZ_TOK_DOT, so "foo.bar" becomes three tokens:
// identifier "foo", dot, identifier "bar". The parser rejects the
// unexpected dot as a syntax error.
// This file tests the WIRE declaration context.

@project ID_SYNTAX_INVALID_invalid_chars_dot
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    // Trigger: dot in identifier
    WIRE {
        foo.bar [1];
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
