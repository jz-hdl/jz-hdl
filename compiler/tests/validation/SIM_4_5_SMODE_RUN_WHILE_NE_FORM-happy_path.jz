// RUN_WHILE_NE_FORM: valid simulation @run_while(signal != value, timeout=unit=amount)
// syntax advances while the inequality condition remains true.

@module RunWhileNeFormDut
    PORT {
        IN  [1] clk;
        IN  [1] rst_n;
        OUT [8] count;
    }

    REGISTER {
        state [8] = 8'h00;
    }

    ASYNCHRONOUS {
        count = state;
    }

    SYNCHRONOUS(CLK=clk RESET=rst_n RESET_ACTIVE=Low) {
        state <= state + 8'h01;
    }
@endmod

@simulation RunWhileNeFormDut
    CLOCK {
        clk = { period=10 };
    }

    WIRE {
        rst_n [1];
        count [8];
    }

    @new dut RunWhileNeFormDut {
        clk [1] = clk;
        rst_n [1] = rst_n;
        count [8] = count;
    }

    @setup {
        rst_n <= 1'b0;
    }

    @run(ns=20)

    @update {
        rst_n <= 1'b1;
    }

    @run_while(count != 8'h0A, timeout=ns=1000)
@endsim
