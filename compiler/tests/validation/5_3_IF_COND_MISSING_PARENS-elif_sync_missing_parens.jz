// IF_COND_MISSING_PARENS: ELIF condition missing required parentheses in SYNC.
// Parser aborts after first parse error, so only one trigger per file.
// Tests ELIF without parens in SYNCHRONOUS block.

@project IF_COND_MISSING_PARENS_elif_sync_missing_parens
    @top TopMod {
        IN  [1] clk = _;
        IN  [1] sel = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] sel;
        OUT [1] data;
    }
    REGISTER {
        r [1] = 1'b0;
    }
    ASYNCHRONOUS {
        data = r;
    }
    SYNCHRONOUS(CLK=clk) {
        IF (sel) {
            r <= VCC;
        // Trigger: ELIF in SYNC
        } ELIF sel {
            r <= GND;
        } ELSE {
            r <= r;
        }
    }
@endmod
