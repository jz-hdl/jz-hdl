// SPECIAL_DRIVER_SLICED: GND/VCC sliced within MUX selection context.
// Tests slicing GND/VCC directly where a MUX is also used.
// Valid standalone GND/VCC usage included to verify no false positives.

@project SPECIAL_DRIVER_SLICED_mux_block
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] a = _;
        IN  [8] b = _;
        IN  [1] sel = _;
        OUT [8] out_a = _;
        OUT [1] out_b = _;
    }
@endproj

// Helper: GND/VCC sliced alongside MUX reads
@module HelperA
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [8] b;
        IN  [1] sel;
        OUT [8] out_a;
        OUT [1] out_b;
    }

    MUX {
        m = a, b;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        // Valid: MUX read as standalone RHS (no false positive)
        out_a = m[sel] | r;
        // Trigger: GND sliced with range in MUX context (async)
        out_b = GND[0];
    }

    SYNCHRONOUS(CLK=clk) {
        r <= m[sel];
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [8] b;
        IN  [1] sel;
        OUT [8] out_a;
        OUT [1] out_b;
    }

    WIRE {
        ha_out_a [8];
        ha_out_b [1];
    }

    MUX {
        top_m = a, b;
    }

    @new inst_a HelperA {
        IN  [1] clk = clk;
        IN  [8] a = a;
        IN  [8] b = b;
        IN  [1] sel = sel;
        OUT [8] out_a = ha_out_a;
        OUT [1] out_b = ha_out_b;
    };

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        // Valid: standalone assignment (no false positive)
        out_a = ha_out_a | r;
        // Trigger: VCC single-bit index in MUX context (async, top module)
        out_b = VCC[0];
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger: GND sliced with range in MUX context (sync, top module)
        r <= GND[7:0];
    }
@endmod
