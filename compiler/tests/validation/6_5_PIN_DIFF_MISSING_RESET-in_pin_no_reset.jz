// PIN_DIFF_MISSING_RESET: Differential input pin missing required reset attribute.
// Tests deserializer-side reset requirement for IN_PINS.

@project(CHIP="XC7A35T-2FGG484") PIN_DIFF_MISSING_RESET_in_pin_no_reset
    CLOCKS {
        sys_clk = { period=10.0 };
        serial_clk = { period=2.5 };
        parallel_clk = { period=10.0 };
        reset_n = { period=10.0 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        serial_clk = { standard=LVCMOS33 };
        parallel_clk = { standard=LVCMOS33 };
        reset_n = { standard=LVCMOS33 };
        valid_rx = { mode=DIFFERENTIAL, standard=LVDS25, width=4, fclk=serial_clk, pclk=parallel_clk, reset=reset_n };
        bad_rx = { mode=DIFFERENTIAL, standard=LVDS25, width=4, fclk=serial_clk, pclk=parallel_clk };
    }

    MAP {
        sys_clk = "E3";
        serial_clk = "F3";
        parallel_clk = "G3";
        reset_n = "H3";
        valid_rx = { P="A1", N="A2" };
        bad_rx = { P="B1", N="B2" };
    }

    @top TopMod {
        IN  [1] clk = sys_clk;
        IN  [4] rx  = bad_rx;
        OUT [4] tx  = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] rx;
        OUT [4] tx;
    }

    REGISTER {
        r [4] = 4'b0000;
    }

    ASYNCHRONOUS {
        tx = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= rx;
    }
@endmod
