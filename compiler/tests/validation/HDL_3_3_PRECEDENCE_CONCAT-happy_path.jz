// PRECEDENCE: §3.3 Req #2 — Concatenation `{ }` is a primary expression
// and binds tighter than any binary operator (OR, AND, shift, etc.).
// `{a, b} | c` parses as `({a, b}) | c`, not `{a, (b | c)}`.
// No diagnostics expected.

@project PRECEDENCE_concat_binds_tight_ok
    CONFIG {
        WIDTH = 8;
    }
    @top TopMod {
        IN  [1] clk = _;
        IN  [4] a = _;
        IN  [4] b = _;
        IN  [8] c = _;
        IN  [1] sel = _;
        OUT [8] out_or = _;
        OUT [8] out_and = _;
        OUT [8] out_sel = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] a;
        IN  [4] b;
        IN  [8] c;
        IN  [1] sel;
        OUT [8] out_or;
        OUT [8] out_and;
        OUT [8] out_sel;
    }
    REGISTER {
        r_or  [8] = 8'h00;
        r_and [8] = 8'h00;
        r_sel [8] = 8'h00;
    }
    ASYNCHRONOUS {
        // Concatenation binds tight: {a, b} then | c
        out_or  = {a, b} | c | r_or;
        // Concatenation binds tight: {a, b} then & c
        out_and = {a, b} & c | r_and;
        // Ternary with concat branches — concat binds before ternary
        out_sel = (sel ? {a, b} : {b, a}) | r_sel;
    }
    SYNCHRONOUS(CLK=clk) {
        r_or  <= {a, b} | c;
        r_and <= {a, b} & c;
        r_sel <= sel ? {a, b} : {b, a};
    }
@endmod
