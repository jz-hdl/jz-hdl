// COMMENT_IN_TOKEN: Comment inside a module name.
// Valid module names included to verify no false positives.

@project COMMENT_IN_TOKEN_module_name
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] result = _;
    }
@endproj

// Trigger: module name
@module Help/**/er
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }
    REGISTER {
        r [1] = 1'b0;
    }
    ASYNCHRONOUS {
        data = r;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] result;
    }
    WIRE {
        w [1];
    }

    @new inst_h Helper {
        IN  [1] clk = clk;
        OUT [1] data = w;
    };

    ASYNCHRONOUS {
        result = w;
    }
@endmod
