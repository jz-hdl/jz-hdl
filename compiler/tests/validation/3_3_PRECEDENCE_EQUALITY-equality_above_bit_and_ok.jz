// PRECEDENCE: §3.3 Req #9 — Equality ops `==`, `!=` bind tighter than
// bitwise AND `&`. `(a == b) & p` computes equality first, then ANDs
// with the 1-bit mask. Both sides of `&` are 1-bit so no width mismatch.
// No diagnostics expected.

@project PRECEDENCE_equality_above_bit_and_ok
    CONFIG {
        WIDTH = 8;
    }
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] a = _;
        IN  [8] b = _;
        IN  [1] p = _;
        IN  [1] q = _;
        OUT [1] out_eq_and = _;
        OUT [1] out_ne_and = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [8] b;
        IN  [1] p;
        IN  [1] q;
        OUT [1] out_eq_and;
        OUT [1] out_ne_and;
    }
    REGISTER {
        r_eq_and [1] = 1'b0;
        r_ne_and [1] = 1'b0;
    }
    ASYNCHRONOUS {
        // == binds tighter than & : (a == b) & p
        out_eq_and = ((a == b) & p) | r_eq_and;
        // != binds tighter than & : (a != b) & q
        out_ne_and = ((a != b) & q) | r_ne_and;
    }
    SYNCHRONOUS(CLK=clk) {
        r_eq_and <= (a == b) & p;
        r_ne_and <= (a != b) & q;
    }
@endmod
