// CLOCK_GEN_DERIVED_OUT_OF_RANGE: valid CLOCK_GEN derived value remains within
// chip-defined min/max bounds.
// Exercises a PLL configuration whose derived FVCO stays inside the legal range.

@project(CHIP="gw2ar-18-qn88-c8-i7") CLOCK_GEN_DERIVED_OUT_OF_RANGE_happy_path
    CLOCKS {
        ref_clk = { period=10 };
        pll_clk;
    }

    IN_PINS {
        ref_clk = { standard=LVCMOS33 };
    }

    MAP {
        ref_clk = 1;
    }

    CLOCK_GEN {
        PLL {
            IN REF_CLK ref_clk;
            OUT BASE pll_clk;

            CONFIG {
                // FVCO = (1000/10) * (3+1) * 2 / (0+1) = 800 MHz,
                // which satisfies both the derived min (500) and max (1250).
                IDIV = 0;
                FBDIV = 3;
                ODIV = 2;
            };
        };
    }

    @top TopMod {
        IN  [1] clk = pll_clk;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
