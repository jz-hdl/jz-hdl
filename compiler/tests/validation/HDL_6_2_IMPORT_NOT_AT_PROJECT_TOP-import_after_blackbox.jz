// IMPORT_NOT_AT_PROJECT_TOP: @import appears after @blackbox declaration.
// Tests @import placed after a @blackbox block inside @project.

@project IMPORT_NOT_AT_PROJECT_TOP_import_after_blackbox

    CONFIG {
        WIDTH = 8;
    }

    @blackbox SomeIp {
        PORT {
            IN  [1] clk;
            OUT [1] data;
        }
    }

    // Trigger: @import after @blackbox declaration (must come before @blackbox)
    @import "HDL_6_2_IMPORT_NOT_AT_PROJECT_TOP-happy_path_import_after_blackbox_lib.jz";

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    @new inst_bb SomeIp {
        IN  [1] clk = clk;
        OUT [1] data = _;
    };

    REGISTER {
        r [1] = 1'b0;
    }
    ASYNCHRONOUS {
        data = r;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
