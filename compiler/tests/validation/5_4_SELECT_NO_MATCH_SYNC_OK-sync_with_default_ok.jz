// SELECT_NO_MATCH_SYNC_OK happy-path: SYNC SELECT with DEFAULT present.
// The rule is a warning for SYNC SELECT without DEFAULT; with DEFAULT the
// diagnostic is not emitted. Verifies no false positives across modules and
// including a nested SELECT.

@project SELECT_NO_MATCH_SYNC_OK_sync_with_default_ok
    @top TopMod {
        IN  [1] clk = _;
        IN  [4] sel = _;
        IN  [4] sub = _;
        OUT [1] out_a = _;
        OUT [1] out_b = _;
    }
@endproj

@module HelperA
    PORT {
        IN  [1] clk;
        IN  [4] sel;
        OUT [1] out_a;
    }
    REGISTER {
        r [1] = 1'b0;
    }
    ASYNCHRONOUS {
        out_a <= r;
    }
    SYNCHRONOUS(CLK=clk) {
        // SYNC SELECT with DEFAULT in helper.
        SELECT (sel) {
            CASE 4'h0 {
                r <= VCC;
            }
            CASE 4'h1 {
                r <= GND;
            }
            DEFAULT {
                r <= r;
            }
        }
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] sel;
        IN  [4] sub;
        OUT [1] out_a;
        OUT [1] out_b;
    }

    @new inst_a HelperA {
        IN  [1] clk = clk;
        IN  [4] sel = sel;
        OUT [1] out_a = out_a;
    };

    REGISTER {
        s [1] = 1'b0;
    }
    ASYNCHRONOUS {
        out_b <= s;
    }
    SYNCHRONOUS(CLK=clk) {
        // Nested SYNC SELECT, both levels have DEFAULT.
        SELECT (sel) {
            CASE 4'h0 {
                SELECT (sub) {
                    CASE 4'h0 {
                        s <= VCC;
                    }
                    DEFAULT {
                        s <= GND;
                    }
                }
            }
            DEFAULT {
                s <= s;
            }
        }
    }
@endmod
