// WIDTH_ASSIGN_MISMATCH_NO_EXT: Alias (=) with mismatched widths and no modifier.
// Valid same-width aliases verify no false positives.

@project WIDTH_ASSIGN_MISMATCH_NO_EXT_alias_width_mismatch
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [8]  din = _;
        OUT [8]  dout_a = _;
        OUT [8]  dout_b = _;
    }
@endproj

// Helper module: alias width mismatch in ASYNC
@module HelperMod
    PORT {
        IN  [8] din;
        OUT [8] dout;
    }

    WIRE {
        w_narrow [4];
        w_wide [16];
    }

    ASYNCHRONOUS {
        // Trigger 1: alias wider source into narrower wire (4 = 8, widths differ)
        w_narrow = din;
        // Trigger 2: alias narrower source into wider wire (16 = 8, widths differ)
        w_wide = din;
        // Valid: same-width alias (no error)
        dout = din;
    }
@endmod

@module TopMod
    PORT {
        IN  [8]  din;
        OUT [8]  dout_a;
        OUT [8]  dout_b;
    }

    WIRE {
        top_wide [16];
    }

    @new inst_h HelperMod {
        IN  [8] din = din;
        OUT [8] dout = dout_a;
    };

    ASYNCHRONOUS {
        // Trigger 3: alias narrower source into wider wire (16 = 8, top module)
        top_wide = din;
        // Valid: same-width alias (no error)
        dout_b = din;
    }
@endmod
