// CHECK_INVALID_EXPR_TYPE: INOUT port signal used in @check expression.
// Tests that an INOUT port is rejected in @check. Valid @check with
// CONST included to verify no false positives.

@project CHECK_INVALID_EXPR_TYPE_inout_signal
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [1] din = _;
        OUT [1] data = _;
        INOUT [1] bidir = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [1] din;
        OUT [1] data;
        INOUT [1] bidir;
    }

    CONST { SIZE = 4; }

    // Valid: CONST in @check (no error)
    @check (SIZE > 0, "size ok");

    // Trigger: INOUT port signal in @check
    @check (bidir == 1'b0, "inout in check");

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
        IF (din) {
            bidir <= r;
        } ELSE {
            bidir <= 1'bz;
        }
    }

    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] din;
        OUT [1] data;
        INOUT [1] bidir;
    }

    CONST { WIDTH = 8; }

    // Valid: CONST in @check (no error)
    @check (WIDTH == 8, "width ok");

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [1] din = din;
        OUT [1] data = _;
        INOUT [1] bidir = bidir;
    };

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
@endmod
