// Req #2: when rw = 0, the transceiver releases the shared bus and captures
// the value driven by an external source.

@project REQ2_rw_release_external_capture_ok
    @top TopMod {
        IN  [1] clk = _;
        OUT [8] observed = _;
    }
@endproj

@module TristateTransceiver
    PORT {
        IN    [1] clk;
        IN    [1] rw;
        IN    [8] write_data;
        OUT   [8] rx_data;
        INOUT [8] data_bus;
    }

    REGISTER {
        rx_buffer [8] = 8'h00;
    }

    ASYNCHRONOUS {
        // Trigger 1: rw = 0 releases the bus with a full-width z drive.
        data_bus <= (rw == 1'b1) ? write_data : 8'bzzzz_zzzz;
        rx_data <= rx_buffer;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger 2: rx_buffer captures the externally driven bus value.
        rx_buffer <= data_bus;
    }
@endmod

@module ExternalBusDriver
    PORT {
        IN    [1] drive_en;
        IN    [8] drive_data;
        INOUT [8] data_bus;
    }

    ASYNCHRONOUS {
        data_bus <= (drive_en == 1'b1) ? drive_data : 8'bzzzz_zzzz;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [8] observed;
    }

    WIRE {
        shared_bus [8];
        rx_sample [8];
    }

    @new transceiver TristateTransceiver {
        IN    [1] clk = clk;
        IN    [1] rw = 1'b0;
        IN    [8] write_data = 8'hA5;
        OUT   [8] rx_data = rx_sample;
        INOUT [8] data_bus = shared_bus;
    };

    @new ext_driver ExternalBusDriver {
        IN    [1] drive_en = 1'b1;
        IN    [8] drive_data = 8'h3C;
        INOUT [8] data_bus = shared_bus;
    };

    ASYNCHRONOUS {
        observed <= rx_sample;
    }
@endmod

