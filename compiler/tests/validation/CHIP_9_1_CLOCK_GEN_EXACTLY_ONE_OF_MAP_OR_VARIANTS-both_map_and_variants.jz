// CLOCK_GEN_EXACTLY_ONE_OF_MAP_OR_VARIANTS: local chip JSON must not provide
// both a top-level map and variants for the same clock_gen entry.
// Trigger 1 is isolated in the companion local chip JSON file.

@project(CHIP="CHIP_9_1_CLOCK_GEN_EXACTLY_ONE_OF_MAP_OR_VARIANTS-both_map_and_variants") CLOCK_GEN_EXACTLY_ONE_OF_MAP_OR_VARIANTS_both_map_and_variants
    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module Helper
    PORT {
        IN  [1] din;
        OUT [1] dout;
    }

    ASYNCHRONOUS {
        dout = din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    @new inst_h Helper {
        IN  [1] din = r;
        OUT [1] dout = _;
    };

    REGISTER {
        r [1] = 1'b0;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
