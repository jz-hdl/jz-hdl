// HAPPY_PATH: §5.5.28 reduce_xor(source) behavioral requirements.
// Exercises:
//   Req #2 - reduce_xor(source) is the parity reduction equivalent to Verilog `^(source)`.

@project HAPPY_PATH_reduce_xor_semantics_ok
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [8] src8 = _;
        IN  [8] mask8 = _;
        IN  [1] src1 = _;
        OUT [1] out_plain = _;
        OUT [1] out_expr = _;
        OUT [1] out_one = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [8] src8;
        IN  [8] mask8;
        IN  [1] src1;
        OUT [1] out_plain;
        OUT [1] out_expr;
        OUT [1] out_one;
    }

    ASYNCHRONOUS {
        // Req #2: parity reduction of a plain source.
        out_plain = reduce_xor(src8);
        // Req #2: parity reduction also applies to bit-vector expressions.
        out_expr = reduce_xor(src8 ^ mask8);
        // Req #2: a 1-bit source reduces to that same bit.
        out_one = reduce_xor(src1);
    }
@endmod

@module TopMod
    PORT {
        IN  [8] src8;
        IN  [8] mask8;
        IN  [1] src1;
        OUT [1] out_plain;
        OUT [1] out_expr;
        OUT [1] out_one;
    }

    WIRE {
        h_plain [1];
        h_expr  [1];
        h_one   [1];
    }

    @new inst_h HelperMod {
        IN  [8] src8 = src8;
        IN  [8] mask8 = mask8;
        IN  [1] src1 = src1;
        OUT [1] out_plain = h_plain;
        OUT [1] out_expr = h_expr;
        OUT [1] out_one = h_one;
    };

    ASYNCHRONOUS {
        out_plain = h_plain;
        out_expr = h_expr;
        out_one = h_one;
    }
@endmod
