// MEM_MULTIPLE_WRITES_SAME_IN: Multiple writes to same IN port inside conditional branches.
// Single conditional write included for no false positives.

@project MEM_MULTIPLE_WRITES_SAME_IN_conditional_double_write
    @top TopMod {
        IN  [1] clk = _;
        IN  [1] sel = _;
        IN  [4] addr = _;
        IN  [8] wdata = _;
        OUT [8] data = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [1] sel;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM {
        mem_a [8] [16] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = mem_a.rd[addr] ^ r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= r;
        // Valid: single conditional write (no error expected)
        IF (sel) {
            mem_a.wr[addr] <= wdata;
        }
        // Trigger: double write to same IN port inside conditional
        IF (sel) {
            mem_a.wr[addr] <= wdata;
        }
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] sel;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM {
        mem_b [8] [16] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [1] sel = sel;
        IN  [4] addr = addr;
        IN  [8] wdata = wdata;
        OUT [8] data = _;
    };

    ASYNCHRONOUS {
        data = mem_b.rd[addr] ^ r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= r;
        mem_b.wr[addr] <= wdata;
    }
@endmod
