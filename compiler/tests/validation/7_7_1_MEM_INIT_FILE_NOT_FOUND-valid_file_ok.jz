// MEM_INIT_FILE_NOT_FOUND: readable relative @file paths compile cleanly.

@project MEM_INIT_FILE_NOT_FOUND_valid_file_ok
    @top TopMod {
        IN  [1] clk = _;
        IN  [2] addr = _;
        IN  [8] wdata = _;
        OUT [8] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [2] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    MEM {
        mem_ok [8] [4] = @file("mem_exact_4bytes.bin") {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = mem_ok.rd[addr];
    }

    SYNCHRONOUS(CLK=clk) {
        mem_ok.wr[addr] <= wdata;
    }
@endmod
