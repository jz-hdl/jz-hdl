// HAPPY_PATH: Configurable memory with CONST-driven address width.
// Verifies S7.6.7 allows reusable address sizing where MEM access ports and
// top-level interfaces derive their widths from a module-local CONST.

@project HAPPY_PATH_flexible_address_width_via_const
    @top FlexibleAddrTop {
        IN  [1] clk = _;
        IN  [5] rd_addr = _;
        IN  [5] wr_addr = _;
        IN  [8] wr_data = _;
        IN  [1] wr_en = _;
        OUT [8] rd_data = _;
    }
@endproj

@module FlexibleAddrTop
    CONST {
        WORD_WIDTH = 8;
        DEPTH = 32;
        ADDR_WIDTH = 5;
    }

    PORT {
        IN  [1] clk;
        IN  [ADDR_WIDTH] rd_addr;
        IN  [ADDR_WIDTH] wr_addr;
        IN  [WORD_WIDTH] wr_data;
        IN  [1] wr_en;
        OUT [WORD_WIDTH] rd_data;
    }

    REGISTER {
        read_q [WORD_WIDTH] = 8'h00;
    }

    MEM(type=BLOCK) {
        storage [WORD_WIDTH] [DEPTH] = 8'h00 {
            OUT rd SYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        rd_data = read_q;
    }

    SYNCHRONOUS(CLK=clk) {
        storage.rd.addr <= rd_addr;
        read_q <= storage.rd.data;

        IF (wr_en) {
            storage.wr[wr_addr] <= wr_data;
        }
    }
@endmod
