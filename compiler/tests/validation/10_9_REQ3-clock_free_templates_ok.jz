// Req #3 (10.9 Rationale): Template bodies stay clock-free and are applied
// from enclosing module blocks instead.

@project REQ3_clock_free_templates_ok
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@template invert_stage(src, dst)
    @scratch tmp [1];
    tmp <= ~src;
    dst <= tmp;
@endtemplate

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    WIRE {
        stage [1];
    }

    ASYNCHRONOUS {
        @apply invert_stage(r, stage);
        data = ~stage;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
