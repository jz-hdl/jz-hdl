// ID_SINGLE_UNDERSCORE: Single underscore `_` used as CONFIG entry name.
// Tests _ in CONFIG block declaration context (outside no-connect).
// Valid CONFIG entry with multi-char name included to verify no false positives.

@project ID_SINGLE_UNDERSCORE_config_name
    CONFIG {
        // Valid: multi-char CONFIG entry name (should NOT trigger)
        valid_cfg = 8;
        // Trigger: _ used as CONFIG entry name
        _ = 4;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }
    ASYNCHRONOUS {
        data = clk;
    }
@endmod
