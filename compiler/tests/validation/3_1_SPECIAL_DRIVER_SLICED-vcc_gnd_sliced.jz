// SPECIAL_DRIVER_SLICED: VCC/GND may not be sliced or indexed.
// Exercises sliced special drivers as operands inside operator-category
// expressions, plus valid unsliced standalone uses for false-positive guards.

@project SPECIAL_DRIVER_SLICED_vcc_gnd_sliced
    @top TopMod {
        IN  [1] clk = _;
        IN  [1] flag = _;
        OUT [1] out_a = _;
        OUT [1] out_b = _;
        OUT [1] out_c = _;
    }
@endproj

// Helper: sliced VCC/GND inside expression contexts
@module HelperSlice
    PORT {
        IN  [1] clk;
        IN  [1] flag;
        OUT [1] out_a;
        OUT [1] out_b;
        OUT [1] out_c;
    }
    REGISTER {
        r [1] = 1'b0;
    }
    ASYNCHRONOUS {
        // Trigger 1: VCC slice used in bitwise expression
        out_a = VCC[0:0] & flag;
        // Trigger 2: GND slice used in logical expression
        out_b = GND[0:0] || flag;
        // Valid: unsliced VCC as standalone RHS (no false positive)
        out_c = VCC;
    }
    SYNCHRONOUS(CLK=clk) {
        // Trigger 3: VCC slice used in SYNCHRONOUS expression
        r <= VCC[0:0] ^ r;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] flag;
        OUT [1] out_a;
        OUT [1] out_b;
        OUT [1] out_c;
    }
    WIRE {
        h_out_a [1];
        h_out_b [1];
        h_out_c [1];
    }
    REGISTER {
        r [1] = 1'b0;
    }

    @new inst_slice HelperSlice {
        IN  [1] clk = clk;
        IN  [1] flag = flag;
        OUT [1] out_a = h_out_a;
        OUT [1] out_b = h_out_b;
        OUT [1] out_c = h_out_c;
    };

    ASYNCHRONOUS {
        out_a = h_out_a;
        out_b = h_out_b | r;
        // Valid: unsliced GND as standalone RHS (no false positive)
        out_c = GND;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger 4: GND slice used in top-level SYNCHRONOUS expression
        r <= GND[0:0] ^ flag;
    }
@endmod
