// WIDTH_NONPOSITIVE_OR_NONINT: Zero-width PORT declaration rejected.
// Tests zero-width output port in TopMod.
// Valid positive-width ports included to verify no false positives.

@project WIDTH_NONPOSITIVE_OR_NONINT_zero_width_port
    @top TopMod {
        IN  [1] clk = _;
        IN  [8] data_in = _;
        OUT [8] data_out = _;
    }
@endproj

// Helper: structurally valid, no zero-width ports
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        OUT [8] data;
    }
    REGISTER {
        r [8] = 8'd0;
    }
    ASYNCHRONOUS {
        data = r;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= a;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] data_in;
        // Trigger: zero-width output port declaration
        OUT [0] bad_out;
        OUT [8] data_out;
    }
    WIRE {
        h_data [8];
    }
    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] a = data_in;
        OUT [8] data = h_data;
    };
    ASYNCHRONOUS {
        data_out = h_data;
    }
@endmod
