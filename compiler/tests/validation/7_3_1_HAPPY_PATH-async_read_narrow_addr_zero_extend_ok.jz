// HAPPY_PATH: narrower ASYNC read addresses are accepted and implicitly
// zero-extended to the memory address width for §7.3.1.

@project HAPPY_PATH_async_read_narrow_addr_zero_extend_ok
    CONFIG {
        NARROW_W = 3;
        ADDR_W = 4;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [NARROW_W] narrow_addr = _;
        OUT [8] data = _;
    }
@endproj

@module SinkMod
    PORT {
        IN  [1] clk;
        IN  [8] din;
        OUT [8] dout;
    }

    ASYNCHRONOUS {
        dout = din;
    }

    SYNCHRONOUS(CLK=clk) {
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [3] narrow_addr;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM(type=DISTRIBUTED) {
        mem_t [8] [16] = 8'h00 {
            OUT rd ASYNC;
        };
    }

    // Valid: narrower ASYNC read address in @new binding.
    @new inst_sink SinkMod {
        IN  [1] clk = clk;
        IN  [8] din = mem_t.rd[narrow_addr];
        OUT [8] dout = _;
    };

    ASYNCHRONOUS {
        // Valid: narrower address is zero-extended from 3 bits to 4 bits.
        data = mem_t.rd[narrow_addr] ^ r;
    }

    SYNCHRONOUS(CLK=clk) {
        // Valid: narrower address is also accepted in sync reads.
        r <= mem_t.rd[narrow_addr];
    }
@endmod
