// IMPORT_DUP_MODULE_OR_BLACKBOX: Imported blackbox name duplicates an imported blackbox.
// The first import contributes SharedIp; the second import triggers the collision.

@project IMPORT_DUP_MODULE_OR_BLACKBOX_blackbox_collision
    @import "6_2_IMPORT_DUP_MODULE_OR_BLACKBOX-blackbox_collision_libA.jz";
    @import "6_2_IMPORT_DUP_MODULE_OR_BLACKBOX-blackbox_collision_libB.jz";

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    REGISTER {
        r [1] = 1'b0;
    }
    ASYNCHRONOUS {
        data = r;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
    }
@endmod
