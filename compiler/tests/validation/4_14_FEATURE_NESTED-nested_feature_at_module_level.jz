// FEATURE_NESTED: Nested @feature guard at bare module level.
// Tests that nested @feature outside any block (REGISTER, WIRE, ASYNC, SYNC)
// is detected and rejected.

@project FEATURE_NESTED_nested_feature_at_module_level
    CONFIG {
        MODE = 1;
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [1] data;
    }

    CONST {
        FLAG = 1;
        LEVEL = 0;
    }

    REGISTER {
        r [1] = 1'b0;
    }

    // Trigger: nested @feature at module level
    @feature FLAG == 1
        @feature LEVEL == 0
            REGISTER {
                r2 [1] = 1'b0;
            }
        @endfeat
    @endfeat

    ASYNCHRONOUS {
        data = r ^ r2;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= ~r;
        r2 <= ~r2;
    }
@endmod
