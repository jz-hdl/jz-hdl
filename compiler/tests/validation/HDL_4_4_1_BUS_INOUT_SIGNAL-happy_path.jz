// HAPPY_PATH: BUS Block INOUT signal resolves to INOUT (bidirectional) in both
// SOURCE and TARGET roles. Exercises Req #9 and Req #38 (INOUT readable+writable).
// Each role module reads and writes the INOUT signal; pairing a SOURCE with a
// TARGET module lets each write the INOUT from one side and read it from the
// other, showing both read and write access are permitted.

@project HAPPY_PATH_bus_inout_signal_ok
    BUS BIDIR_BUS {
        OUT   [8] tx;
        IN    [8] rx;
        INOUT [8] bidir;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [8] din = _;
        OUT [8] dout_a = _;
        OUT [8] dout_b = _;
    }
@endproj

// SOURCE-role module: INOUT stays INOUT; read and write both valid.
@module SourceInoutMod
    PORT {
        IN  [1] clk;
        IN  [8] din;
        BUS BIDIR_BUS SOURCE sbus;
        OUT [8] data_out;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        // Write writable signal (tx is OUT for SOURCE)
        sbus.tx <= r;
        // Write INOUT signal (bidirectional is writable from this side)
        sbus.bidir <= r;
        // Read readable signal (rx is IN for SOURCE)
        data_out <= sbus.rx;
    }

    SYNCHRONOUS(CLK=clk) {
        // Read INOUT in a SYNC expression to confirm read access is valid
        r <= sbus.bidir ^ din;
    }
@endmod

// TARGET-role module: INOUT stays INOUT; read and write both valid.
@module TargetInoutMod
    PORT {
        IN  [1] clk;
        IN  [8] din;
        BUS BIDIR_BUS TARGET tbus;
        OUT [8] data_out;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        // Write writable signal (rx flips to OUT for TARGET)
        tbus.rx <= r;
        // Read readable signal (tx flips to IN for TARGET)
        data_out <= tbus.tx;
    }

    SYNCHRONOUS(CLK=clk) {
        // Read INOUT in a SYNC expression
        r <= tbus.bidir ^ din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] din;
        OUT [8] dout_a;
        OUT [8] dout_b;
    }

    @new inst_s SourceInoutMod {
        IN  [1] clk = clk;
        IN  [8] din = din;
        BUS BIDIR_BUS SOURCE sbus = _;
        OUT [8] data_out = dout_a;
    };

    @new inst_t TargetInoutMod {
        IN  [1] clk = clk;
        IN  [8] din = din;
        BUS BIDIR_BUS TARGET tbus = _;
        OUT [8] data_out = dout_b;
    };

    ASYNCHRONOUS {
    }
@endmod
