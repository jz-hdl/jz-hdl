// HAPPY_PATH: Every connected @top port has a matching CLOCKS/IN_PINS/OUT_PINS/INOUT_PINS declaration.
// Exercises the non-error path for TOP_PORT_PIN_DECL_MISSING across all declaration classes.

@project HAPPY_PATH_top_port_pin_decls_ok
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
        push_btn = { standard=LVCMOS33 };
    }

    OUT_PINS {
        status_led = { standard=LVCMOS33, drive=8 };
    }

    INOUT_PINS {
        shared_bus[4] = { standard=LVCMOS33, drive=8 };
    }

    MAP {
        sys_clk = 1;
        push_btn = 2;
        status_led = 3;
        shared_bus[0] = 4;
        shared_bus[1] = 5;
        shared_bus[2] = 6;
        shared_bus[3] = 7;
    }

    @top TopMod {
        IN    [1] clk = sys_clk;
        IN    [1] button = push_btn;
        OUT   [1] led = status_led;
        INOUT [4] bus = shared_bus;
    }
@endproj

@module TopMod
    PORT {
        IN    [1] clk;
        IN    [1] button;
        OUT   [1] led;
        INOUT [4] bus;
    }

    REGISTER {
        drive_value [4] = 4'h0;
        drive_enable [1] = 1'b0;
    }

    ASYNCHRONOUS {
        led = button;

        IF (drive_enable) {
            bus <= drive_value;
        } ELSE {
            bus <= 4'bz;
        }
    }

    SYNCHRONOUS(CLK=clk) {
        drive_value <= bus;
        drive_enable <= ~drive_enable;
    }
@endmod
