// MEM_READ_FROM_WRITE_PORT: Reading from IN (write) port inside SYNCHRONOUS block.
// Valid writes to IN port and reads from OUT port included for no false positives.

@project MEM_READ_FROM_WRITE_PORT_read_in_sync
    @top TopMod {
        IN  [1] clk = _;
        IN  [4] addr = _;
        IN  [8] wdata = _;
        OUT [8] data = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM {
        mem_a [8] [16] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = mem_a.rd[addr] ^ r;
    }

    SYNCHRONOUS(CLK=clk) {
        mem_a.wr[addr] <= wdata;
        // Trigger: read from IN (write) port in SYNC block
        r <= mem_a.wr[addr];
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM {
        mem_b [8] [16] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [4] addr = addr;
        IN  [8] wdata = wdata;
        OUT [8] data = _;
    };

    ASYNCHRONOUS {
        data = mem_b.rd[addr] ^ r;
    }

    SYNCHRONOUS(CLK=clk) {
        mem_b.wr[addr] <= wdata;
        r <= r;
    }
@endmod
