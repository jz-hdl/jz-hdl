// TOP_PORT_SIGNAL_WIDTH_MISMATCH: binding width does not match pin width.
// Target diagnostics: TOP_PORT_SIGNAL_WIDTH_MISMATCH on the IN and OUT top bindings.
// Non-target diagnostics: none; clk is used and the module body assignment is width-matched.

@project TOP_PORT_SIGNAL_WIDTH_MISMATCH_signal_width_mismatch
  IN_PINS {
    btn[2] = { standard=LVCMOS33 };
  }

  OUT_PINS {
    led[3] = { standard=LVCMOS33, drive=8 };
  }

  CLOCKS {
    clk = { period=10 };
  }

  IN_PINS {
    clk = { standard=LVCMOS33 };
  }

  MAP {
    clk = 1;
    btn[0] = 2;
    btn[1] = 3;
    led[0] = 4;
    led[1] = 5;
    led[2] = 6;
  }

  @top top {
    IN  [1] clk  = clk;
    IN  [4] sw   = btn;
    OUT [6] leds = led;
  }
@endproj

@module top
  PORT {
    IN  [1] clk;
    IN  [4] sw;
    OUT [6] leds;
  }

  REGISTER {
    phase [1] = 1'b0;
  }

  ASYNCHRONOUS {
    leds <= {phase, 1'b0, sw};
  }

  SYNCHRONOUS(CLK=clk) {
    phase <= ~phase;
  }
@endmod
