// OBS_X_TO_OBSERVABLE_SINK: x-valued literal bits reaching top-level
// project pins (OUT_PINS / INOUT_PINS). The spec §1.2 enumerates
// top-level project pins as observable sinks.

@project(CHIP=GENERIC) OBS_X_TO_OBSERVABLE_SINK_x_to_project_pin
    CLOCKS {
        sys_clk = { period=10.0 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
    }

    OUT_PINS {
        out_pin[8] = { standard=LVCMOS33, drive=8 };
    }

    INOUT_PINS {
        io_pin[8] = { standard=LVCMOS33, drive=8 };
    }

    MAP {
        sys_clk   = 1;
        out_pin[0] = 2;
        out_pin[1] = 3;
        out_pin[2] = 4;
        out_pin[3] = 5;
        out_pin[4] = 6;
        out_pin[5] = 7;
        out_pin[6] = 8;
        out_pin[7] = 9;
        io_pin[0] = 10;
        io_pin[1] = 11;
        io_pin[2] = 12;
        io_pin[3] = 13;
        io_pin[4] = 14;
        io_pin[5] = 15;
        io_pin[6] = 16;
        io_pin[7] = 17;
    }

    @top TopMod {
        IN    [1] clk      = sys_clk;
        IN    [1] drive_en = _;
        OUT   [8] out_data = out_pin;
        INOUT [8] io_data  = io_pin;
    }
@endproj

@module TopMod
    PORT {
        IN    [1] clk;
        IN    [1] drive_en;
        OUT   [8] out_data;
        INOUT [8] io_data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        // Trigger 1: x literal driving OUT port mapped to project OUT_PINS
        out_data <= 8'bxxxx_0000;
        // Trigger 2: x literal driving INOUT port mapped to project INOUT_PINS
        io_data  <= drive_en ? 8'bxx00_00xx : 8'bz;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= r;
    }
@endmod
