// HAPPY_PATH: Three tristate drivers with mutually exclusive selector values.
// Covers: pairwise mutual-exclusion succeeds for distinct constant comparisons.

@project HAPPY_PATH_mutual_exclusion_ok_11_7
    @top TopMod {
        IN  [2] sel = _;
        IN  [8] data_a = _;
        IN  [8] data_b = _;
        IN  [8] data_c = _;
        OUT [8] observed = _;
    }
@endproj

@module DriverA
    PORT {
        IN    [2] sel;
        IN    [8] din;
        INOUT [8] bus;
    }

    ASYNCHRONOUS {
        bus <= (sel == 2'b00) ? din : 8'bzzzz_zzzz;
    }
@endmod

@module DriverB
    PORT {
        IN    [2] sel;
        IN    [8] din;
        INOUT [8] bus;
    }

    ASYNCHRONOUS {
        bus <= (sel == 2'b01) ? din : 8'bzzzz_zzzz;
    }
@endmod

@module DriverC
    PORT {
        IN    [2] sel;
        IN    [8] din;
        INOUT [8] bus;
    }

    ASYNCHRONOUS {
        bus <= (sel == 2'b10) ? din : 8'bzzzz_zzzz;
    }
@endmod

@module TopMod
    PORT {
        IN  [2] sel;
        IN  [8] data_a;
        IN  [8] data_b;
        IN  [8] data_c;
        OUT [8] observed;
    }

    WIRE {
        shared_bus [8];
    }

    @new inst_a DriverA {
        IN    [2] sel = sel;
        IN    [8] din = data_a;
        INOUT [8] bus = shared_bus;
    };

    @new inst_b DriverB {
        IN    [2] sel = sel;
        IN    [8] din = data_b;
        INOUT [8] bus = shared_bus;
    };

    @new inst_c DriverC {
        IN    [2] sel = sel;
        IN    [8] din = data_c;
        INOUT [8] bus = shared_bus;
    };

    ASYNCHRONOUS {
        observed <= shared_bus;
    }
@endmod
