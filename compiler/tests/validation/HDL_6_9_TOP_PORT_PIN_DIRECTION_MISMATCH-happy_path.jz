// TOP_PORT_PIN_DIRECTION_MISMATCH: IN, OUT, and INOUT top ports may all bind to INOUT_PINS.
// Exercises reading-only, driving-only, and bidirectional uses of bidirectional pins.

@project TOP_PORT_PIN_DIRECTION_MISMATCH_inout_pins_ok
    CLOCKS {
        sys_clk = { period=10 };
    }

    IN_PINS {
        sys_clk = { standard=LVCMOS33 };
    }

    INOUT_PINS {
        sense_pad = { standard=LVCMOS33, drive=4 };
        drive_pad = { standard=LVCMOS18, drive=8 };
        bidir_pad = { standard=LVCMOS12, drive=4 };
    }

    MAP {
        sys_clk = 1;
        sense_pad = 2;
        drive_pad = 3;
        bidir_pad = 4;
    }

    @top TopMod {
        IN    [1] clk = sys_clk;
        IN    [1] sense = sense_pad;
        OUT   [1] drive = drive_pad;
        INOUT [1] bidir = bidir_pad;
        OUT   [1] done = _;
    }
@endproj

@module TopMod
    PORT {
        IN    [1] clk;
        IN    [1] sense;
        OUT   [1] drive;
        INOUT [1] bidir;
        OUT   [1] done;
    }

    REGISTER {
        state [1] = 1'b0;
    }

    ASYNCHRONOUS {
        drive = sense;
        IF (state) {
            bidir <= sense;
        } ELSE {
            bidir <= 1'bz;
        }
        done = sense;
    }

    SYNCHRONOUS(CLK=clk) {
        state <= ~state;
    }
@endmod
