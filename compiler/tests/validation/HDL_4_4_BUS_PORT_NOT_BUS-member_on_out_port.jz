// BUS_PORT_NOT_BUS: BUS member access used on non-BUS OUT port.
// Trigger is dot-notation member access on a regular OUT port.
// Valid BUS dot access included to verify no false positives.

@project BUS_PORT_NOT_BUS_member_on_out_port
    BUS MY_BUS {
        OUT [8] tx;
        IN  [8] rx;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [8] din = _;
        OUT [8] dout_a = _;
        OUT [8] dout_b = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] data_in;
        BUS MY_BUS SOURCE sbus;
        OUT [8] data_out;
        OUT [8] data_err;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        sbus.tx <= r;
        data_out <= sbus.rx;
        // Trigger: dot access on regular OUT port
        data_err <= data_out.tx;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= data_in;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] din;
        OUT [8] dout_a;
        OUT [8] dout_b;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] data_in = din;
        BUS MY_BUS SOURCE sbus = _;
        OUT [8] data_out = dout_a;
        OUT [8] data_err = dout_b;
    };

    ASYNCHRONOUS {
    }
@endmod
