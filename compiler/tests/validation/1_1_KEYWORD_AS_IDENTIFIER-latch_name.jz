// KEYWORD_AS_IDENTIFIER: Reserved keyword used as LATCH name.
// Tests keyword CONFIG as a latch name in LATCH declaration context.
// Valid latch name included to verify no false positives.

@project KEYWORD_AS_IDENTIFIER_latch_name
    @top TopMod {
        IN  [1] enable = _;
        IN  [1] din = _;
        OUT [1] data = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] enable;
        IN  [1] din;
        OUT [1] data;
    }

    LATCH {
        // Valid: non-keyword latch name (should NOT trigger)
        valid_lat [1] D;
        // Trigger: keyword CONFIG used as latch name
        CONFIG [1] D;
    }

    ASYNCHRONOUS {
        valid_lat <= enable : din;
        data <= valid_lat;
    }
@endmod
