// HAPPY_PATH: ssub(a, b) signed widening-subtract semantics from §5.5.17.
// Exercises the legal ASYNCHRONOUS and SYNCHRONOUS RHS contexts and examples
// where operands of different widths are sign-extended to max(width)+1 bits.

@project HAPPY_PATH_ssub_semantics_ok
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [8] a8 = _;
        IN  [8] b8 = _;
        IN  [4] a4 = _;
        IN  [4] b4 = _;
        IN  [3] c3 = _;
        OUT [9] async_equal_width = _;
        OUT [9] async_mixed_width = _;
        OUT [9] sync_sign_extended = _;
        OUT [5] sync_equal_small = _;
    }
@endproj

@module HelperAsync
    PORT {
        IN  [8] a8;
        IN  [8] b8;
        OUT [9] out_equal_width;
        OUT [9] out_mixed_width;
    }

    ASYNCHRONOUS {
        // Trigger 1: 8-bit minus 8-bit signed widening subtract uses ssub(a, b).
        out_equal_width <= ssub(a8, b8);

        // Trigger 2: 4-bit minus 8-bit sign-extends the narrower operand to 9 bits.
        out_mixed_width <= ssub(4'b1000, 8'b0000_0001);
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] a8;
        IN  [8] b8;
        IN  [4] a4;
        IN  [4] b4;
        IN  [3] c3;
        OUT [9] async_equal_width;
        OUT [9] async_mixed_width;
        OUT [9] sync_sign_extended;
        OUT [5] sync_equal_small;
    }

    WIRE {
        helper_equal_width [9];
        helper_mixed_width [9];
    }

    REGISTER {
        r_sync_sign_extended [9] = 9'd0;
        r_sync_equal_small [5] = 5'd0;
    }

    @new inst_async HelperAsync {
        IN  [8] a8 = a8;
        IN  [8] b8 = b8;
        OUT [9] out_equal_width = helper_equal_width;
        OUT [9] out_mixed_width = helper_mixed_width;
    };

    ASYNCHRONOUS {
        async_equal_width = helper_equal_width;
        async_mixed_width = helper_mixed_width;
        sync_sign_extended = r_sync_sign_extended;
        sync_equal_small = r_sync_equal_small;
    }

    SYNCHRONOUS(CLK=clk) {
        // Trigger 3: 8-bit minus 4-bit widens to 9 bits via max(width)+1.
        r_sync_sign_extended <= ssub(a8, a4);

        // Trigger 4: equal-width signed subtract still widens by one extra bit.
        r_sync_equal_small <= ssub(c3, b4);
    }
@endmod
