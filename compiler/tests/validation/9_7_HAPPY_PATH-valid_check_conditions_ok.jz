// HAPPY_PATH: Valid @check conditions do not emit diagnostics under S9.7.
// Exercises allowed nonzero constant expressions at project and module scope.

@project HAPPY_PATH_valid_check_conditions_ok
    CONFIG {
        WIDTH = 8;
        DEPTH = 16;
    }

    // Valid: project-scope CONFIG comparison evaluates nonzero.
    @check (CONFIG.WIDTH == 8, "project width ok");

    // Valid: project-scope constant arithmetic evaluates nonzero.
    @check (clog2(CONFIG.DEPTH) == 4, "project depth ok");

    @top TopMod {
        IN  [1] clk = _;
        OUT [8] data = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] din;
        OUT [8] data;
    }

    CONST {
        SCALE = 2;
        SHIFT = 1;
    }

    // Valid: module CONST arithmetic evaluates nonzero.
    @check ((SCALE << SHIFT) == 4, "helper const arithmetic ok");

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= din;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [8] data;
    }

    CONST {
        LOCAL_W = 8;
        LOCAL_D = 4;
    }

    // Valid: module-scope CONST comparison evaluates nonzero.
    @check (LOCAL_W == CONFIG.WIDTH, "module width ok");

    // Valid: mixed CONFIG/CONST expression evaluates nonzero.
    @check (LOCAL_D == clog2(CONFIG.DEPTH), "module depth ok");

    @new helper HelperMod {
        IN  [1] clk = clk;
        IN  [8] din = r;
        OUT [8] data = helper_data;
    };

    REGISTER {
        r [8] = 8'hA5;
    }

    WIRE {
        helper_data [8];
    }

    ASYNCHRONOUS {
        data = helper_data;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= r;
    }
@endmod
