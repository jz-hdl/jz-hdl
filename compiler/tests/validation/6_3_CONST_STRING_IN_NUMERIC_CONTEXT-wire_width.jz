// CONST_STRING_IN_NUMERIC_CONTEXT: String CONFIG value used as wire width.
// Tests CONFIG.FIRMWARE (a string) used in wire width bracket expression.
// Valid numeric CONFIG wire width included to verify no false positives.

@project CONST_STRING_IN_NUMERIC_CONTEXT_wire_width
    CONFIG {
        WIDTH = 8;
        FIRMWARE = "out/fw.bin";
    }

    @top TopMod {
        IN  [1] clk = _;
        OUT [CONFIG.WIDTH] data = _;
    }
@endproj

@module Helper
    PORT {
        IN  [1] clk;
        IN  [8] din;
        OUT [8] dout;
    }
    WIRE {
        // Trigger: string CONFIG in wire width
        w [CONFIG.FIRMWARE];
    }
    REGISTER {
        r [8] = 8'h00;
    }
    ASYNCHRONOUS {
        w = din;
        dout = r;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= w;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [CONFIG.WIDTH] data;
    }

    WIRE {
        // Valid: numeric CONFIG in wire width (no false positive)
        h_out [CONFIG.WIDTH];
    }

    @new inst_h Helper {
        IN  [1] clk = clk;
        IN  [8] din = 8'hAA;
        OUT [8] dout = h_out;
    };

    REGISTER {
        r [CONFIG.WIDTH] = 8'h00;
    }

    ASYNCHRONOUS {
        data = r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= h_out;
    }
@endmod
