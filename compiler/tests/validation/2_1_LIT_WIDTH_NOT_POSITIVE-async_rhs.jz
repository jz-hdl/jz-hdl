// LIT_WIDTH_NOT_POSITIVE: Literal with zero or non-positive width.
// Tests zero-width literal in async RHS context.
// Valid positive-width literal included to verify no false positives.

@project LIT_WIDTH_NOT_POSITIVE_async_rhs
    @top TopMod {
        IN  [1] clk = _;
        OUT [8] data = _;
    }
@endproj

@module HelperA
    PORT {
        IN  [8] sel;
        OUT [8] data;
    }
    ASYNCHRONOUS {
        // Trigger: zero-width literal in async RHS
        data <= sel + 0'b0;
    }
@endmod

@module TopMod
    PORT {
        IN  [1] clk;
        OUT [8] data;
    }
    WIRE {
        helper_data [8];
    }

    @new inst_a HelperA {
        IN  [8] sel = 8'h01;
        OUT [8] data = helper_data;
    };

    REGISTER {
        r [8] = 8'h00;
    }
    ASYNCHRONOUS {
        // Valid: positive-width literal in async RHS (no false positive)
        data <= helper_data + 8'd1;
    }
    SYNCHRONOUS(CLK=clk) {
        r <= r + 8'h01;
    }
@endmod
