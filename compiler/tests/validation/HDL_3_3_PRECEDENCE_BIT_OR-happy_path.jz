// PRECEDENCE: §3.3 Req #12 — Bitwise OR `|` binds tighter than logical
// AND `&&`. `p | q && r` parses as `(p | q) && r`, not `p | (q && r)`.
// All operands are 1-bit so && sees matching 1-bit operands.
// No diagnostics expected.

@project PRECEDENCE_bit_or_above_logical_and_ok
    CONFIG {
        WIDTH = 8;
    }
    @top TopMod {
        IN  [1] clk = _;
        IN  [1] p = _;
        IN  [1] q = _;
        IN  [1] r = _;
        OUT [1] out_and = _;
    }
@endproj

@module TopMod
    PORT {
        IN  [1] clk;
        IN  [1] p;
        IN  [1] q;
        IN  [1] r;
        OUT [1] out_and;
    }
    REGISTER {
        r_and [1] = 1'b0;
    }
    ASYNCHRONOUS {
        // | binds tighter than && : (p | q) && r
        out_and = ((p | q) && r) | r_and;
    }
    SYNCHRONOUS(CLK=clk) {
        r_and <= (p | q) && r;
    }
@endmod
