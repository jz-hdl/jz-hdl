// MUX_AGG_SOURCE_INVALID: Output port used as aggregation source.
// Output ports are valid readable signals in module scope (the module can read
// the value it is driving). No diagnostic expected.

@project MUX_AGG_SOURCE_INVALID_output_port_source
    CONFIG {
        WIDTH = 8;
    }

    @top TopMod {
        IN  [1] clk = _;
        IN  [8] a = _;
        IN  [1] sel = _;
        OUT [8] data = _;
    }
@endproj

// Helper module: output port used as MUX aggregation source
@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [1] sel;
        OUT [8] data;
    }

    // Valid: output port 'data' is a readable signal in module scope
    MUX {
        out_mux = a, data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data = out_mux[sel] | r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= a;
    }
@endmod

// Top module: output port as sole non-input MUX source
@module TopMod
    PORT {
        IN  [1] clk;
        IN  [8] a;
        IN  [1] sel;
        OUT [8] data;
    }

    WIRE {
        h_out [8];
    }

    // Valid: output port 'data' used alongside input port 'a'
    MUX {
        top_mux = a, data;
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [8] a = a;
        IN  [1] sel = sel;
        OUT [8] data = h_out;
    };

    REGISTER {
        r [8] = 8'h00;
    }

    ASYNCHRONOUS {
        data = top_mux[sel] | h_out | r;
    }

    SYNCHRONOUS(CLK=clk) {
        r <= a;
    }
@endmod
