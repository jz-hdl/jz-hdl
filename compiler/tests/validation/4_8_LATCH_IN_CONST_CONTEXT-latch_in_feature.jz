// LATCH_IN_CONST_CONTEXT: LATCH identifier may not be used in compile-time
// constant contexts (@check/@feature conditions).
// Tests latch used in @feature conditions across modules.
// Valid uses of CONST and CONFIG in @feature included for no false positives.

@project LATCH_IN_CONST_CONTEXT_latch_in_feature
    CONFIG {
        ENABLE_TOP = 1;
    }

    @top TopMod {
        IN  [1] enable = _;
        IN  [1] din = _;
        OUT [1] data = _;
    }
@endproj

// Helper module: latch used in @feature condition
@module HelperMod
    PORT {
        IN  [1] enable;
        IN  [1] din;
        OUT [1] data;
    }

    CONST {
        ENABLE_HELPER = 1;
    }

    LATCH {
        lat_h [1] D;
    }

    ASYNCHRONOUS {
        lat_h <= enable : din;

        // Valid: CONST in @feature (should NOT trigger)
        @feature ENABLE_HELPER == 1
            data = din;
        @else
            data = ~din;
        @endfeat

        // Trigger 1: latch in @feature in helper module
        @feature lat_h == 1'b0
            data = lat_h;
        @endfeat
    }
@endmod

@module TopMod
    PORT {
        IN  [1] enable;
        IN  [1] din;
        OUT [1] data;
    }

    @new inst_h HelperMod {
        IN  [1] enable = enable;
        IN  [1] din = din;
        OUT [1] data = _;
    };

    LATCH {
        lat_top [1] D;
    }

    ASYNCHRONOUS {
        lat_top <= enable : din;

        // Valid: CONFIG in @feature
        @feature CONFIG.ENABLE_TOP == 1
            data = din;
        @else
            data = ~din;
        @endfeat

        // Trigger 2: latch in @feature in top module
        @feature lat_top == 1'b0
            data = lat_top;
        @endfeat
    }
@endmod
