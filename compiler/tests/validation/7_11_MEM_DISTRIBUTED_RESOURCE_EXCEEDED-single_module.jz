// MEM_DISTRIBUTED_RESOURCE_EXCEEDED: Single module exceeding chip distributed memory capacity.
// Uses gw1nr-9 chip with 16384 bits of distributed memory.
// TopMod has two DISTRIBUTED MEMs totaling 16400 bits > 16384 limit.

@project(CHIP="gw1nr-9-qn88-c6-i5") MEM_DISTRIBUTED_RESOURCE_EXCEEDED_single_module
    @top TopMod {
        IN  [1] clk = _;
        IN  [10] addr = _;
        IN  [8] wdata = _;
        OUT [8] data = _;
    }
@endproj

@module HelperMod
    PORT {
        IN  [1] clk;
        IN  [4] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM(type=DISTRIBUTED) {
        small_dist [8] [16] = 8'h00 {
            OUT rd ASYNC;
            IN  wr;
        };
    }

    ASYNCHRONOUS {
        data = small_dist.rd[addr];
    }

    SYNCHRONOUS(CLK=clk) {
        r <= r;
        small_dist.wr[addr] <= wdata;
    }
@endmod

// Trigger: single module with 8*1024 + 8*1024 + 1*16 = 16400 bits > 16384 limit
@module TopMod
    PORT {
        IN  [1] clk;
        IN  [10] addr;
        IN  [8] wdata;
        OUT [8] data;
    }

    REGISTER {
        r [8] = 8'h00;
    }

    MEM(type=DISTRIBUTED) {
        dist_a [8] [1024] = 8'h00 {
            OUT rd_a ASYNC;
            IN  wr_a;
        };
        dist_b [8] [1024] = 8'h00 {
            OUT rd_b ASYNC;
            IN  wr_b;
        };
        dist_c [1] [16] = 1'b0 {
            OUT rd_c ASYNC;
            IN  wr_c;
        };
    }

    @new inst_h HelperMod {
        IN  [1] clk = clk;
        IN  [4] addr = addr[3:0];
        IN  [8] wdata = wdata;
        OUT [8] data = _;
    };

    ASYNCHRONOUS {
        data = r ^ dist_a.rd_a[addr] ^ dist_b.rd_b[addr];
    }

    SYNCHRONOUS(CLK=clk) {
        r <= {7'h00, dist_c.rd_c[addr[3:0]]};
        dist_a.wr_a[addr] <= wdata;
        dist_b.wr_b[addr] <= wdata;
        dist_c.wr_c[addr[3:0]] <= wdata[0:0];
    }
@endmod
